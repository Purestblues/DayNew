<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DayNew</RootNamespace>
    <AssemblyName>DayNew</AssemblyName>
    <Version>0.1.0</Version>
    <Product>日新</Product>
    <AssemblyTitle>日新 DayNew</AssemblyTitle>
    <ApplicationIcon>Assets\DayNew.ico</ApplicationIcon>
    <StartupObject>DayNew.Program</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
