<Window x:Class="DayNew.Views.McpDeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日新 · MCP 删除确认"
        Width="432"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        ShowActivated="True"
        AllowsTransparency="False"
        Background="{DynamicResource Surface4}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Surface4}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1">
        <DockPanel>
            <!-- 顶部标题栏 -->
            <Grid DockPanel.Dock="Top" Margin="18,14,16,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Danger}"
                             VerticalAlignment="Center" Margin="0,1,8,0"/>
                    <TextBlock x:Name="HeaderTitleText" Text="AI 请求删除日程"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Background="{DynamicResource DangerTint}" CornerRadius="4"
                        Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="CountdownText" Text="60s"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Danger}"
                               Typography.NumeralAlignment="Tabular"/>
                </Border>
            </Grid>

            <!-- 底部操作栏 -->
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Padding="18,10,16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}"
                            Content="拒绝（Esc）"
                            Background="{DynamicResource Surface2}"
                            Padding="14,6" Margin="0,0,8,0"
                            AutomationProperties.Name="拒绝删除"
                            AutomationProperties.AutomationId="McpDeleteDenyButton"
                            Click="Deny_Click"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="允许删除"
                            Background="{DynamicResource Danger}"
                            Padding="16,6"
                            AutomationProperties.Name="允许删除"
                            AutomationProperties.AutomationId="McpDeleteApproveButton"
                            Click="Approve_Click"/>
                </StackPanel>
            </Border>

            <!-- 中间明细卡片 -->
            <StackPanel Margin="18,2,18,16">
                <Border Background="{DynamicResource Surface3}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock x:Name="TargetTitleText"
                                   FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ImpactDetailText"
                                   Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="仅当场点击「允许删除」才会执行；拒绝或倒计时结束将自动拦截。"
                           Style="{StaticResource Caption}"
                           Margin="2,8,2,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
