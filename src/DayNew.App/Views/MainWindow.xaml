                                <TextBlock Text="应用内快捷键（主窗口激活时生效）"
                                           Style="{StaticResource Eyebrow}" Margin="0,10,0,8"/>
                                <ItemsControl ItemsSource="{Binding InAppShortcutItems}"
                                              ItemTemplate="{StaticResource ShortcutRowTemplate}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsSettingsTabSyncAndAi, Converter={StaticResource BoolToVisible}}">
                            <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="WebDAV 多端同步与备份" FontSize="13.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding WebDavStatusText}" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="兼容坚果云 WebDAV；应用专属密码经 Windows DPAPI 加密存于本机"
                                               Style="{StaticResource Caption}" Margin="0,3,0,10" TextWrapping="Wrap"/>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="地址" Style="{StaticResource EditorLabel}" Margin="0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource SubtleInput}"
                                                 Background="{DynamicResource Surface2}"
                                                 Height="30" VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="WebDAV 地址"
                                                 AutomationProperties.AutomationId="WebDavUrlBox"
                                                 Text="{Binding WebDavUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="账号" Style="{StaticResource EditorLabel}" Margin="0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource SubtleInput}"
                                                 Background="{DynamicResource Surface2}"
                                                 Height="30" VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="WebDAV 账号"
                                                 AutomationProperties.AutomationId="WebDavUserBox"
                                                 Text="{Binding WebDavUser, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="密码" Style="{StaticResource EditorLabel}" Margin="0" VerticalAlignment="Center"/>
