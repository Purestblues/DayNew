<Window x:Class="DayNew.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DayNew.Core"
        xmlns:vm="clr-namespace:DayNew.ViewModels"
        Title="日新 DayNew"
        Width="1360" Height="820"
        MinWidth="1080" MinHeight="620"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource Surface1}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <core:ZeroToVisibleConverter x:Key="ZeroToVisible"/>
        <core:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
        <core:EmptyToVisibleConverter x:Key="EmptyToVisible"/>
        <core:BoolToVisibleConverter x:Key="BoolToVisible"/>
        <core:RatioToWidthConverter x:Key="RatioToWidth"/>
        <core:TextEqualsConverter x:Key="TextEquals"/>

        <Style x:Key="TitleEditor" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionPill}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagRemoveButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="3,0,0,0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="AutomationProperties.Name" Value="移除标签"/>
        </Style>

        <!-- 概览 / 逾期 共用的任务卡片模板 -->
        <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type vm:TaskVM}">
            <Border x:Name="card" Tag="card" Style="{StaticResource CardBorder}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="标记完成 / 取消" Click="MenuToggleDone_Click"/>
                        <MenuItem Header="移到今天" Click="MenuMoveToday_Click"/>
                        <MenuItem Header="移到明天" Click="MenuMoveTomorrow_Click"/>
                        <Separator/>
                        <MenuItem Header="删除" Click="MenuDelete_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton Grid.Column="0" Style="{StaticResource CheckDot}"
                                  IsChecked="{Binding Done, Mode=OneWay}"
                                  VerticalAlignment="Top" Margin="0,2,9,0"
                                  Click="Check_Click"/>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="6" Height="6" Fill="{Binding Goal.Color}"
                                 VerticalAlignment="Top" Margin="0,7,6,0"
                                 Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}"/>

                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="titleBox" Style="{StaticResource TitleEditor}"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="Collapsed"
                                     KeyDown="TitleBox_KeyDown"/>
                            <TextBlock x:Name="titleText" Text="{Binding Title}"
                                       Style="{StaticResource CardTitle}"/>
                            <Grid x:Name="metaRow" Margin="0,1,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="remindBell" Grid.Column="0" Text="&#xEA8F;"
                                           FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                           Foreground="{DynamicResource TextTertiary}"
                                           VerticalAlignment="Center" Margin="0,0,5,0"
                                           ToolTip="{Binding RemindTooltip}"
                                           Visibility="{Binding ShowRemindBell, Converter={StaticResource BoolToVisible}}"/>
                                <TextBlock x:Name="metaText" Grid.Column="1" Text="{Binding MetaText}"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel x:Name="editor" Visibility="Collapsed"
                                        Opacity="0" Margin="0,9,0,0">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="editorShift" Y="-4"/>
                                </StackPanel.RenderTransform>
                                <Grid>
                                    <TextBox x:Name="noteBox" Style="{StaticResource SubtleInput}"
                                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="46" MaxHeight="140"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="备注（选填）" IsHitTestVisible="False"
                                               FontSize="12.5" FontWeight="Medium" Margin="8,6,0,0"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Visibility="{Binding Note, Converter={StaticResource EmptyToVisible}}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,7,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagChip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding Color}"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource TagText}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Content="&#xE711;"
                                                            Style="{StaticResource TagRemoveButton}"
                                                            Tag="{Binding}"
                                                            Click="TagRemove_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid HorizontalAlignment="Left" Margin="0,2,0,0">
                                    <TextBox x:Name="tagBox" Style="{StaticResource SubtleInput}"
                                             Width="96" Height="28"
                                             ToolTip="回车添加标签"
                                             KeyDown="TagInput_KeyDown"/>
                                    <TextBlock Text="+ 标签" IsHitTestVisible="False"
                                               FontSize="12" FontWeight="Medium" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Visibility="{Binding Text, ElementName=tagBox, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                </Grid>

                                <Grid HorizontalAlignment="Left" Margin="0,7,0,0">
                                    <TextBox x:Name="timeBox" Style="{StaticResource SubtleInput}"
                                             Height="28" Width="108"
                                             Text="{Binding TimeLabel, Mode=OneTime}"
                                             ToolTip="比如 9-10:30；留空回车 = 不要时间"
                                             KeyDown="TimeBox_KeyDown"
                                             LostFocus="TimeBox_LostFocus"/>
                                    <TextBlock Text="时间 9-10:30" IsHitTestVisible="False"
                                               FontSize="11.5" FontWeight="Medium" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Visibility="{Binding Text, ElementName=timeBox, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="紧急"
                                                  IsChecked="{Binding IsUrgent, Mode=OneWay}"
                                                  ToolTip="艾森豪威尔的两个轴：紧急"
                                                  Click="Urgent_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="重要"
                                                  IsChecked="{Binding IsImportant, Mode=OneWay}"
                                                  ToolTip="艾森豪威尔的两个轴：重要"
                                                  Click="Important_Click"/>
                                </StackPanel>

                                <WrapPanel Margin="0,7,0,0" ToolTip="{Binding RemindTooltip}">
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="不提醒" Tag="none"
                                                  Margin="0,0,4,4"
                                                  IsChecked="{Binding IsRemindNone, Mode=OneWay}"
                                                  Click="TaskRemindChip_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="前15分" Tag="pre15"
                                                  Margin="0,0,4,4"
                                                  IsChecked="{Binding IsRemindPre15, Mode=OneWay}"
                                                  Click="TaskRemindChip_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="前5分" Tag="pre5"
                                                  Margin="0,0,4,4"
                                                  IsChecked="{Binding IsRemindPre5, Mode=OneWay}"
                                                  Click="TaskRemindChip_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="开始" Tag="start"
                                                  Margin="0,0,4,4"
                                                  IsChecked="{Binding IsRemindStart, Mode=OneWay}"
                                                  Click="TaskRemindChip_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="结束" Tag="end"
                                                  Margin="0,0,4,4"
                                                  IsChecked="{Binding IsRemindEnd, Mode=OneWay}"
                                                  Click="TaskRemindChip_Click"/>
                                </WrapPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left" Padding="7,4" FontSize="11.5"
                                            Content="{Binding RepeatLabel}"
                                            ToolTip="点击切换：不重复 / 每天 / 每周 / 每月"
                                            Click="Repeat_Click"/>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right" Padding="7,4" FontSize="11.5"
                                            Foreground="{DynamicResource TextTertiary}"
                                            Content="删除" Click="Delete_Click"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Column="2" Text="&#x22EE;&#x22EE;"
                               FontSize="9" Margin="6,1,0,0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource TextDisabled}"/>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="editor" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="titleBox" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="titleText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="metaRow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                    <Setter TargetName="card" Property="Cursor" Value="Arrow"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="editor" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                                <DoubleAnimation Storyboard.TargetName="editorShift" Storyboard.TargetProperty="Y"
                                                 From="-4" To="0" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Done}" Value="True"/>
                        <Condition Binding="{Binding IsExpanded}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="card" Property="Opacity" Value="0.5"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="titleText" Property="TextDecorations" Value="Strikethrough"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetaText}" Value="">
                    <Setter TargetName="metaText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding MetaText}" Value=""/>
                        <Condition Binding="{Binding ShowRemindBell}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="metaRow" Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Grid Grid.Row="0" Background="{DynamicResource Surface1}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource AccentTint}">
                    <TextBlock Text="日" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="日新" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                <Border Background="{DynamicResource Surface3}" CornerRadius="4" Padding="6,1"
                        Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="原型" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextTertiary}"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="ThemeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE706;" ToolTip="切换明暗"
                        AutomationProperties.Name="切换明暗"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Theme_Click"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="最小化"
                        AutomationProperties.Name="最小化"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        ToolTip="最大化" AutomationProperties.Name="最大化"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="关闭"
                        AutomationProperties.Name="关闭窗口"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
            </StackPanel>

            <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                    Background="{DynamicResource BorderSubtle}"/>
        </Grid>

        <!-- ================= dock + 内容 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DockColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧竖排 dock -->
            <Border x:Name="DockBorder" Grid.Column="0" Width="196" ClipToBounds="True"
                    Background="{DynamicResource Surface1}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,12,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="工作区" Style="{StaticResource Eyebrow}"
                                   Margin="18,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabled}"
                                   Visibility="{Binding IsDockExpanded, Converter={StaticResource BoolToVisible}}"/>
                        <Button Grid.Column="1" x:Name="DockToggle"
                                Style="{StaticResource GhostButton}" Padding="6,3"
                                FontFamily="{StaticResource IconFont}" FontSize="10"
                                Content="&#xE76B;" ToolTip="收起 / 展开侧边栏"
                                AutomationProperties.Name="收起或展开侧边栏"
                                RenderTransformOrigin="0.5,0.5"
                                Click="DockToggle_Click">
                            <Button.RenderTransform>
                                <RotateTransform x:Name="DockToggleRotate" Angle="0"/>
                            </Button.RenderTransform>
                        </Button>
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,12">
                        <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}"
                                HorizontalContentAlignment="Stretch"
                                Padding="10,8" Margin="0,0,0,8"
                                ToolTip="设置"
                                AutomationProperties.Name="设置"
                                AutomationProperties.AutomationId="SettingsButton"
                                Click="SettingsOpen_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" Width="24"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="设置" Style="{StaticResource NavLabel}"
                                           Visibility="{Binding IsDockExpanded, Converter={StaticResource BoolToVisible}}"/>
                            </Grid>
                        </Button>
                        <TextBlock Text="{Binding AppVersion, StringFormat={}{0} 原型}"
                                   Style="{StaticResource Caption}" Margin="10,0,0,2"
                                   Foreground="{DynamicResource TextDisabled}"
                                   Visibility="{Binding IsDockExpanded, Converter={StaticResource BoolToVisible}}"/>
                    </StackPanel>

                    <ListBox x:Name="NavHost" Style="{StaticResource NavList}"
                             Margin="0,2,0,8"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItemVM}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBlock x:Name="ico" Text="{Binding Icon}" Style="{StaticResource NavIcon}"/>
                                        <Ellipse x:Name="collapsedDot" Width="5" Height="5" Fill="{DynamicResource Danger}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,3,0"
                                                 Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock x:Name="lbl" Grid.Column="1" Text="{Binding Title}"
                                               Style="{StaticResource NavLabel}"
                                               Visibility="{Binding DataContext.IsDockExpanded, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisible}}"/>
                                    <Border x:Name="badgePill" Grid.Column="2"
                                            Background="{DynamicResource Danger}" CornerRadius="10"
                                            MinWidth="20" Height="20" Padding="6,0"
                                            VerticalAlignment="Center" Margin="6,0,0,0"
                                            Visibility="Collapsed">
                                        <TextBlock Text="{Binding BadgeCount}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource OnAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter TargetName="lbl" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasBadge}" Value="True"/>
                                            <Condition Binding="{Binding DataContext.IsDockExpanded, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="badgePill" Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasBadge}" Value="True"/>
                                            <Condition Binding="{Binding DataContext.IsDockExpanded, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="collapsedDot" Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Column="1" Background="{DynamicResource Surface0}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 快速录入已取消：日程只有一个创建入口——在「视图」页的时间轴上拖出一段 -->

                <!-- 页面宿主 -->
                <Grid x:Name="PageHost" Grid.Row="1">

                    <!-- 概览：4 个任务档位 + 右侧目标列，五等分（逾期移到左侧 dock） -->
                    <Grid x:Name="PageOverview" Margin="12,14,12,0"
                          Visibility="{Binding IsOverview, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="50"/>
                            <ColumnDefinition Width="*" MinWidth="50"/>
                            <ColumnDefinition Width="*" MinWidth="50"/>
                            <ColumnDefinition Width="*" MinWidth="50"/>
                            <ColumnDefinition Width="*" MinWidth="50"/>
                        </Grid.ColumnDefinitions>

                        <ItemsControl x:Name="LanesHost" Grid.Column="0" Grid.ColumnSpan="4"
                                      ItemsSource="{Binding OverviewLanes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LaneVM}">
                                    <Border x:Name="lane" Style="{StaticResource LaneBorder}">
                                        <Grid>
                                            <Border x:Name="laneDropOverlay" Background="{DynamicResource AccentTint}"
                                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                                    CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                                            <DockPanel>
                                            <Border DockPanel.Dock="Top" Padding="4,0,4,8" Margin="0,0,0,10"
                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="laneTitle" Text="{Binding Title}"
                                                               Style="{StaticResource Eyebrow}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Count}"
                                                               Style="{StaticResource Eyebrow}"
                                                               Foreground="{DynamicResource TextTertiary}"/>
                                                </Grid>
                                            </Border>

                                            <Grid>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Padding="0,0,2,0">
                                                    <ItemsControl ItemsSource="{Binding Items}" Margin="4,0,4,8"
                                                                  ItemTemplate="{StaticResource TaskCardTemplate}"/>
                                                </ScrollViewer>

                                                <Grid VerticalAlignment="Top" Margin="4,0,4,0" IsHitTestVisible="False"
                                                      Visibility="{Binding Count, Converter={StaticResource ZeroToVisible}}">
                                                    <Rectangle Height="52" RadiusX="8" RadiusY="8"
                                                               Stroke="{DynamicResource BorderStrong}" StrokeThickness="1"
                                                               StrokeDashArray="3 3" Opacity="0.55"/>
                                                    <TextBlock Text="拖到这里" Style="{StaticResource Caption}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                            </DockPanel>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter TargetName="laneTitle" Property="Foreground" Value="{DynamicResource Danger}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="laneDropOverlay" Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="{StaticResource DurXs}" EasingFunction="{StaticResource EaseOut}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="laneDropOverlay" Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 目标列：放目标，不是任务；任务拖到目标卡片上就挂过去了 -->
                        <Border Grid.Column="4" Style="{StaticResource LaneBorder}" Margin="4,0,4,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="4,0,4,8" Margin="0,0,0,10"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="目标" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Goals.Count}"
                                                   Style="{StaticResource Eyebrow}"
                                                   Foreground="{DynamicResource TextTertiary}"/>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                                        <ItemsControl x:Name="GoalsHost" ItemsSource="{Binding Goals}" Margin="4,0,4,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:GoalVM}">
                                                    <Border x:Name="goalCard" Tag="goal" Style="{StaticResource CardBorder}"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Grid>
                                                            <Border x:Name="goalDropOverlay" Background="{DynamicResource AccentTint}"
                                                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                                                    CornerRadius="8" Margin="-10,-8" Opacity="0" IsHitTestVisible="False"/>
                                                            <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Fill="{Binding Color}"
                                                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                <TextBlock Text="{Binding Title}"
                                                                           Style="{StaticResource CardTitle}"/>
                                                            </StackPanel>

                                                            <Grid x:Name="bar" Height="3" Margin="0,7,0,0">
                                                                <Border Background="{DynamicResource Surface3}" CornerRadius="2"/>
                                                                <Border Background="{DynamicResource Accent}" CornerRadius="2"
                                                                        HorizontalAlignment="Left">
                                                                    <Border.Width>
                                                                        <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                                            <Binding ElementName="bar" Path="ActualWidth"/>
                                                                            <Binding Path="Progress"/>
                                                                        </MultiBinding>
                                                                    </Border.Width>
                                                                </Border>
                                                            </Grid>

                                                            <TextBlock Text="{Binding ProgressText}"
                                                                       Style="{StaticResource Caption}" Margin="0,5,0,0"/>

                                                            <ItemsControl x:Name="goalTasks" ItemsSource="{Binding Tasks}"
                                                                          Margin="0,7,0,0" Visibility="Collapsed" Opacity="0">
                                                                <ItemsControl.RenderTransform>
                                                                    <TranslateTransform x:Name="goalTasksShift" Y="-4"/>
                                                                </ItemsControl.RenderTransform>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:TaskVM}">
                                                                        <TextBlock x:Name="taskRow" Text="{Binding Title}"
                                                                                   Style="{StaticResource Caption}"
                                                                                   Margin="0,3,0,0"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <DataTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                                                <Setter TargetName="taskRow" Property="TextDecorations" Value="Strikethrough"/>
                                                                                <Setter TargetName="taskRow" Property="Opacity" Value="0.5"/>
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter TargetName="goalTasks" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="goalCard" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                                                            <Setter TargetName="goalCard" Property="Cursor" Value="Arrow"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="goalTasks" Storyboard.TargetProperty="Opacity"
                                                                                         From="0" To="1" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                                                                        <DoubleAnimation Storyboard.TargetName="goalTasksShift" Storyboard.TargetProperty="Y"
                                                                                         From="-4" To="0" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="goalDropOverlay" Storyboard.TargetProperty="Opacity"
                                                                                         To="1" Duration="{StaticResource DurXs}" EasingFunction="{StaticResource EaseOut}"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="goalDropOverlay" Storyboard.TargetProperty="Opacity"
                                                                                         To="0" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel VerticalAlignment="Top" IsHitTestVisible="False" Margin="4,0,4,0"
                                                Visibility="{Binding Goals.Count, Converter={StaticResource ZeroToVisible}}">
                                        <Rectangle Height="52" RadiusX="8" RadiusY="8"
                                                   Stroke="{DynamicResource BorderStrong}" StrokeThickness="1"
                                                   StrokeDashArray="3 3" Opacity="0.55"/>
                                        <TextBlock Text="还没有目标" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 视图：24 小时 × 日期 -->
                    <Grid x:Name="PageTimeline" Margin="16,14,16,0"
                          PreviewMouseWheel="PageTimeline_PreviewMouseWheel"
                          Visibility="{Binding IsTimeline, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 工具条：回到今日今时 + 快捷日程预设卡片 + 管理入口 + 缩放档 -->
                        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="回到今日今时" Style="{StaticResource GhostButton}"
                                    AutomationProperties.Name="回到今日今时"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Padding="9,4" Margin="0,0,8,0" Click="Today_Click"/>

                            <ScrollViewer x:Name="PresetsScroll" Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center" Margin="0,0,8,0">
                                <ItemsControl x:Name="PresetsHost" ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SchedulePresetVM}">
                                            <Border x:Name="presetChip" Tag="preset"
                                                    Background="{DynamicResource Surface2}"
                                                    BorderBrush="{DynamicResource BorderSubtle}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    Padding="9,4" Margin="0,0,6,0"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    ToolTip="按住拖到下方时间轴直接添加">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding DotBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"
                                                             Visibility="{Binding HasDot, Converter={StaticResource BoolToVisible}}"/>
                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding DurationLabel}"
                                                               FontSize="11" FontWeight="Medium"
                                                               VerticalAlignment="Center" Margin="5,0,0,0"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock Text="&#xEA8F;"
                                                               FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               VerticalAlignment="Center" Margin="4,0,0,0"
                                                               ToolTip="{Binding RemindTooltip}"
                                                               Visibility="{Binding HasRemind, Converter={StaticResource BoolToVisible}}"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="presetChip" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="presetChip" Property="Background" Value="{DynamicResource Surface3}"/>
                                                    <Setter TargetName="presetChip" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ManagePresetsButton" Style="{StaticResource GhostButton}"
                                        Padding="8,4" Margin="0,0,6,0"
                                        ToolTip="新增、编辑或删除快捷日程卡片"
                                        AutomationProperties.Name="管理快捷卡片"
                                        AutomationProperties.AutomationId="ManagePresetsButton"
                                        Click="ManagePresets_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="10.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="快捷卡片" FontSize="12" FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <ItemsControl ItemsSource="{Binding ZoomOptions}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ZoomOptionVM}">
                                            <ToggleButton Style="{StaticResource SegmentButton}"
                                                          Content="{Binding Label}"
                                                          Tag="{Binding Index}"
                                                          IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                                          Click="Zoom_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <!-- 日期表头（跟着横向滚动） -->
                        <ScrollViewer x:Name="HeaderScroll" Grid.Row="1" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      IsHitTestVisible="False" Focusable="False">
                            <ItemsControl ItemsSource="{Binding TimelineDays}" Width="{Binding TimelineWidth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineDayVM}">
                                        <Border Width="160" Padding="10,0,0,7"
                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                BorderThickness="0,0,1,1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="dayName" Text="{Binding DayName}"
                                                           Style="{StaticResource Eyebrow}"
                                                           FontSize="13.5" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="dayNumber" Text="{Binding DayNumber}"
                                                           Style="{StaticResource Caption}"
                                                           FontSize="12.5" VerticalAlignment="Center"
                                                           Margin="7,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="dayName" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="dayNumber" Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 左侧刻度（跟着纵向滚动） -->
                        <ScrollViewer x:Name="GutterScroll" Grid.Row="2" Grid.Column="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsHitTestVisible="False" Focusable="False">
                            <Grid Width="66" Height="{Binding GridHeight}">
                                <ItemsControl ItemsSource="{Binding TimelineHours}" Width="66">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineHourVM}">
                                            <TextBlock x:Name="tickText" Text="{Binding Text}" Height="{Binding Height}"
                                                       FontSize="11.5" FontWeight="Medium" Margin="0,0,8,0"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHour}" Value="True">
                                                    <Setter TargetName="tickText" Property="FontSize" Value="12.5"/>
                                                    <Setter TargetName="tickText" Property="FontWeight" Value="SemiBold"/>
                                                    <Setter TargetName="tickText" Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 当前分钟徽标（跟随红线高度） -->
                                <Canvas IsHitTestVisible="False">
                                    <Border Canvas.Top="{Binding NowLineTop}" Canvas.Right="6"
                                            Margin="0,-9,0,0" Padding="5,1" CornerRadius="4"
                                            Background="{DynamicResource Danger}">
                                        <TextBlock Text="{Binding NowTimeText}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource OnAccent}"
                                                   Typography.NumeralAlignment="Tabular"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>

                        <!-- 网格 + 任务块 -->
                        <ScrollViewer x:Name="BodyScroll" Grid.Row="2" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="BodyScroll_ScrollChanged">
                            <Grid Width="{Binding TimelineWidth}" Height="{Binding GridHeight}">
                                <ItemsControl x:Name="DaysHost" ItemsSource="{Binding TimelineDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineDayVM}">
                                            <Border Width="160" Background="{Binding GridBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtle}"
                                                    BorderThickness="0,0,1,0">
                                                <Grid>
                                                    <Border Background="{DynamicResource AccentTint}" Opacity="0.3"
                                                            IsHitTestVisible="False"
                                                            Visibility="{Binding IsToday, Converter={StaticResource BoolToVisible}}"/>

                                                    <ItemsControl ItemsSource="{Binding Blocks}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:TimelineBlockVM}">
                                                                <Border x:Name="blk" Width="{Binding Width}" Height="{Binding Height}"
                                                                        Tag="block" ClipToBounds="True"
                                                                        Background="{DynamicResource Surface2}"
                                                                        BorderBrush="{DynamicResource BorderStrong}"
                                                                        BorderThickness="1" CornerRadius="4"
                                                                        Cursor="Hand"
                                                                        RenderTransformOrigin="0.5,0.5"
                                                                        ToolTip="双击编辑">
                                                                    <Grid>
                                                                        <Border x:Name="blkHover" Background="{DynamicResource HoverOverlay}"
                                                                                CornerRadius="3" Opacity="0" IsHitTestVisible="False"/>
                                                                        <Grid x:Name="blkSingleLine" Margin="6,0" VerticalAlignment="Center"
                                                                              Visibility="Collapsed">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock x:Name="blkSingleTitle" Text="{Binding Title}"
                                                                                       FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                                                        Margin="4,0,0,0"
                                                                                        Visibility="{Binding HasInlineDots, Converter={StaticResource BoolToVisible}}">
                                                                                <ItemsControl ItemsSource="{Binding Task.Tags}" VerticalAlignment="Center">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal"/>
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Ellipse Width="4" Height="4" Fill="{Binding Color}"
                                                                                                     VerticalAlignment="Center" Margin="0,0,2,0"
                                                                                                     ToolTip="{Binding Name}"/>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <Ellipse Width="4" Height="4" Fill="{Binding Task.Goal.Color}"
                                                                                         VerticalAlignment="Center" Margin="1,0,0,0"
                                                                                         Visibility="{Binding Task.HasGoal, Converter={StaticResource BoolToVisible}}"
                                                                                         ToolTip="{Binding Task.Goal.Title}"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                                                                <TextBlock Text="&#xEA8F;"
                                                                                           FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                                           VerticalAlignment="Center" Margin="0,0,3,0"
                                                                                           ToolTip="{Binding Task.RemindTooltip}"
                                                                                           Visibility="{Binding Task.ShowRemindBell, Converter={StaticResource BoolToVisible}}"/>
                                                                                <TextBlock Text="{Binding TimeText}"
                                                                                           FontSize="10.5" FontWeight="Medium"
                                                                                           VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                                           Typography.NumeralAlignment="Tabular"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <Grid x:Name="blkContent" Margin="6,3">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                                                                <TextBlock x:Name="blkTitle" Text="{Binding Title}"
                                                                                           FontSize="12" FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock x:Name="blkTime" Text="{Binding TimeText}" FontSize="10.5" FontWeight="Medium"
                                                                                               Foreground="{DynamicResource TextTertiary}"
                                                                                               VerticalAlignment="Center"
                                                                                               Typography.NumeralAlignment="Tabular"/>
                                                                                    <TextBlock Text="&#xEA8F;"
                                                                                               FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                                                               Foreground="{DynamicResource TextTertiary}"
                                                                                               VerticalAlignment="Center" Margin="4,0,0,0"
                                                                                               ToolTip="{Binding Task.RemindTooltip}"
                                                                                               Visibility="{Binding Task.ShowRemindBell, Converter={StaticResource BoolToVisible}}"/>
                                                                                </StackPanel>
                                                                            </StackPanel>

                                                                            <!-- 右侧：所属标签 + 目标。和标题/时间左右并排，短块也能完整展示 -->
                                                                            <StackPanel x:Name="blkMeta" Grid.Column="1"
                                                                                        MaxWidth="76" Margin="6,1,0,0"
                                                                                        VerticalAlignment="Top" HorizontalAlignment="Right"
                                                                                        Visibility="{Binding HasSideMeta, Converter={StaticResource BoolToVisible}}">
                                                                                <ItemsControl ItemsSource="{Binding Task.Tags}" HorizontalAlignment="Right">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <WrapPanel HorizontalAlignment="Right"/>
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Margin="4,0,0,1">
                                                                                                <Ellipse Width="4" Height="4" Fill="{Binding Color}"
                                                                                                         VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Medium"
                                                                                                           MaxWidth="52" TextTrimming="CharacterEllipsis"
                                                                                                           Foreground="{DynamicResource TextTertiary}"/>
                                                                                            </StackPanel>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>

                                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0"
                                                                                            Visibility="{Binding Task.HasGoal, Converter={StaticResource BoolToVisible}}">
                                                                                    <Ellipse Width="4" Height="4" Fill="{Binding Task.Goal.Color}"
                                                                                             VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                    <TextBlock Text="{Binding Task.Goal.Title}" FontSize="10" FontWeight="Medium"
                                                                                               MaxWidth="64" TextTrimming="CharacterEllipsis"
                                                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <!-- 上下边缘调整时间热区（以 5 分钟为单位） -->
                                                                        <Border x:Name="topResize" Tag="blockTopEdge" Height="5" VerticalAlignment="Top"
                                                                                Background="Transparent" Cursor="SizeNS" Panel.ZIndex="10">
                                                                            <Border x:Name="topGrip" Height="2" VerticalAlignment="Top" Margin="10,1,10,0"
                                                                                    CornerRadius="1" Background="{DynamicResource Accent}" Opacity="0"
                                                                                    IsHitTestVisible="False"/>
                                                                        </Border>
                                                                        <Border x:Name="bottomResize" Tag="blockBottomEdge" Height="5" VerticalAlignment="Bottom"
                                                                                Background="Transparent" Cursor="SizeNS" Panel.ZIndex="10">
                                                                            <Border x:Name="bottomGrip" Height="2" VerticalAlignment="Bottom" Margin="10,0,10,1"
                                                                                    CornerRadius="1" Background="{DynamicResource Accent}" Opacity="0"
                                                                                    IsHitTestVisible="False"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <Trigger SourceName="topResize" Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="topGrip" Property="Opacity" Value="0.85"/>
                                                                    </Trigger>
                                                                    <Trigger SourceName="bottomResize" Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bottomGrip" Property="Opacity" Value="0.85"/>
                                                                    </Trigger>
                                                                    <Trigger SourceName="blk" Property="IsMouseOver" Value="True">
                                                                        <Trigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="blkHover" Storyboard.TargetProperty="Opacity"
                                                                                                     To="1" Duration="{StaticResource DurXs}" EasingFunction="{StaticResource EaseOut}"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.EnterActions>
                                                                        <Trigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="blkHover" Storyboard.TargetProperty="Opacity"
                                                                                                     To="0" Duration="{StaticResource DurXs}" EasingFunction="{StaticResource EaseOut}"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.ExitActions>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                                                        <Setter TargetName="blk" Property="Opacity" Value="0.5"/>
                                                                        <Setter TargetName="blkTitle" Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter TargetName="blkSingleTitle" Property="TextDecorations" Value="Strikethrough"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSingleLine}" Value="True">
                                                                        <Setter TargetName="blkContent" Property="Visibility" Value="Collapsed"/>
                                                                        <Setter TargetName="blkSingleLine" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                                                        <Setter TargetName="blkContent" Property="Margin" Value="6,2"/>
                                                                        <Setter TargetName="blkTitle" Property="FontSize" Value="11"/>
                                                                        <Setter TargetName="blkTime" Property="FontSize" Value="10"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSmallBlock}" Value="True">
                                                                        <Setter TargetName="topResize" Property="Height" Value="4"/>
                                                                        <Setter TargetName="bottomResize" Property="Height" Value="4"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 当前时刻红线（分钟级：跨全宽淡红线 + 今日列高亮实线与圆点） -->
                                <Canvas IsHitTestVisible="False">
                                    <Border Canvas.Top="{Binding NowLineTop}" Canvas.Left="0"
                                            Width="{Binding TimelineWidth}" Height="1"
                                            Background="{DynamicResource Danger}" Opacity="0.45"/>
                                    <Border Canvas.Top="{Binding NowLineTop}" Canvas.Left="{Binding NowTodayLeft}"
                                            Width="160" Height="1.5" Margin="0,-0.25,0,0"
                                            Background="{DynamicResource Danger}"/>
                                    <Ellipse Canvas.Top="{Binding NowLineTop}" Canvas.Left="{Binding NowTodayLeft}"
                                             Width="7" Height="7" Margin="-3.5,-3,0,0"
                                             Fill="{DynamicResource Danger}"/>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- 目标页：矩形卡片，窗口越宽列越多 -->
                    <Grid x:Name="PageGoals" Margin="24,14,24,0"
                          Visibility="{Binding IsGoals, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14" MaxWidth="620" HorizontalAlignment="Left">
                                <TextBox x:Name="GoalInput" Style="{StaticResource SubtleInput}" Height="38"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding GoalInput, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="GoalInput_KeyDown"/>
                                <TextBlock Text="新建目标，回车确认（比如「学 Python」）"
                                           IsHitTestVisible="False" VerticalAlignment="Center"
                                           Margin="9,0,0,0" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextDisabled}"
                                           Visibility="{Binding Text, ElementName=GoalInput, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Goals}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <core:ResponsiveGridPanel MinColumnWidth="268" ColumnGap="12" RowGap="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GoalVM}">
                                            <Border x:Name="goalPageCard" Tag="goalpagecard"
                                                    Style="{StaticResource GridCard}" Height="138"
                                                    Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                                                    ToolTip="点击查看该目标下的日程"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Color}"
                                                                 VerticalAlignment="Center" Margin="0,1,8,0"/>
                                                        <TextBox Grid.Column="1" Style="{StaticResource TitleEditor}"
                                                                 HorizontalAlignment="Left" MinWidth="32"
                                                                 VerticalAlignment="Center" Cursor="IBeam"
                                                                 ToolTip="点击名称可重命名"
                                                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                                   FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   Foreground="{DynamicResource TextDisabled}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </Grid>

                                                    <Grid x:Name="bar" Grid.Row="1" Height="4" VerticalAlignment="Center"
                                                          Margin="0,8,0,8">
                                                        <Border Background="{DynamicResource BorderSubtle}" CornerRadius="2"/>
                                                        <Border Background="{DynamicResource Accent}" CornerRadius="2"
                                                                HorizontalAlignment="Left">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                                    <Binding ElementName="bar" Path="ActualWidth"/>
                                                                    <Binding Path="Progress"/>
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>

                                                    <Grid Grid.Row="2">
                                                        <TextBlock Text="{Binding ProgressText}"
                                                                   Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                                Content="删除" Foreground="{DynamicResource TextTertiary}"
                                                                Tag="{Binding}" Click="DeleteGoal_Click"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <!-- 标签页：矩形卡片，窗口越宽列越多 -->
                    <Grid x:Name="PageTags" Margin="24,14,24,0"
                          Visibility="{Binding IsTags, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" MaxWidth="760" HorizontalAlignment="Left"
                                       Text="标签只在这里管理；概览页里只负责往卡片上贴。全库只有一份，改名直接作用到所有用到它的日程。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding TagRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <core:ResponsiveGridPanel MinColumnWidth="236" ColumnGap="12" RowGap="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TagRowVM}">
                                            <Border x:Name="tagCard" Tag="tagcard"
                                                    Style="{StaticResource GridCard}"
                                                    Height="116" Cursor="Hand"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    ToolTip="点击查看该标签下的日程"
                                                    AutomationProperties.Name="{Binding Tag.Name}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Tag.Color}"
                                                                 VerticalAlignment="Center" Margin="0,1,8,0"/>
                                                        <TextBox Grid.Column="1" Style="{StaticResource TitleEditor}"
                                                                 HorizontalAlignment="Left" MinWidth="32"
                                                                 VerticalAlignment="Center" Cursor="IBeam"
                                                                 ToolTip="点击名称可重命名"
                                                                 Text="{Binding Tag.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                                   FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   Foreground="{DynamicResource TextDisabled}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" Text="{Binding CountText}"
                                                               Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" Margin="0,6,0,6"/>

                                                    <Button Grid.Row="2" Style="{StaticResource GhostButton}"
                                                            HorizontalAlignment="Left" Content="删除"
                                                            Foreground="{DynamicResource TextTertiary}"
                                                            Tag="{Binding Tag}" ToolTip="从所有日程上拿掉这个标签"
                                                            Click="DeleteTagRow_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <!-- 艾森豪威尔：两个标记决定的四格 -->
                    <Grid x:Name="PageEisenhower" Margin="16,14,16,0"
                          Visibility="{Binding IsEisenhower, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <ItemsControl x:Name="QuadrantsHost" ItemsSource="{Binding Quadrants}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" Rows="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QuadrantVM}">
                                    <Border x:Name="quad" Style="{StaticResource QuadCell}"
                                            Margin="4" Padding="12,10">
                                        <Grid>
                                            <Border x:Name="quadDropOverlay" Background="{DynamicResource AccentTint}"
                                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                                    CornerRadius="8" Margin="-12,-10" Opacity="0" IsHitTestVisible="False"/>
                                            <DockPanel>
                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Eyebrow}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Count}"
                                                               Style="{StaticResource Eyebrow}"
                                                               Foreground="{DynamicResource TextTertiary}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                                           Foreground="{DynamicResource TextDisabled}" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <Grid>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Padding="0,0,4,0">
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:TaskVM}">
                                                            <Border x:Name="row" Tag="boardrow"
                                                                    Style="{StaticResource CardBorder}"
                                                                    Width="228" Margin="0,0,8,8"
                                                                    RenderTransformOrigin="0.5,0.5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Width="6" Height="6" Fill="{Binding Goal.Color}"
                                                                             VerticalAlignment="Top" Margin="0,7,7,0"
                                                                             Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}"/>
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   Style="{StaticResource CardTitle}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <Grid Margin="0,1,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="&#xEA8F;"
                                                                                       FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                                                                       Foreground="{DynamicResource TextTertiary}"
                                                                                       VerticalAlignment="Center" Margin="0,0,5,0"
                                                                                       ToolTip="{Binding RemindTooltip}"
                                                                                       Visibility="{Binding ShowRemindBell, Converter={StaticResource BoolToVisible}}"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding MetaText}"
                                                                                       Style="{StaticResource Caption}"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                                    <Setter TargetName="row" Property="Opacity" Value="0.5"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </ScrollViewer>

                                                <Rectangle VerticalAlignment="Top" Height="48" RadiusX="6" RadiusY="6"
                                                           Stroke="{DynamicResource BorderStrong}" StrokeThickness="1"
                                                           StrokeDashArray="3 3" Opacity="0.45"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding Count, Converter={StaticResource ZeroToVisible}}"/>
                                            </Grid>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="quadDropOverlay" Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="{StaticResource DurXs}" EasingFunction="{StaticResource EaseOut}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="quadDropOverlay" Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 逾期页：网格卡片，窗口越宽列越多 -->
                    <Grid x:Name="PageOverdue" Margin="24,14,24,0"
                          Visibility="{Binding IsOverduePage, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="逾期" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Danger}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding OverdueLane.Count}" Style="{StaticResource Eyebrow}"
                                               Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center" Margin="8,2,0,0"/>
                                </StackPanel>
                                <TextBlock Text="已过截止日还没完成的日程；单击展开、双击弹窗编辑，右键可一键移到今天或明天。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="OverdueHost" ItemsSource="{Binding OverdueLane.Items}"
                                                  ItemTemplate="{StaticResource TaskCardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <core:ResponsiveGridPanel MinColumnWidth="252" ColumnGap="12" RowGap="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding OverdueLane.Count, Converter={StaticResource ZeroToVisible}}">
                                    <TextBlock Text="没有逾期的日程" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="所有日程都在掌控之中" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Grid>

                    <!-- 还没做的页 -->
                    <Grid x:Name="PagePlaceholder"
                          Visibility="{Binding IsPlaceholder, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430">
                            <TextBlock Text="待做" Style="{StaticResource Eyebrow}"
                                       Foreground="{DynamicResource TextDisabled}"/>
                            <TextBlock Text="{Binding CurrentTitle}" FontSize="19" FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding CurrentBlurb}" TextWrapping="Wrap" LineHeight="21"
                                       FontSize="13" FontWeight="Medium" Margin="0,12,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <Border Background="{DynamicResource Surface3}" CornerRadius="6"
                                    Padding="10,5" HorizontalAlignment="Left" Margin="0,20,0,0">
                                <TextBlock Text="先把结构定下来，功能随后补" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 状态栏 -->
                <Grid Grid.Row="2" Margin="16,4,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusLeft}" Style="{StaticResource Caption}"/>
                    <TextBlock Grid.Column="2" Text="{Binding StatusRight}" Style="{StaticResource Caption}"
                               ToolTip="{Binding DataPath}"
                               Foreground="{DynamicResource TextDisabled}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= 标签详情按日时间流浮层 ================= -->
        <Grid x:Name="TagDetailLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="TagDetailScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="TagDetailScrim_Click"/>
            <Border x:Name="TagDetailDialog" Width="980" Height="560"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True"
                    Opacity="0" RenderTransformOrigin="0.5,0.5"
                    PreviewMouseWheel="TagDetailScroll_PreviewMouseWheel">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="TagDetailScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="TagDetailShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <DockPanel>
                    <!-- 顶部栏 -->
                    <Border DockPanel.Dock="Top" Padding="20,14,14,12"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{Binding DetailColor}"
                                         VerticalAlignment="Center" Margin="0,1,9,0"/>
                                <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TagDetailTotalText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="10,2,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="滚轮横向滚动 · 双击日程编辑" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextDisabled}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Style="{StaticResource GhostButton}" Content="回到今天"
                                        Padding="9,4" Margin="0,0,6,0"
                                        AutomationProperties.Name="回到今天"
                                        AutomationProperties.AutomationId="TagDetailTodayButton"
                                        Click="TagDetailToday_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="&#xE711;"
                                        FontFamily="{StaticResource IconFont}" FontSize="11"
                                        ToolTip="关闭（Esc）"
                                        AutomationProperties.Name="关闭"
                                        AutomationProperties.AutomationId="TagDetailCloseButton"
                                        Click="TagDetailClose_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 横向日期条状流 + 底部横向滚动条 -->
                    <ScrollViewer x:Name="TagDetailScroll"
                                  HorizontalScrollBarVisibility="Visible"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="8,0,8,6" Padding="0,0,0,4">
                        <ItemsControl x:Name="TagDetailDaysHost" ItemsSource="{Binding TagDetailDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagDayColumnVM}">
                                    <Border Width="188" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
                                        <Grid>
                                            <Border Background="{DynamicResource AccentTint}" Opacity="0.22"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding IsToday, Converter={StaticResource BoolToVisible}}"/>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Padding="12,10,12,8"
                                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="tagDayName" Text="{Binding DayName}"
                                                                       Style="{StaticResource Eyebrow}" FontSize="13.5"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="tagDayNumber" Text="{Binding DayNumber}"
                                                                       Style="{StaticResource Caption}" FontSize="12.5"
                                                                       VerticalAlignment="Center" Margin="7,0,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Count}"
                                                                   Style="{StaticResource Eyebrow}"
                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding HasItems, Converter={StaticResource BoolToVisible}}"/>
                                                    </Grid>
                                                </Border>

                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Padding="8,10,8,10">
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:TaskVM}">
                                                                <Border x:Name="tagTaskCard" Tag="tagtaskcard"
                                                                        Style="{StaticResource CardBorder}"
                                                                        RenderTransformOrigin="0.5,0.5"
                                                                        ToolTip="双击编辑日程">
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="标记完成 / 取消" Click="MenuToggleDone_Click"/>
                                                                            <MenuItem Header="移到今天" Click="MenuMoveToday_Click"/>
                                                                            <MenuItem Header="移到明天" Click="MenuMoveTomorrow_Click"/>
                                                                            <Separator/>
                                                                            <MenuItem Header="删除" Click="MenuDelete_Click"/>
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <ToggleButton Grid.Column="0" Style="{StaticResource CheckDot}"
                                                                                      IsChecked="{Binding Done, Mode=OneWay}"
                                                                                      VerticalAlignment="Top" Margin="0,2,8,0"
                                                                                      Click="Check_Click"/>

                                                                        <StackPanel Grid.Column="1">
                                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                                <TextBlock x:Name="tagTaskTime" Text="{Binding TimeLabel}"
                                                                                           FontSize="11" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource Accent}"
                                                                                           VerticalAlignment="Center"
                                                                                           Typography.NumeralAlignment="Tabular"/>
                                                                                <TextBlock Text="&#xEA8F;"
                                                                                           FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                                           VerticalAlignment="Center" Margin="5,0,0,0"
                                                                                           ToolTip="{Binding RemindTooltip}"
                                                                                           Visibility="{Binding ShowRemindBell, Converter={StaticResource BoolToVisible}}"/>
                                                                            </StackPanel>

                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Ellipse Width="6" Height="6" Fill="{Binding Goal.Color}"
                                                                                         VerticalAlignment="Top" Margin="0,6,6,0"
                                                                                         Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}"/>
                                                                                <TextBlock x:Name="tagTaskTitle" Grid.Column="1"
                                                                                           Text="{Binding Title}"
                                                                                           Style="{StaticResource CardTitle}"
                                                                                           FontSize="13"/>
                                                                            </Grid>

                                                                            <TextBlock Text="{Binding Note}"
                                                                                       Style="{StaticResource Caption}"
                                                                                       TextWrapping="Wrap" MaxHeight="34"
                                                                                       Margin="0,3,0,0"
                                                                                       Visibility="{Binding Note, Converter={StaticResource EmptyToCollapsed}}"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding HasTime}" Value="False">
                                                                        <Setter TargetName="tagTaskTime" Property="Text" Value="未设时刻"/>
                                                                        <Setter TargetName="tagTaskTime" Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                                                        <Setter TargetName="tagTaskCard" Property="Opacity" Value="0.5"/>
                                                                        <Setter TargetName="tagTaskTitle" Property="TextDecorations" Value="Strikethrough"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="tagDayName" Property="Foreground" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="tagDayNumber" Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= 日程编辑浮层（新建 / 编辑同一个） ================= -->
        <Grid x:Name="EditorLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="EditorScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="EditorScrim_Click"/>
            <Border x:Name="EditorDialog" Width="600" MaxHeight="680"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True"
                    Opacity="0" RenderTransformOrigin="0.5,0.5"
                    KeyDown="Editor_KeyDown">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="EditorScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="EditorShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <DockPanel>
                    <!-- 顶部：标题 + 关闭 -->
                    <Grid DockPanel.Dock="Top" Margin="20,16,14,10">
                        <TextBlock Text="{Binding Editor.Header}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" Content="&#xE711;"
                                FontFamily="{StaticResource IconFont}" FontSize="11"
                                HorizontalAlignment="Right" ToolTip="取消（Esc）"
                                AutomationProperties.Name="关闭"
                                Click="EditorCancel_Click"/>
                    </Grid>

                    <!-- 底部：删除 / 取消 / 保存 -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0" Padding="20,12,16,14">
                        <Grid>
                            <Button Style="{StaticResource GhostButton}" Content="删除"
                                    Foreground="{DynamicResource Danger}" HorizontalAlignment="Left"
                                    Visibility="{Binding Editor.IsEditing, Converter={StaticResource BoolToVisible}}"
                                    Click="EditorDelete_Click"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="取消"
                                        Padding="14,6" Margin="0,0,8,0"
                                        Click="EditorCancel_Click"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="保存"
                                        Click="EditorSave_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 表单 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,0,14,0">
                        <StackPanel Margin="0,0,0,14">

                            <!-- 名称 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="名称" Style="{StaticResource EditorLabel}"/>
                                <TextBox x:Name="EditorTitle" Grid.Column="1" Style="{StaticResource SubtleInput}"
                                         Height="34" VerticalContentAlignment="Center" FontSize="13.5" FontWeight="SemiBold"
                                         Text="{Binding Editor.Title, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- 日期 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="日期" Style="{StaticResource EditorLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" Content="&#xE76B;"
                                            FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                            Padding="7,5" ToolTip="前一天" AutomationProperties.Name="前一天"
                                            Click="EditorPrevDay_Click"/>
                                    <TextBlock Text="{Binding Editor.DateText}" FontSize="13" FontWeight="Medium"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                    <Button Style="{StaticResource GhostButton}" Content="&#xE76C;"
                                            FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                            Padding="7,5" ToolTip="后一天" AutomationProperties.Name="后一天"
                                            Click="EditorNextDay_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- 起止时间 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="时间" Style="{StaticResource EditorLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SubtleInput}" Width="88" Height="34"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         Text="{Binding Editor.StartText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="2" Text="–" Margin="8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiary}"/>
                                <TextBox Grid.Column="3" Style="{StaticResource SubtleInput}" Width="88" Height="34"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         Text="{Binding Editor.EndText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- 冲突提示：边打字边算 -->
                            <TextBlock Text="{Binding Editor.HintText}" Margin="58,6,0,0"
                                       FontSize="12" FontWeight="Medium" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Warning}"
                                       Visibility="{Binding Editor.HintText, Converter={StaticResource EmptyToCollapsed}}"/>
                            <TextBlock Text="{Binding Editor.ErrorText}" Margin="58,6,0,0"
                                       FontSize="12" FontWeight="Medium" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Danger}"
                                       Visibility="{Binding Editor.ErrorText, Converter={StaticResource EmptyToCollapsed}}"/>

                            <!-- 标签（点选 + 当场新建） -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标签" Style="{StaticResource EditorLabel}"/>
                                <StackPanel Grid.Column="1">
                                    <ItemsControl ItemsSource="{Binding Editor.TagPicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TagPickVM}">
                                                <ToggleButton Style="{StaticResource FlagChip}" Margin="0,0,6,5"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding Color}"
                                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Width="156" HorizontalAlignment="Left" Margin="0,1,0,0">
                                        <TextBox x:Name="EditorNewTag" Style="{StaticResource SubtleInput}" Height="30"
                                                 Text="{Binding Editor.NewTagText, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="EditorNewTag_KeyDown" ToolTip="回车新建并勾上"/>
                                        <TextBlock Text="+ 新标签" IsHitTestVisible="False" FontSize="12" FontWeight="Medium"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Visibility="{Binding Text, ElementName=EditorNewTag, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- 目标（单选，第一枚是无目标） -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="目标" Style="{StaticResource EditorLabel}"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Editor.GoalPicks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GoalPickVM}">
                                            <ToggleButton Style="{StaticResource FlagChip}" Margin="0,0,6,5"
                                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                          Click="EditorGoal_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding Color}"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"
                                                             Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- 重复 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="重复" Style="{StaticResource EditorLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="不重复" Tag="none"
                                                  IsChecked="{Binding Editor.Repeat, Mode=OneWay, Converter={StaticResource TextEquals}, ConverterParameter=none}"
                                                  Click="EditorRepeat_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="每天" Tag="每天"
                                                  IsChecked="{Binding Editor.Repeat, Mode=OneWay, Converter={StaticResource TextEquals}, ConverterParameter=每天}"
                                                  Click="EditorRepeat_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="每周" Tag="每周"
                                                  IsChecked="{Binding Editor.Repeat, Mode=OneWay, Converter={StaticResource TextEquals}, ConverterParameter=每周}"
                                                  Click="EditorRepeat_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="每月" Tag="每月"
                                                  IsChecked="{Binding Editor.Repeat, Mode=OneWay, Converter={StaticResource TextEquals}, ConverterParameter=每月}"
                                                  Click="EditorRepeat_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- 提醒 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="提醒" Style="{StaticResource EditorLabel}"/>
                                <WrapPanel Grid.Column="1">
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="不提醒" Tag="none" Margin="0,0,6,4"
                                                  AutomationProperties.Name="不提醒"
                                                  IsChecked="{Binding Editor.IsRemindNone, Mode=OneWay}"
                                                  Click="EditorRemind_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="提前15分" Tag="pre15" Margin="0,0,6,4"
                                                  AutomationProperties.Name="提前15分"
                                                  IsChecked="{Binding Editor.IsRemindPre15, Mode=OneWay}"
                                                  Click="EditorRemind_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="提前5分" Tag="pre5" Margin="0,0,6,4"
                                                  AutomationProperties.Name="提前5分"
                                                  IsChecked="{Binding Editor.IsRemindPre5, Mode=OneWay}"
                                                  Click="EditorRemind_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="开始时" Tag="start" Margin="0,0,6,4"
                                                  AutomationProperties.Name="开始时"
                                                  IsChecked="{Binding Editor.IsRemindStart, Mode=OneWay}"
                                                  Click="EditorRemind_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="结束时" Tag="end" Margin="0,0,6,4"
                                                  AutomationProperties.Name="结束时"
                                                  IsChecked="{Binding Editor.IsRemindEnd, Mode=OneWay}"
                                                  Click="EditorRemind_Click"/>
                                </WrapPanel>
                            </Grid>

                            <!-- 紧急 / 重要 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标记" Style="{StaticResource EditorLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="紧急"
                                                  IsChecked="{Binding Editor.IsUrgent, Mode=TwoWay}"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="重要"
                                                  IsChecked="{Binding Editor.IsImportant, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 备注 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="备注" Style="{StaticResource EditorLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SubtleInput}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="62" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding Editor.Note, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= 设置浮层 ================= -->
        <Grid x:Name="SettingsLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="SettingsScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="SettingsScrim_Click"/>
            <Border x:Name="SettingsDialog" Width="484" MaxHeight="620"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SettingsScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="SettingsShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,16,14,12">
                        <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" Content="&#xE711;"
                                FontFamily="{StaticResource IconFont}" FontSize="11"
                                HorizontalAlignment="Right" ToolTip="关闭（Esc）"
                                AutomationProperties.Name="关闭"
                                AutomationProperties.AutomationId="SettingsCloseButton"
                                Click="SettingsClose_Click"/>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0" Padding="20,10,16,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Style="{StaticResource GhostButton}" Content="打开数据目录"
                                        Padding="10,5" Margin="0,0,6,0"
                                        AutomationProperties.Name="打开数据目录"
                                        Click="OpenDataFolder_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="发送测试通知"
                                        Padding="10,5"
                                        AutomationProperties.Name="发送测试通知"
                                        Click="TestNotify_Click"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextDisabled}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,4,20,18">
                        <StackPanel>
                            <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="开机静默自启" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="登录 Windows 时自动启动并隐藏到系统托盘"
                                                   Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="开机静默自启"
                                                  AutomationProperties.AutomationId="AutoStartToggle"/>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="关闭窗口时最小化到托盘" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="点右上角关闭后常驻后台，从托盘右键可彻底退出"
                                                   Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                                  AutomationProperties.Name="关闭窗口时最小化到托盘"
                                                  AutomationProperties.AutomationId="CloseToTrayToggle"/>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="系统通知推送" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="按日程配置的节点推送 Windows 通知，支持在通知上直接标为完成或延后 5/10 分钟"
                                                   Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding NotifyEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="系统通知推送"
                                                  AutomationProperties.AutomationId="NotifyEnabledToggle"/>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="每日待办摘要" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="启动或从睡眠唤醒时推送一次今日待办与逾期统计（当日不重复打扰）"
                                                   Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding DailyDigestEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="每日待办摘要"
                                                  AutomationProperties.AutomationId="DailyDigestToggle"/>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="新建日程默认提醒" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="在时间轴拖出日程或新增快捷卡片时默认勾选的提醒节点"
                                               Style="{StaticResource Caption}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                    <WrapPanel>
                                        <ToggleButton Style="{StaticResource FlagChip}" Content="不提醒" Tag="none" Margin="0,0,6,4"
                                                      AutomationProperties.Name="默认不提醒"
                                                      IsChecked="{Binding IsDefaultRemindNone, Mode=OneWay}"
                                                      Click="SettingsDefaultRemind_Click"/>
                                        <ToggleButton Style="{StaticResource FlagChip}" Content="提前15分" Tag="pre15" Margin="0,0,6,4"
                                                      AutomationProperties.Name="默认提前15分"
                                                      IsChecked="{Binding IsDefaultRemindPre15, Mode=OneWay}"
                                                      Click="SettingsDefaultRemind_Click"/>
                                        <ToggleButton Style="{StaticResource FlagChip}" Content="提前5分" Tag="pre5" Margin="0,0,6,4"
                                                      AutomationProperties.Name="默认提前5分"
                                                      IsChecked="{Binding IsDefaultRemindPre5, Mode=OneWay}"
                                                      Click="SettingsDefaultRemind_Click"/>
                                        <ToggleButton Style="{StaticResource FlagChip}" Content="开始时" Tag="start" Margin="0,0,6,4"
                                                      AutomationProperties.Name="默认开始时"
                                                      IsChecked="{Binding IsDefaultRemindStart, Mode=OneWay}"
                                                      Click="SettingsDefaultRemind_Click"/>
                                        <ToggleButton Style="{StaticResource FlagChip}" Content="结束时" Tag="end" Margin="0,0,6,4"
                                                      AutomationProperties.Name="默认结束时"
                                                      IsChecked="{Binding IsDefaultRemindEnd, Mode=OneWay}"
                                                      Click="SettingsDefaultRemind_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= 快捷卡片管理浮层 ================= -->
        <Grid x:Name="PresetManagerLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="PresetManagerScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="PresetManagerScrim_Click"/>
            <Border x:Name="PresetManagerDialog" Width="560" MaxHeight="660"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True"
                    Opacity="0" RenderTransformOrigin="0.5,0.5"
                    KeyDown="PresetManager_KeyDown">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PresetManagerScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="PresetManagerShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,16,14,10">
                        <TextBlock Text="管理快捷日程卡片" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" Content="&#xE711;"
                                FontFamily="{StaticResource IconFont}" FontSize="11"
                                HorizontalAlignment="Right" ToolTip="关闭（Esc）"
                                AutomationProperties.Name="关闭"
                                AutomationProperties.AutomationId="PresetManagerCloseButton"
                                Click="PresetManagerClose_Click"/>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0" Padding="20,10,16,12">
                        <Grid>
                            <TextBlock Text="拖到时间轴格子即可直接创建日程" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource GhostButton}" Content="完成"
                                    Padding="14,6" HorizontalAlignment="Right"
                                    AutomationProperties.Name="完成"
                                    Click="PresetManagerClose_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,0,14,0">
                        <StackPanel Margin="0,0,0,16">

                            <!-- 新增 / 编辑预设卡片表单 -->
                            <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="{Binding PresetManager.FormHeader}"
                                                   FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource GhostButton}" Content="取消编辑"
                                                Padding="8,3" FontSize="11.5" HorizontalAlignment="Right"
                                                Visibility="{Binding PresetManager.IsEditing, Converter={StaticResource BoolToVisible}}"
                                                Click="PresetCancelEdit_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="名称" Style="{StaticResource EditorLabel}"/>
                                        <TextBox x:Name="PresetTitleBox" Grid.Column="1" Style="{StaticResource SubtleInput}"
                                                 Height="32" VerticalContentAlignment="Center"
                                                 FontSize="13" FontWeight="SemiBold"
                                                 AutomationProperties.Name="快捷卡片名称"
                                                 AutomationProperties.AutomationId="PresetTitleBox"
                                                 Text="{Binding PresetManager.Title, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="时长" Style="{StaticResource EditorLabel}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="PresetDurationBox" Style="{StaticResource SubtleInput}"
                                                     Width="68" Height="32"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="快捷卡片时长"
                                                     AutomationProperties.AutomationId="PresetDurationBox"
                                                     Text="{Binding PresetManager.DurationText, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="分钟" Style="{StaticResource Caption}"
                                                       Margin="6,0,10,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding PresetManager.DurationQuickPicks}"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource GhostButton}"
                                                            Padding="7,3" Margin="0,0,4,0" FontSize="11.5"
                                                            Content="{Binding}"
                                                            ContentStringFormat="{}{0}分"
                                                            Tag="{Binding}"
                                                            Click="PresetDurationChip_Click"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="标签" Style="{StaticResource EditorLabel}"/>
                                        <StackPanel Grid.Column="1">
                                            <ItemsControl ItemsSource="{Binding PresetManager.TagPicks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:TagPickVM}">
                                                        <ToggleButton Style="{StaticResource FlagChip}" Margin="0,0,6,5"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Fill="{Binding Color}"
                                                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Width="140" HorizontalAlignment="Left" Margin="0,1,0,0">
                                                <TextBox x:Name="PresetNewTag" Style="{StaticResource SubtleInput}" Height="28"
                                                         Text="{Binding PresetManager.NewTagText, UpdateSourceTrigger=PropertyChanged}"
                                                         KeyDown="PresetNewTag_KeyDown" ToolTip="回车新建并勾上"/>
                                                <TextBlock Text="+ 新标签" IsHitTestVisible="False" FontSize="11.5" FontWeight="Medium"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiary}"
                                                           Visibility="{Binding Text, ElementName=PresetNewTag, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="目标" Style="{StaticResource EditorLabel}"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding PresetManager.GoalPicks}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:GoalPickVM}">
                                                    <ToggleButton Style="{StaticResource FlagChip}" Margin="0,0,6,5"
                                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                  Click="PresetGoal_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Fill="{Binding Color}"
                                                                     VerticalAlignment="Center" Margin="0,0,5,0"
                                                                     Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}"/>
                                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Medium"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="提醒" Style="{StaticResource EditorLabel}"/>
                                        <WrapPanel Grid.Column="1">
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="不提醒" Tag="none" Margin="0,0,6,4"
                                                          AutomationProperties.Name="预设不提醒"
                                                          IsChecked="{Binding PresetManager.IsRemindNone, Mode=OneWay}"
                                                          Click="PresetRemind_Click"/>
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="提前15分" Tag="pre15" Margin="0,0,6,4"
                                                          AutomationProperties.Name="预设提前15分"
                                                          IsChecked="{Binding PresetManager.IsRemindPre15, Mode=OneWay}"
                                                          Click="PresetRemind_Click"/>
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="提前5分" Tag="pre5" Margin="0,0,6,4"
                                                          AutomationProperties.Name="预设提前5分"
                                                          IsChecked="{Binding PresetManager.IsRemindPre5, Mode=OneWay}"
                                                          Click="PresetRemind_Click"/>
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="开始时" Tag="start" Margin="0,0,6,4"
                                                          AutomationProperties.Name="预设开始时"
                                                          IsChecked="{Binding PresetManager.IsRemindStart, Mode=OneWay}"
                                                          Click="PresetRemind_Click"/>
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="结束时" Tag="end" Margin="0,0,6,4"
                                                          AutomationProperties.Name="预设结束时"
                                                          IsChecked="{Binding PresetManager.IsRemindEnd, Mode=OneWay}"
                                                          Click="PresetRemind_Click"/>
                                        </WrapPanel>
                                    </Grid>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="标记" Style="{StaticResource EditorLabel}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="紧急"
                                                          IsChecked="{Binding PresetManager.IsUrgent, Mode=TwoWay}"/>
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="重要"
                                                          IsChecked="{Binding PresetManager.IsImportant, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                                Padding="14,6" FontSize="12.5"
                                                Content="{Binding PresetManager.SubmitText}"
                                                AutomationProperties.Name="{Binding PresetManager.SubmitText}"
                                                AutomationProperties.AutomationId="SavePresetButton"
                                                Click="PresetSave_Click"/>
                                    </Grid>

                                    <TextBlock Text="{Binding PresetManager.ErrorText}" Margin="52,6,0,0"
                                               FontSize="12" FontWeight="Medium" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Danger}"
                                               Visibility="{Binding PresetManager.ErrorText, Converter={StaticResource EmptyToCollapsed}}"/>
                                </StackPanel>
                            </Border>

                            <!-- 已有快捷卡片列表 -->
                            <TextBlock Text="已有快捷卡片" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SchedulePresetVM}">
                                        <Border Background="{DynamicResource Surface3}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding DotBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Visibility="{Binding HasDot, Converter={StaticResource BoolToVisible}}"/>
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontSize="13.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <Grid Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="&#xEA8F;"
                                                                   FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                   VerticalAlignment="Center" Margin="0,0,5,0"
                                                                   ToolTip="{Binding RemindTooltip}"
                                                                   Visibility="{Binding HasRemind, Converter={StaticResource BoolToVisible}}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SummaryText}"
                                                                   Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GhostButton}" Content="编辑"
                                                            Padding="9,4" Margin="0,0,4,0"
                                                            Tag="{Binding}" Click="PresetEdit_Click"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="删除"
                                                            Padding="9,4" Foreground="{DynamicResource Danger}"
                                                            Tag="{Binding}" Click="PresetDelete_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="还没有快捷卡片，在上方填个名称和时长就可以添加"
                                       Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,10,0,4"
                                       Visibility="{Binding Presets.Count, Converter={StaticResource ZeroToVisible}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 操作反馈胶囊提示 -->
        <Border x:Name="ToastPill" Grid.RowSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28" Padding="14,7" CornerRadius="16"
                Background="{DynamicResource Surface4}"
                BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="8"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.18"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ToastDot" Width="6" Height="6" Fill="{DynamicResource Accent}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="ToastText" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 拖拽幽灵层 -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>
