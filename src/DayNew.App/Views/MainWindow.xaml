                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding AutoSyncEnabled, Mode=TwoWay}"
                                                      AutomationProperties.Name="开启多设备自动同步"
                                                      AutomationProperties.AutomationId="AutoSyncToggle"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="测试连接"
                                                Background="{DynamicResource Surface2}"
