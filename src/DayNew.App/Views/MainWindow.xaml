                                                      AutomationProperties.AutomationId="FocusKeepMiniToggle"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="专注开始与结束提示音" FontSize="12.5" FontWeight="Medium"/>
