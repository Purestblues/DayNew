                                                IsEnabled="{Binding IsWebDavIdle}"
                                                AutomationProperties.Name="测试连接"
                                                AutomationProperties.AutomationId="WebDavTestButton"
                                                Click="WebDavTest_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="上传备份"
                                                Background="{DynamicResource Surface2}"
                                                Padding="10,5" Margin="0,0,6,0"
                                                IsEnabled="{Binding IsWebDavIdle}"
                                                AutomationProperties.Name="上传备份"
                                                AutomationProperties.AutomationId="WebDavUploadButton"
                                                Click="WebDavUpload_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="从云端恢复"
                                                Background="{DynamicResource Surface2}"
                                                Padding="10,5" Margin="0,0,6,0"
