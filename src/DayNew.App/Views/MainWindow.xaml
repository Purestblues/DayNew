                                                AutomationProperties.AutomationId="McpApplyPortButton"
                                                Click="McpApplyPort_Click"/>
                                        <TextBlock Grid.Column="3" Text="{Binding McpEndpointText}"
                                                   Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding McpEndpointText}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="密钥" Style="{StaticResource EditorLabel}" Margin="0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource SubtleInput}"
                                                 Background="{DynamicResource Surface2}"
                                                 Height="30" VerticalContentAlignment="Center"
                                                 IsReadOnly="True"
                                                 AutomationProperties.Name="MCP Bearer Token"
                                                 AutomationProperties.AutomationId="McpTokenBox"
                                                 Text="{Binding McpTokenDisplayText, Mode=OneWay}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Button Style="{StaticResource GhostButton}"
                                                    Content="{Binding McpTokenRevealButtonText}"
                                                    Background="{DynamicResource Surface2}"
                                                    Padding="8,5" Margin="0,0,4,0"
                                                    AutomationProperties.Name="显示或隐藏 MCP 密钥"
                                                    AutomationProperties.AutomationId="McpToggleRevealButton"
                                                    Click="McpToggleReveal_Click"/>
                                            <Button Style="{StaticResource GhostButton}" Content="复制"
                                                    Background="{DynamicResource Surface2}"
                                                    Padding="8,5" Margin="0,0,4,0"
                                                    AutomationProperties.Name="复制 MCP 密钥"
                                                    AutomationProperties.AutomationId="McpCopyTokenButton"
                                                    Click="McpCopyToken_Click"/>
                                            <Button Style="{StaticResource GhostButton}" Content="重置"
                                                    Background="{DynamicResource Surface2}"
                                                    Padding="8,5"
                                                    AutomationProperties.Name="重置 MCP 密钥"
                                                    AutomationProperties.AutomationId="McpRegenerateTokenButton"
                                                    Click="McpRegenerateToken_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="复制 JSON 配置"
                                                Background="{DynamicResource Surface2}"
                                                Padding="10,5" Margin="0,0,6,0"
                                                AutomationProperties.Name="复制 MCP JSON 配置"
                                                AutomationProperties.AutomationId="McpCopyJsonButton"
                                                Click="McpCopyJson_Click"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="复制安装提示词"
                                                Padding="12,5" FontSize="12"
                                                AutomationProperties.Name="复制 MCP 安装提示词"
                                                AutomationProperties.AutomationId="McpCopyPromptButton"
                                                Click="McpCopyPrompt_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="SearchBodyTemplate" TargetType="ContentControl">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center" Margin="2,0,10,0"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchInputBox"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="15" FontWeight="Medium"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource Accent}"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="全局搜索输入框"
                                     AutomationProperties.AutomationId="SearchInputBox"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="SearchInputBox_PreviewKeyDown"/>
                            <TextBlock Text="搜索日程、目标、标签、人物或地点（支持空格多关键词）…"
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       FontSize="14" Foreground="{DynamicResource TextDisabled}"
                                       Visibility="{Binding Text, ElementName=SearchInputBox, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                        </Grid>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Esc"
                                FontSize="11" Padding="8,4" Foreground="{DynamicResource TextTertiary}"
                                AutomationProperties.Name="关闭搜索"
                                Click="SearchClose_Click"/>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="0,1,0,0" Padding="16,8">
                    <Grid>
                        <TextBlock Text="↑ ↓ 选择 · Enter 打开详情或编辑 · Esc 关闭"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SearchResults.Count, StringFormat={}{0} 条结果}"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                </Border>

                <Grid MaxHeight="380" MinHeight="180">
                    <ScrollViewer x:Name="SearchResultsScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="8,6">
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SearchItemVM}">
                                    <Border x:Name="searchRow" CornerRadius="8" Padding="12,9" Margin="0,1"
                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonUp="SearchItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource Surface3}"
                                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="{Binding KindBadge}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </Border>
                                            <Ellipse Grid.Column="1" Width="7" Height="7"
                                                     Fill="{Binding AccentBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                     Visibility="{Binding HasAccent, Converter={StaticResource BoolToVisible}}"/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock x:Name="rowTitle" Text="{Binding Title}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource EmptyToCollapsed}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="&#xE76C;"
                                                       FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Foreground="{DynamicResource TextDisabled}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="searchRow" Property="Background" Value="{DynamicResource AccentTint}"/>
                                            <Setter TargetName="searchRow" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter TargetName="rowTitle" Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter TargetName="rowTitle" Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding SearchEmptyHint}" Style="{StaticResource Caption}"
                               FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"/>
                </Grid>
            </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="PresetManagerBodyTemplate" TargetType="ContentControl">
            <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,16,14,10">
                        <TextBlock Text="管理快捷日程卡片" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" Content="&#xE711;"
                                FontFamily="{StaticResource IconFont}" FontSize="11"
                                HorizontalAlignment="Right" ToolTip="关闭（Esc）"
                                AutomationProperties.Name="关闭"
                                AutomationProperties.AutomationId="PresetManagerCloseButton"
                                Click="PresetManagerClose_Click"/>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0" Padding="20,10,16,12">
                        <Grid>
                            <TextBlock Text="拖到时间轴格子即可直接创建日程" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource GhostButton}" Content="完成"
                                    Padding="14,6" HorizontalAlignment="Right"
                                    AutomationProperties.Name="完成"
                                    Click="PresetManagerClose_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,0,14,0">
                        <StackPanel Margin="0,0,0,16">

                            <!-- 新增 / 编辑预设卡片表单 -->
                            <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="{Binding PresetManager.FormHeader}"
                                                   FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource GhostButton}" Content="取消编辑"
                                                Padding="8,3" FontSize="11.5" HorizontalAlignment="Right"
                                                Visibility="{Binding PresetManager.IsEditing, Converter={StaticResource BoolToVisible}}"
                                                Click="PresetCancelEdit_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="名称" Style="{StaticResource EditorLabel}"/>
                                        <TextBox x:Name="PresetTitleBox" Grid.Column="1" Style="{StaticResource SubtleInput}"
                                                 Height="32" VerticalContentAlignment="Center"
                                                 FontSize="13" FontWeight="SemiBold"
                                                 AutomationProperties.Name="快捷卡片名称"
                                                 AutomationProperties.AutomationId="PresetTitleBox"
                                                 Text="{Binding PresetManager.Title, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="时长" Style="{StaticResource EditorLabel}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="PresetDurationBox" Style="{StaticResource SubtleInput}"
                                                     Width="68" Height="32"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="快捷卡片时长"
                                                     AutomationProperties.AutomationId="PresetDurationBox"
                                                     Text="{Binding PresetManager.DurationText, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="分钟" Style="{StaticResource Caption}"
                                                       Margin="6,0,10,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding PresetManager.DurationQuickPicks}"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource GhostButton}"
                                                            Padding="7,3" Margin="0,0,4,0" FontSize="11.5"
                                                            Content="{Binding}"
                                                            ContentStringFormat="{}{0}分"
                                                            Tag="{Binding}"
                                                            Click="PresetDurationChip_Click"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="标签" Style="{StaticResource EditorLabel}"/>
                                        <StackPanel Grid.Column="1">
                                            <ItemsControl ItemsSource="{Binding PresetManager.TagPicks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:TagPickVM}">
                                                        <ToggleButton Style="{StaticResource FlagChip}" Margin="0,0,6,5"
                                                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisible}}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Fill="{Binding Color}"
                                                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Width="140" HorizontalAlignment="Left" Margin="0,1,0,0">
                                                <TextBox x:Name="PresetNewTag" Style="{StaticResource SubtleInput}" Height="28"
                                                         Text="{Binding PresetManager.NewTagText, UpdateSourceTrigger=PropertyChanged}"
                                                         KeyDown="PresetNewTag_KeyDown" ToolTip="输入可筛选，回车新建并勾上"/>
                                                <TextBlock Text="+ 新标签" IsHitTestVisible="False" FontSize="11.5" FontWeight="Medium"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiary}"
                                                           Visibility="{Binding Text, ElementName=PresetNewTag, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="人物" Style="{StaticResource EditorLabel}"/>
                                        <StackPanel Grid.Column="1">
                                            <ItemsControl ItemsSource="{Binding PresetManager.PersonPicks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:PersonPickVM}">
                                                        <ToggleButton Style="{StaticResource FlagChip}" Margin="0,0,6,5"
                                                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisible}}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Width="140" HorizontalAlignment="Left" Margin="0,1,0,0">
                                                <TextBox x:Name="PresetNewPerson" Style="{StaticResource SubtleInput}" Height="28"
                                                         Text="{Binding PresetManager.NewPersonText, UpdateSourceTrigger=PropertyChanged}"
                                                         KeyDown="PresetNewPerson_KeyDown" ToolTip="输入可筛选，回车新建并勾上"/>
                                                <TextBlock Text="+ 新人物" IsHitTestVisible="False" FontSize="11.5" FontWeight="Medium"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiary}"
                                                           Visibility="{Binding Text, ElementName=PresetNewPerson, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="地点" Style="{StaticResource EditorLabel}"/>
                                        <StackPanel Grid.Column="1">
                                            <ItemsControl ItemsSource="{Binding PresetManager.LocationPicks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:LocationPickVM}">
                                                        <ToggleButton Style="{StaticResource FlagChip}" Margin="0,0,6,5"
                                                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisible}}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Width="140" HorizontalAlignment="Left" Margin="0,1,0,0">
                                                <TextBox x:Name="PresetNewLocation" Style="{StaticResource SubtleInput}" Height="28"
                                                         Text="{Binding PresetManager.NewLocationText, UpdateSourceTrigger=PropertyChanged}"
                                                         KeyDown="PresetNewLocation_KeyDown" ToolTip="输入可筛选，回车新建并勾上"/>
                                                <TextBlock Text="+ 新地点" IsHitTestVisible="False" FontSize="11.5" FontWeight="Medium"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiary}"
                                                           Visibility="{Binding Text, ElementName=PresetNewLocation, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="目标" Style="{StaticResource EditorLabel}"/>
                                        <StackPanel Grid.Column="1">
                                            <ItemsControl ItemsSource="{Binding PresetManager.GoalPicks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:GoalPickVM}">
                                                        <ToggleButton Style="{StaticResource FlagChip}" Margin="0,0,6,5"
                                                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                      Click="PresetGoal_Click">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Fill="{Binding Color}"
                                                                         VerticalAlignment="Center" Margin="0,0,5,0"
                                                                         Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}"/>
                                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Medium"
                                                                           VerticalAlignment="Center"/>
                                                                <Border Background="{DynamicResource Surface2}" CornerRadius="3"
                                                                        Padding="4,0" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisible}}">
                                                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource Accent}"
                                                                               Typography.NumeralAlignment="Tabular"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding PresetManager.SelectedGoalChips}"
                                                          ItemTemplate="{StaticResource CompactGoalChipTemplate}"
                                                          Margin="0,2,0,0"
                                                          Visibility="{Binding PresetManager.HasSelectedGoals, Converter={StaticResource BoolToVisible}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="提醒" Style="{StaticResource EditorLabel}"/>
                                        <WrapPanel Grid.Column="1">
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="不提醒" Tag="none" Margin="0,0,6,4"
                                                          AutomationProperties.Name="预设不提醒"
                                                          IsChecked="{Binding PresetManager.IsRemindNone, Mode=OneWay}"
                                                          Click="PresetRemind_Click"/>
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="提前15分" Tag="pre15" Margin="0,0,6,4"
                                                          AutomationProperties.Name="预设提前15分"
                                                          IsChecked="{Binding PresetManager.IsRemindPre15, Mode=OneWay}"
                                                          Click="PresetRemind_Click"/>
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="提前5分" Tag="pre5" Margin="0,0,6,4"
                                                          AutomationProperties.Name="预设提前5分"
                                                          IsChecked="{Binding PresetManager.IsRemindPre5, Mode=OneWay}"
                                                          Click="PresetRemind_Click"/>
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="开始时" Tag="start" Margin="0,0,6,4"
                                                          AutomationProperties.Name="预设开始时"
                                                          IsChecked="{Binding PresetManager.IsRemindStart, Mode=OneWay}"
                                                          Click="PresetRemind_Click"/>
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="结束时" Tag="end" Margin="0,0,6,4"
                                                          AutomationProperties.Name="预设结束时"
                                                          IsChecked="{Binding PresetManager.IsRemindEnd, Mode=OneWay}"
                                                          Click="PresetRemind_Click"/>
                                        </WrapPanel>
                                    </Grid>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="标记" Style="{StaticResource EditorLabel}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="紧急"
                                                          IsChecked="{Binding PresetManager.IsUrgent, Mode=TwoWay}"/>
                                            <ToggleButton Style="{StaticResource FlagChip}" Content="重要"
                                                          IsChecked="{Binding PresetManager.IsImportant, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                                Padding="14,6" FontSize="12.5"
                                                Content="{Binding PresetManager.SubmitText}"
                                                AutomationProperties.Name="{Binding PresetManager.SubmitText}"
                                                AutomationProperties.AutomationId="SavePresetButton"
                                                Click="PresetSave_Click"/>
                                    </Grid>

                                    <TextBlock Text="{Binding PresetManager.ErrorText}" Margin="52,6,0,0"
                                               FontSize="12" FontWeight="Medium" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Danger}"
                                               Visibility="{Binding PresetManager.ErrorText, Converter={StaticResource EmptyToCollapsed}}"/>
                                </StackPanel>
                            </Border>

                            <!-- 已有快捷卡片列表 -->
                            <TextBlock Text="已有快捷卡片" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SchedulePresetVM}">
                                        <Border Background="{DynamicResource Surface3}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding DotBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Visibility="{Binding HasDot, Converter={StaticResource BoolToVisible}}"/>
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontSize="13.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <Grid Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="&#xEA8F;"
                                                                   FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                   VerticalAlignment="Center" Margin="0,0,5,0"
                                                                   ToolTip="{Binding RemindTooltip}"
                                                                   Visibility="{Binding HasRemind, Converter={StaticResource BoolToVisible}}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SummaryText}"
                                                                   Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GhostButton}" Content="编辑"
                                                            Padding="9,4" Margin="0,0,4,0"
                                                            Tag="{Binding}" Click="PresetEdit_Click"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="删除"
                                                            Padding="9,4" Foreground="{DynamicResource Danger}"
                                                            Tag="{Binding}" Click="PresetDelete_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="还没有快捷卡片，在上方填个名称和时长就可以添加"
                                       Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,10,0,4"
                                       Visibility="{Binding Presets.Count, Converter={StaticResource ZeroToVisible}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="GoalTreeEditorBodyTemplate" TargetType="ContentControl">
            <DockPanel>
                    <!-- 顶部 -->
                    <Border DockPanel.Dock="Top" Padding="20,14,14,10"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{Binding GoalTreeEditor.Goal.Color}"
                                         VerticalAlignment="Center" Margin="0,1,9,0"/>
                                <TextBlock Text="{Binding GoalTreeEditor.HeaderTitle}"
                                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Content="&#xE711;"
                                    FontFamily="{StaticResource IconFont}" FontSize="11"
                                    HorizontalAlignment="Right" ToolTip="关闭（Esc）"
                                    AutomationProperties.Name="关闭目标树编辑器"
                                    Click="GoalTreeEditorClose_Click"/>
                        </Grid>
                    </Border>

                    <!-- 工具栏 -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface3}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <StackPanel>
                            <!-- 第一行：当前选中节点名 + 截止日期 + 新建子目标 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="当前节点" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TreeEditorNodeTitleBox" Style="{StaticResource SubtleInput}"
                                             Width="148" Height="30" VerticalContentAlignment="Center"
                                             FontSize="12.5" FontWeight="SemiBold"
                                             IsEnabled="{Binding GoalTreeEditor.CanEditSelected}"
                                             Text="{Binding GoalTreeEditor.SelectedNodeTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderSubtle}"
                                            BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GoalTreeEditor.SelectedKindHint}"
                                                   FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextTertiary}"/>
                                    </Border>

                                    <Border Width="1" Height="16" Background="{DynamicResource BorderSubtle}" Margin="10,0"/>

                                    <Button Style="{StaticResource GhostButton}"
                                            Padding="8,5" VerticalAlignment="Center"
                                            IsEnabled="{Binding GoalTreeEditor.CanEditSelected}"
                                            ToolTip="为当前选中目标设置可选截止日期"
                                            Click="TreeEditorDeadline_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Text="&#xE787;" VerticalAlignment="Center" Margin="0,0,5,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GoalTreeEditor.SelectedNodeHasDue}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GoalTreeEditor.SelectedNodeDueIsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding GoalTreeEditor.SelectedNodeDueText}"
                                                       FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GoalTreeEditor.SelectedNodeHasDue}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GoalTreeEditor.SelectedNodeDueIsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                            Padding="5,5" VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextTertiary}"
                                            ToolTip="清除当前节点截止日期"
                                            Visibility="{Binding GoalTreeEditor.SelectedNodeHasDue, Converter={StaticResource BoolToVisible}}"
                                            Click="TreeEditorClearDeadline_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" Content="+ 归属子目标"
                                            Padding="9,5" Margin="0,0,4,0"
                                            ToolTip="在当前节点下新增归属关系子目标（实线），创建后可在卡片上直接输入名称"
                                            Click="TreeEditorAddBelong_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="+ 并列子目标"
                                            Padding="9,5" Margin="0,0,4,0"
                                            IsEnabled="{Binding GoalTreeEditor.CanAddSibling}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="{Binding GoalTreeEditor.SiblingButtonToolTip}"
                                            Click="TreeEditorAddSibling_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="+ 递进子目标"
                                            Padding="9,5"
                                            ToolTip="在当前节点后新增递进步骤子目标（虚线箭头），创建后可在卡片上直接输入名称"
                                            Click="TreeEditorAddProgress_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- 第二行：快捷连线 / 自动排版 / 删除节点 / 缩放 -->
                            <Grid Margin="0,7,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="连线(归属)"
                                                  Padding="8,4" Margin="0,0,4,0"
                                                  IsChecked="{Binding GoalTreeEditor.IsLinkingBelong, Mode=OneWay}"
                                                  ToolTip="点击后点选另一个子目标建立归属连线（也可直接从卡片四边圆点拖出连线）"
                                                  Click="TreeEditorLinkBelong_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="连线(递进)"
                                                  Padding="8,4" Margin="0,0,8,0"
                                                  IsChecked="{Binding GoalTreeEditor.IsLinkingProgress, Mode=OneWay}"
                                                  ToolTip="点击后点选另一个子目标建立递进连线（也可直接从卡片四边圆点拖出连线）"
                                                  Click="TreeEditorLinkProgress_Click"/>

                                    <Border Width="1" Height="15" Background="{DynamicResource BorderSubtle}" Margin="0,0,8,0"/>

                                    <Button Style="{StaticResource GhostButton}" Content="自动排版"
                                            Padding="8,4" Margin="0,0,4,0"
                                            ToolTip="按层级重新排列所有卡片位置"
                                            Click="TreeEditorAutoLayout_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="删除节点"
                                            Padding="8,4"
                                            Foreground="{DynamicResource Danger}"
                                            IsEnabled="{Binding GoalTreeEditor.CanDeleteSelected}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="{Binding GoalTreeEditor.DeleteButtonToolTip}"
                                            Click="TreeEditorDeleteNode_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GoalTreeEditor.ZoomLabel}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                               Typography.NumeralAlignment="Tabular"/>
                                    <Button Style="{StaticResource GhostButton}" Content="重置视图"
                                            Padding="7,3" FontSize="11"
                                            Click="TreeEditorResetView_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="treeEditorHintText" Text="{Binding GoalTreeEditor.LinkHint}"
                                       Margin="0,6,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GoalTreeEditor.IsDragConnecting}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GoalTreeEditor.IsLinking}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 底部 -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0" Padding="20,10,16,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="18" Height="2" Background="{DynamicResource BorderStrong}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="归属/并列" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Border Width="18" Height="2" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="递进(箭头) · 悬停卡片四边拖出连线 · 悬停连线加说明或删除" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryButton}" Content="完成"
                                    Padding="16,6" HorizontalAlignment="Right"
                                    Click="GoalTreeEditorClose_Click"/>
                        </Grid>
                    </Border>

                    <!-- 编辑画布视口 -->
                    <Border x:Name="TreeEditorViewport" Background="{DynamicResource Surface1}"
                            ClipToBounds="True" Cursor="Arrow"
                            PreviewMouseWheel="TreeEditorViewport_PreviewMouseWheel">
                        <Grid>
                            <Canvas x:Name="TreeEditorCanvas"
                                    Width="{Binding GoalTreeEditor.Goal.CanvasWidth}"
                                    Height="{Binding GoalTreeEditor.Goal.CanvasHeight}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding GoalTreeEditor.Zoom}" ScaleY="{Binding GoalTreeEditor.Zoom}"/>
                                        <TranslateTransform X="{Binding GoalTreeEditor.PanX}" Y="{Binding GoalTreeEditor.PanY}"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>

                                <!-- 1. 连线层（含透明宽命中热区 + 实虚线/箭头） -->
                                <ItemsControl ItemsSource="{Binding GoalTreeEditor.Goal.Edges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GoalEdgeVM}">
                                            <Canvas>
                                                <Path x:Name="edHit" Tag="treeedgehit"
                                                      Data="{Binding LineGeometry}"
                                                      Stroke="Transparent" StrokeThickness="16"
                                                      Cursor="Hand"
                                                      MouseEnter="TreeEdgeHit_MouseEnter"
                                                      MouseLeave="TreeEdgeHit_MouseLeave"/>
                                                <Path x:Name="edLine" Data="{Binding LineGeometry}"
                                                      Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.7"
                                                      IsHitTestVisible="False"/>
                                                <Path x:Name="edArrow" Data="{Binding ArrowGeometry}"
                                                      Fill="{DynamicResource Accent}" Visibility="Collapsed"
                                                      IsHitTestVisible="False"/>
                                            </Canvas>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsProgress}" Value="True">
                                                    <Setter TargetName="edLine" Property="Stroke" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="edLine" Property="StrokeDashArray" Value="4 2"/>
                                                    <Setter TargetName="edArrow" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                                    <Setter TargetName="edLine" Property="Stroke" Value="{DynamicResource AccentHover}"/>
                                                    <Setter TargetName="edLine" Property="StrokeThickness" Value="2.6"/>
                                                    <Setter TargetName="edArrow" Property="Fill" Value="{DynamicResource AccentHover}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 2. 四边拖拽连线实时预览曲线 -->
                                <Canvas IsHitTestVisible="False"
                                        Visibility="{Binding GoalTreeEditor.IsDragConnecting, Converter={StaticResource BoolToVisible}}">
                                    <Path Data="{Binding GoalTreeEditor.DragConnectGeometry}"
                                          Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashArray="4 2"/>
                                    <Path Data="{Binding GoalTreeEditor.DragConnectArrowGeometry}"
                                          Fill="{DynamicResource Accent}"/>
                                </Canvas>

                                <!-- 3. 节点层（支持自由拖动、就地编辑标题、截止日期展示、draw.io 四边悬停圆点） -->
                                <ItemsControl ItemsSource="{Binding GoalTreeEditor.Goal.AllCanvasNodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GoalNodeVM}">
                                            <Grid Width="{Binding Width}" Height="{Binding Height}" ClipToBounds="False"
                                                  MouseEnter="TreeEditorNode_MouseEnter"
                                                  MouseLeave="TreeEditorNode_MouseLeave">
                                                <!-- 外扩 7px 透明悬停缓冲区：鼠标从卡片边缘移到 4 边圆点时不会断掉悬停 -->
                                                <Border Margin="-7" Background="Transparent"/>

                                                <Border x:Name="editorNodeBox" Tag="treeeditornode"
                                                        Width="{Binding Width}" Height="{Binding Height}"
                                                        Background="{DynamicResource Surface2}"
                                                        BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                                                        CornerRadius="6" Padding="8,5" Cursor="Hand">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Border x:Name="editorNodeTint" Grid.RowSpan="2"
                                                                CornerRadius="5" Margin="-8,-5"
                                                                Background="Transparent" IsHitTestVisible="False"/>

                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse x:Name="edRootDot" Width="6" Height="6" Fill="{Binding Owner.Color}"
                                                                     VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                                            <TextBlock x:Name="edNodeTitle" Grid.Column="1" Text="{Binding DisplayTitle}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                            <Border x:Name="edInlineTitleWrap" Grid.Column="1"
                                                                    Background="{DynamicResource Surface3}"
                                                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                                                    CornerRadius="4" Padding="5,2" Visibility="Collapsed">
                                                                <TextBox x:Name="edInlineTitleBox"
                                                                         Style="{StaticResource TitleEditor}"
                                                                         FontSize="12" FontWeight="SemiBold"
                                                                         VerticalAlignment="Center"
                                                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                                         KeyDown="TreeEditorInlineBox_KeyDown"
                                                                         LostFocus="TreeEditorInlineBox_LostFocus"
                                                                         IsVisibleChanged="TreeEditorInlineBox_IsVisibleChanged"/>
                                                            </Border>
                                                        </Grid>

                                                        <StackPanel x:Name="edDueRow" Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0"
                                                                    Visibility="{Binding HasDue, Converter={StaticResource BoolToVisible}}">
                                                            <TextBlock x:Name="edDueIcon" Text="&#xE787;"
                                                                       FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                                       Foreground="{DynamicResource TextTertiary}"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock x:Name="edDueText" Text="{Binding DueBadgeText}"
                                                                       FontSize="10" FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextTertiary}"
                                                                       VerticalAlignment="Center"
                                                                       Typography.NumeralAlignment="Tabular"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- 四条边中点连线锚点（draw.io 风格：悬停节点或拖近目标时浮现） -->
                                                <Border x:Name="portTop" Tag="nodeport" Uid="Top"
                                                        Width="14" Height="14" Background="Transparent" Cursor="Cross"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-7,0,0"
                                                        Visibility="Collapsed" ToolTip="按住拖向其它目标或空白处连线">
                                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Surface4}"
                                                             Stroke="{DynamicResource Accent}" StrokeThickness="1.8"/>
                                                </Border>
                                                <Border x:Name="portRight" Tag="nodeport" Uid="Right"
                                                        Width="14" Height="14" Background="Transparent" Cursor="Cross"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-7,0"
                                                        Visibility="Collapsed" ToolTip="按住拖向其它目标或空白处连线">
                                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Surface4}"
                                                             Stroke="{DynamicResource Accent}" StrokeThickness="1.8"/>
                                                </Border>
                                                <Border x:Name="portBottom" Tag="nodeport" Uid="Bottom"
                                                        Width="14" Height="14" Background="Transparent" Cursor="Cross"
                                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-7"
                                                        Visibility="Collapsed" ToolTip="按住拖向其它目标或空白处连线">
                                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Surface4}"
                                                             Stroke="{DynamicResource Accent}" StrokeThickness="1.8"/>
                                                </Border>
                                                <Border x:Name="portLeft" Tag="nodeport" Uid="Left"
                                                        Width="14" Height="14" Background="Transparent" Cursor="Cross"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-7,0,0,0"
                                                        Visibility="Collapsed" ToolTip="按住拖向其它目标或空白处连线">
                                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Surface4}"
                                                             Stroke="{DynamicResource Accent}" StrokeThickness="1.8"/>
                                                </Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                    <Setter TargetName="edRootDot" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDueOverdue}" Value="True">
                                                    <Setter TargetName="edDueIcon" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    <Setter TargetName="edDueText" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelectedInEditor}" Value="True">
                                                    <Setter TargetName="editorNodeBox" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="editorNodeBox" Property="BorderThickness" Value="1.5"/>
                                                    <Setter TargetName="editorNodeTint" Property="Background" Value="{DynamicResource AccentTint}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLinkSource}" Value="True">
                                                    <Setter TargetName="editorNodeBox" Property="BorderBrush" Value="{DynamicResource Warning}"/>
                                                    <Setter TargetName="editorNodeTint" Property="Background" Value="{DynamicResource WarningTint}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLinkTargetHighlight}" Value="True">
                                                    <Setter TargetName="editorNodeBox" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                                                    <Setter TargetName="editorNodeBox" Property="BorderThickness" Value="2"/>
                                                    <Setter TargetName="portTop" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="portRight" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="portBottom" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="portLeft" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEditorHovered}" Value="True">
                                                    <Setter TargetName="portTop" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="portRight" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="portBottom" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="portLeft" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEditingInline}" Value="True">
                                                    <Setter TargetName="edNodeTitle" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="edInlineTitleWrap" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="editorNodeBox" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="editorNodeBox" Property="BorderThickness" Value="1.8"/>
                                                    <Setter TargetName="editorNodeBox" Property="Cursor" Value="IBeam"/>
                                                    <Setter TargetName="portTop" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="portRight" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="portBottom" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="portLeft" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 4. 连线文字说明胶囊 & 悬停「+ / 垃圾桶」操作条（置顶防被卡片遮挡） -->
                                <ItemsControl ItemsSource="{Binding GoalTreeEditor.Goal.Edges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding MidX}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding MidY}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GoalEdgeVM}">
                                            <Grid Width="260" Height="64" Margin="-130,-32,0,0" Background="{x:Null}">
                                                <Border x:Name="edgeMidPill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding ShowOverlay, Converter={StaticResource BoolToVisible}}"
                                                        Background="{DynamicResource Surface4}"
                                                        BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                                                        CornerRadius="10" Padding="5,2.5"
                                                        MouseEnter="TreeEdgeOverlay_MouseEnter"
                                                        MouseLeave="TreeEdgeOverlay_MouseLeave">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.14"/>
                                                    </Border.Effect>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="edgeLabelText" Text="{Binding Label}"
                                                                   FontSize="11" FontWeight="Medium"
                                                                   MaxWidth="136" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   VerticalAlignment="Center" Margin="3,0,4,0"
                                                                   Visibility="Collapsed"/>
                                                        <TextBox x:Name="edgeLabelBox" Style="{StaticResource SubtleInput}"
                                                                 Width="122" Height="24" FontSize="11"
                                                                 VerticalContentAlignment="Center"
                                                                 Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="Collapsed"
                                                                 KeyDown="TreeEdgeLabelBox_KeyDown"
                                                                 LostFocus="TreeEdgeLabelBox_LostFocus"
                                                                 IsVisibleChanged="TreeEdgeLabelBox_IsVisibleChanged"/>
                                                        <Button x:Name="edgeAddBtn" Style="{StaticResource GhostButton}"
                                                                Padding="4,2" Margin="0,0,2,0"
                                                                FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                Content="&#xE710;"
                                                                Foreground="{DynamicResource Accent}"
                                                                ToolTip="添加或编辑该连线的文字说明"
                                                                Visibility="Collapsed"
                                                                Tag="{Binding}" Click="TreeEdgeAddNote_Click"/>
                                                        <Button x:Name="edgeDelBtn" Style="{StaticResource GhostButton}"
                                                                Padding="4,2"
                                                                FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                Content="&#xE74D;"
                                                                Foreground="{DynamicResource Danger}"
                                                                ToolTip="删除该连线及其文字说明"
                                                                Visibility="Collapsed"
                                                                Tag="{Binding}" Click="TreeEdgeDelete_Click"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasLabel}" Value="True"/>
                                                        <Condition Binding="{Binding IsEditingLabel}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="edgeLabelText" Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsEditingLabel}" Value="True">
                                                    <Setter TargetName="edgeLabelBox" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="edgeMidPill" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsHovered}" Value="True"/>
                                                        <Condition Binding="{Binding IsEditingLabel}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="edgeAddBtn" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="edgeDelBtn" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="edgeMidPill" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </MultiDataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>

                            <!-- 四边拖出连线松手后的「归属 / 递进」选择浮层 -->
                            <Canvas Visibility="{Binding GoalTreeEditor.IsConnectMenuOpen, Converter={StaticResource BoolToVisible}}">
                                <Border x:Name="TreeEditorConnectMenu"
                                        Canvas.Left="{Binding GoalTreeEditor.ConnectMenuX}"
                                        Canvas.Top="{Binding GoalTreeEditor.ConnectMenuY}"
                                        Width="196" Padding="8" CornerRadius="8"
                                        Background="{DynamicResource Surface4}"
                                        BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.24"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="{Binding GoalTreeEditor.ConnectMenuHeader}"
                                                   Style="{StaticResource Caption}" Margin="4,0,4,6"/>
                                        <Button Style="{StaticResource GhostButton}"
                                                HorizontalContentAlignment="Left" Padding="8,6" Margin="0,0,0,2"
                                                Click="TreeEditorConnectBelong_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="2" Background="{DynamicResource BorderStrong}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                                            <Setter Property="Text" Value="在此新建归属子目标"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GoalTreeEditor.ConnectMenuHasTargetNode}" Value="True">
                                                                    <Setter Property="Text" Value="归属连线（实线）"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}"
                                                HorizontalContentAlignment="Left" Padding="8,6"
                                                Click="TreeEditorConnectProgress_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="2" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Accent}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                                            <Setter Property="Text" Value="在此新建递进子目标"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GoalTreeEditor.ConnectMenuHasTargetNode}" Value="True">
                                                                    <Setter Property="Text" Value="递进连线（虚线箭头）"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>
                </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="GoalPickerBodyTemplate" TargetType="ContentControl">
            <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="20,14,14,10"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{Binding GoalPicker.Goal.Color}"
                                         VerticalAlignment="Center" Margin="0,1,9,0"/>
                                <TextBlock Text="{Binding GoalPicker.HeaderTitle}"
                                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Content="&#xE711;"
                                    FontFamily="{StaticResource IconFont}" FontSize="11"
                                    HorizontalAlignment="Right" ToolTip="取消（Esc）"
                                    Click="GoalPickerCancel_Click"/>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface3}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                            Padding="20,8">
                        <Grid>
                            <TextBlock Text="{Binding GoalPicker.SummaryText}"
                                       Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding GoalPicker.ZoomLabel}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           Typography.NumeralAlignment="Tabular"/>
                                <Button Style="{StaticResource GhostButton}" Content="重置视图"
                                        Padding="7,2" FontSize="11"
                                        Click="GoalPickerResetView_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0" Padding="20,10,16,12">
                        <Grid>
                            <Button Style="{StaticResource GhostButton}" Content="清空该目标选择"
                                    HorizontalAlignment="Left" Padding="10,5"
                                    Foreground="{DynamicResource TextTertiary}"
                                    Click="GoalPickerClear_Click"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="取消"
                                        Padding="14,6" Margin="0,0,8,0"
                                        Click="GoalPickerCancel_Click"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="确定"
                                        Padding="16,6"
                                        Click="GoalPickerConfirm_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="GoalPickerViewport" Background="{DynamicResource Surface1}"
                            ClipToBounds="True" Cursor="Arrow"
                            PreviewMouseWheel="GoalPickerViewport_PreviewMouseWheel">
                        <Canvas Width="{Binding GoalPicker.Goal.CanvasWidth}"
                                Height="{Binding GoalPicker.Goal.CanvasHeight}"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding GoalPicker.Zoom}" ScaleY="{Binding GoalPicker.Zoom}"/>
                                    <TranslateTransform X="{Binding GoalPicker.PanX}" Y="{Binding GoalPicker.PanY}"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>

                            <ItemsControl ItemsSource="{Binding GoalPicker.Goal.Edges}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GoalEdgeVM}">
                                        <Canvas>
                                            <Path x:Name="pkLine" Data="{Binding LineGeometry}"
                                                  Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.5"/>
                                            <Path x:Name="pkArrow" Data="{Binding ArrowGeometry}"
                                                  Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                                        </Canvas>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsProgress}" Value="True">
                                                <Setter TargetName="pkLine" Property="Stroke" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="pkLine" Property="StrokeDashArray" Value="4 2"/>
                                                <Setter TargetName="pkArrow" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding GoalPicker.Goal.AllCanvasNodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GoalNodeVM}">
                                        <Border x:Name="pickerNodeBox" Tag="goalpickernode"
                                                Width="{Binding Width}" Height="{Binding Height}"
                                                Background="{DynamicResource Surface2}"
                                                BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,5" Cursor="Hand">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border x:Name="pickerNodeTint" Grid.RowSpan="2"
                                                        CornerRadius="5" Margin="-8,-5"
                                                        Background="Transparent" IsHitTestVisible="False"/>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="pkRootDot" Width="6" Height="6" Fill="{Binding Owner.Color}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock x:Name="pkTick" Grid.Column="2" Text="&#xE73E;"
                                                               FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                                               Foreground="{DynamicResource Accent}"
                                                               VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"/>
                                                </Grid>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0"
                                                            Visibility="{Binding HasDue, Converter={StaticResource BoolToVisible}}">
                                                    <TextBlock x:Name="pkDueIcon" Text="&#xE787;"
                                                               FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock x:Name="pkDueText" Text="{Binding DueBadgeText}"
                                                               FontSize="10" FontWeight="Medium"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               VerticalAlignment="Center"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                <Setter TargetName="pkRootDot" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDueOverdue}" Value="True">
                                                <Setter TargetName="pkDueIcon" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                <Setter TargetName="pkDueText" Property="Foreground" Value="{DynamicResource Danger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                <Setter TargetName="pickerNodeBox" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="pickerNodeBox" Property="BorderThickness" Value="1.5"/>
                                                <Setter TargetName="pickerNodeTint" Property="Background" Value="{DynamicResource AccentTint}"/>
                                                <Setter TargetName="pkTick" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>
                </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="DeadlinePickerBodyTemplate" TargetType="ContentControl">
            <StackPanel>
                    <!-- 标题 -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding DeadlinePicker.TargetTitle}"
                                   FontSize="14.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,28,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="&#xE711;"
                                FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                HorizontalAlignment="Right" ToolTip="关闭（Esc）"
                                AutomationProperties.Name="关闭截止日期选择器"
                                Click="DeadlinePickerClose_Click"/>
                    </Grid>

                    <!-- 快捷选择 -->
                    <WrapPanel Margin="0,0,0,10">
                        <Button Style="{StaticResource GhostButton}" Content="今天" Padding="8,4" Margin="0,0,4,4"
                                Click="DeadlineToday_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="明天" Padding="8,4" Margin="0,0,4,4"
                                Click="DeadlineTomorrow_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="本周日" Padding="8,4" Margin="0,0,4,4"
                                Click="DeadlineEndOfWeek_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="+7天" Padding="8,4" Margin="0,0,4,4"
                                Click="DeadlineNextWeek_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="清除日期" Padding="8,4" Margin="0,0,0,4"
                                Foreground="{DynamicResource Danger}"
                                Visibility="{Binding DeadlinePicker.HasCurrentDate, Converter={StaticResource BoolToVisible}}"
                                Click="DeadlineClear_Click"/>
                    </WrapPanel>

                    <!-- 月份切换 -->
                    <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            Padding="8,8" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Button Style="{StaticResource GhostButton}" Content="&#xE76B;"
                                        FontFamily="{StaticResource IconFont}" FontSize="10"
                                        Padding="7,4" HorizontalAlignment="Left"
                                        Click="DeadlinePrevMonth_Click"/>
                                <TextBlock Text="{Binding DeadlinePicker.MonthTitle}"
                                           FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular"/>
                                <Button Style="{StaticResource GhostButton}" Content="&#xE76C;"
                                        FontFamily="{StaticResource IconFont}" FontSize="10"
                                        Padding="7,4" HorizontalAlignment="Right"
                                        Click="DeadlineNextMonth_Click"/>
                            </Grid>

                            <UniformGrid Columns="7" Margin="0,0,0,4">
                                <TextBlock Text="一" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <TextBlock Text="二" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <TextBlock Text="三" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <TextBlock Text="四" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <TextBlock Text="五" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <TextBlock Text="六" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <TextBlock Text="日" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                            </UniformGrid>

                            <ItemsControl ItemsSource="{Binding DeadlinePicker.Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" Rows="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CalendarDayVM}">
                                        <Button Style="{StaticResource GhostButton}"
                                                Padding="0" Height="30" Margin="1"
                                                Tag="{Binding}" Click="DeadlineDay_Click">
                                            <Border x:Name="dayCellBg" Width="30" Height="26" CornerRadius="5"
                                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                                <TextBlock x:Name="dayCellText" Text="{Binding DayText}"
                                                           FontSize="12" FontWeight="Medium"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           Typography.NumeralAlignment="Tabular"/>
                                            </Border>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                <Setter TargetName="dayCellText" Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="dayCellBg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="dayCellText" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="dayCellText" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="dayCellBg" Property="Background" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="dayCellBg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="dayCellText" Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                                <Setter TargetName="dayCellText" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 可选具体时间点 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="DeadlineHasTimeToggle" Style="{StaticResource SwitchToggle}"
                                          AutomationProperties.Name="指定截止时间点"
                                          AutomationProperties.AutomationId="DeadlineHasTimeToggle"
                                          IsChecked="{Binding DeadlinePicker.HasTime, Mode=TwoWay}"/>
                            <TextBlock Text="具体时间点" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="DeadlineTimeBox" Grid.Column="1" Style="{StaticResource SubtleInput}"
                                 Width="78" Height="30" HorizontalAlignment="Right"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="目标截止时间点"
                                 AutomationProperties.AutomationId="DeadlineTimeBox"
                                 ToolTip="如 18:00 或 9:30"
                                 Text="{Binding DeadlinePicker.TimeText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="DeadlineManualBox_KeyDown"
                                 Visibility="{Binding DeadlinePicker.HasTime, Converter={StaticResource BoolToVisible}}"/>
                    </Grid>

                    <!-- 手动输入 yyyy-MM-dd 或 yyyy-MM-dd HH:mm -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="DeadlineManualBox" Style="{StaticResource SubtleInput}"
                                     Height="30" VerticalContentAlignment="Center"
                                     Text="{Binding DeadlinePicker.ManualText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="DeadlineManualBox_KeyDown"/>
                            <TextBlock Text="yyyy-MM-dd 或 yyyy-MM-dd HH:mm" IsHitTestVisible="False"
                                       FontSize="11.5" FontWeight="Medium" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextDisabled}"
                                       Visibility="{Binding Text, ElementName=DeadlineManualBox, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                        </Grid>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="应用"
                                Padding="12,5" FontSize="12" Margin="8,0,0,0"
                                Click="DeadlineApplyManual_Click"/>
                    </Grid>

                    <TextBlock Text="{Binding DeadlinePicker.ErrorText}"
                               FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Danger}"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding DeadlinePicker.ErrorText, Converter={StaticResource EmptyToCollapsed}}"/>
                </StackPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="ImportConfirmBodyTemplate" TargetType="ContentControl">
            <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,16,14,10">
                        <TextBlock Text="导入数据" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" Content="&#xE711;"
                                FontFamily="{StaticResource IconFont}" FontSize="11"
                                HorizontalAlignment="Right" ToolTip="关闭（Esc）"
                                AutomationProperties.Name="关闭"
                                AutomationProperties.AutomationId="ImportConfirmCloseButton"
                                Click="ImportConfirmCancel_Click"/>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0" Padding="20,10,16,12">
                        <Button Style="{StaticResource GhostButton}" Content="取消"
                                Padding="14,5" HorizontalAlignment="Right"
                                AutomationProperties.Name="取消"
                                AutomationProperties.AutomationId="ImportConfirmCancelButton"
                                Click="ImportConfirmCancel_Click"/>
                    </Border>

                    <StackPanel Margin="20,4,20,18">
                        <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding PendingImportFileName}" FontSize="13.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PendingImportSummary}" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding PendingImportCurrentNote}" Style="{StaticResource Caption}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="按 ID 合并" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="保留两边独有条目，相同 ID 以导入文件为准；完成记录去重合并"
                                               Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="合并导入"
                                        Padding="14,6" VerticalAlignment="Center"
                                        AutomationProperties.Name="合并导入"
                                        AutomationProperties.AutomationId="ImportMergeButton"
                                        Click="ImportConfirmMerge_Click"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="覆盖当前数据" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="用导入文件完全替换当前日程、目标、标签、预设与完成记录"
                                               Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="覆盖导入"
                                        Background="{DynamicResource Surface2}"
                                        Foreground="{DynamicResource Danger}"
                                        Padding="14,6" VerticalAlignment="Center"
                                        AutomationProperties.Name="覆盖导入"
                                        AutomationProperties.AutomationId="ImportOverwriteButton"
                                        Click="ImportConfirmOverwrite_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DockPanel>
        </ControlTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource Surface1}">
        <Grid x:Name="RootLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Grid Grid.Row="0" Background="{DynamicResource Surface1}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="/Assets/DayNew.ico" Width="22" Height="22"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"/>
                <TextBlock Text="日新" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="SearchOpenButton" Style="{StaticResource GhostButton}"
                        Height="26" Padding="10,0" Margin="0,6,6,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource Surface3}"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                        ToolTip="全局搜索"
                        AutomationProperties.Name="全局搜索"
                        AutomationProperties.AutomationId="SearchOpenButton"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="SearchOpen_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding SearchShortcutHint}" FontSize="11.5" FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="UndoButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE7A7;" ToolTip="{Binding UndoTooltip}"
                        IsEnabled="{Binding CanUndo}"
                        AutomationProperties.Name="撤销"
                        AutomationProperties.AutomationId="UndoButton"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Undo_Click"/>
                <Button x:Name="RedoButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE7A6;" ToolTip="{Binding RedoTooltip}"
                        IsEnabled="{Binding CanRedo}"
                        AutomationProperties.Name="重做"
                        AutomationProperties.AutomationId="RedoButton"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Redo_Click"/>
                <Button x:Name="ThemeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE706;" ToolTip="切换明暗"
                        AutomationProperties.Name="切换明暗"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Theme_Click"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="最小化"
                        AutomationProperties.Name="最小化"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        ToolTip="最大化" AutomationProperties.Name="最大化"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="关闭"
                        AutomationProperties.Name="关闭窗口"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
            </StackPanel>

            <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                    Background="{DynamicResource BorderSubtle}"/>
        </Grid>

        <!-- ================= dock + 内容 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DockColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧竖排 dock -->
            <Border x:Name="DockBorder" Grid.Column="0" Width="196" ClipToBounds="True"
                    Background="{DynamicResource Surface1}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,12,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="工作区" Style="{StaticResource Eyebrow}"
                                   Margin="18,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabled}"
                                   Visibility="{Binding IsDockExpanded, Converter={StaticResource BoolToVisible}}"/>
                        <Button Grid.Column="1" x:Name="DockToggle"
                                Style="{StaticResource GhostButton}" Padding="6,3"
                                FontFamily="{StaticResource IconFont}" FontSize="10"
                                Content="&#xE76B;" ToolTip="收起 / 展开侧边栏"
                                AutomationProperties.Name="收起或展开侧边栏"
                                RenderTransformOrigin="0.5,0.5"
                                Click="DockToggle_Click">
                            <Button.RenderTransform>
                                <RotateTransform x:Name="DockToggleRotate" Angle="0"/>
                            </Button.RenderTransform>
                        </Button>
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,12">
                        <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}"
                                HorizontalContentAlignment="Stretch"
                                Padding="10,8" Margin="0,0,0,8"
                                ToolTip="设置"
                                AutomationProperties.Name="设置"
                                AutomationProperties.AutomationId="SettingsButton"
                                Click="SettingsOpen_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" Width="24"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="设置" Style="{StaticResource NavLabel}"
                                           Visibility="{Binding IsDockExpanded, Converter={StaticResource BoolToVisible}}"/>
                            </Grid>
                        </Button>
                        <TextBlock Text="{Binding AppVersion}"
                                   Style="{StaticResource Caption}" Margin="10,0,0,2"
                                   Foreground="{DynamicResource TextDisabled}"
                                   Visibility="{Binding IsDockExpanded, Converter={StaticResource BoolToVisible}}"/>
                    </StackPanel>

                    <ListBox x:Name="NavHost" Style="{StaticResource NavList}"
                             Margin="0,2,0,8"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItemVM}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBlock x:Name="ico" Text="{Binding Icon}" Style="{StaticResource NavIcon}"/>
                                        <Ellipse x:Name="collapsedDot" Width="5" Height="5" Fill="{DynamicResource Danger}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,3,0"
                                                 Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock x:Name="lbl" Grid.Column="1" Text="{Binding Title}"
                                               Style="{StaticResource NavLabel}"
                                               Visibility="{Binding DataContext.IsDockExpanded, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisible}}"/>
                                    <Border x:Name="badgePill" Grid.Column="2"
                                            Background="{DynamicResource Danger}" CornerRadius="10"
                                            MinWidth="20" Height="20" Padding="6,0"
                                            VerticalAlignment="Center" Margin="6,0,0,0"
                                            Visibility="Collapsed">
                                        <TextBlock Text="{Binding BadgeCount}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource OnAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter TargetName="lbl" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasBadge}" Value="True"/>
                                            <Condition Binding="{Binding DataContext.IsDockExpanded, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="badgePill" Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasBadge}" Value="True"/>
                                            <Condition Binding="{Binding DataContext.IsDockExpanded, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="collapsedDot" Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Column="1" Background="{DynamicResource Surface0}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部常驻专注条（切到其它页时保持可见，在「专注」页本身收起） -->
                <Border x:Name="FocusBar" Grid.Row="0"
                        Background="{DynamicResource Surface2}"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                        Visibility="{Binding ShowTopFocusBar, Converter={StaticResource BoolToVisible}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Padding="6,4"
                                    ToolTip="点击切换到「专注」页"
                                    Click="FocusBarOpenPage_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="focusBarDot" Width="7" Height="7" Fill="{DynamicResource Accent}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Focus.ModeLabel}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Focus.DisplayTitle}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                               MaxWidth="360" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Focus.TimeText}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Typography.NumeralAlignment="Tabular"/>
                                <Button Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,4,0"
                                        Content="{Binding Focus.PauseButtonText}" FontSize="11.5"
                                        Click="FocusPause_Click"/>
                                <Button Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,4,0"
                                        Content="+5分" FontSize="11.5"
                                        Visibility="{Binding Focus.CanExtend, Converter={StaticResource BoolToVisible}}"
                                        Click="FocusExtend_Click"/>
                                <Button Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,4,0"
                                        Foreground="{DynamicResource Success}"
                                        Content="{Binding Focus.CompleteButtonText}" FontSize="11.5"
                                        Click="FocusComplete_Click"/>
                                <Button Style="{StaticResource GhostButton}" Padding="7,4" Margin="0,0,4,0"
                                        FontFamily="{StaticResource IconFont}" FontSize="11" Content="&#xE8A7;"
                                        ToolTip="呼出 / 隐藏桌面迷你悬浮窗"
                                        Click="ToggleFocusMini_Click"/>
                                <Button Style="{StaticResource GhostButton}" Padding="7,4"
                                        Content="{Binding Focus.StopButtonText}" FontSize="11.5"
                                        Foreground="{DynamicResource TextTertiary}"
                                        Click="FocusStop_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="focusBarTrack" Grid.Row="1" Height="2"
                              Background="{DynamicResource Surface3}"
                              Visibility="{Binding Focus.ShowProgress, Converter={StaticResource BoolToVisible}}">
                            <Border x:Name="focusBarFill" Background="{DynamicResource Accent}" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource RatioToWidth}">
                                        <Binding ElementName="focusBarTrack" Path="ActualWidth"/>
                                        <Binding Path="Focus.Progress"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 页面宿主 -->
                <Grid x:Name="PageHost" Grid.Row="1">

                    <!-- 概览：4 个任务档位 + 右侧目标列，五等分（逾期移到左侧 dock） -->
                    <Grid x:Name="PageOverview" Margin="12,14,12,0"
                          Visibility="{Binding IsOverview, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="50"/>
                            <ColumnDefinition Width="*" MinWidth="50"/>
                            <ColumnDefinition Width="*" MinWidth="50"/>
                            <ColumnDefinition Width="*" MinWidth="50"/>
                            <ColumnDefinition Width="*" MinWidth="50"/>
                        </Grid.ColumnDefinitions>

                        <ItemsControl x:Name="LanesHost" Grid.Column="0" Grid.ColumnSpan="4"
                                      ItemsSource="{Binding OverviewLanes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LaneVM}">
                                    <Border x:Name="lane" Style="{StaticResource LaneBorder}">
                                        <Grid>
                                            <Border x:Name="laneDropOverlay" Background="{DynamicResource AccentTint}"
                                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                                    CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                                            <DockPanel>
                                            <Border DockPanel.Dock="Top" Padding="4,0,4,8" Margin="0,0,0,10"
                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="laneTitle" Text="{Binding Title}"
                                                               Style="{StaticResource Eyebrow}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Count}"
                                                               Style="{StaticResource Eyebrow}"
                                                               Foreground="{DynamicResource TextTertiary}"/>
                                                </Grid>
                                            </Border>

                                            <Grid>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Padding="0,0,2,0">
                                                    <ItemsControl ItemsSource="{Binding Items}" Margin="4,0,4,8"
                                                                  ItemTemplate="{StaticResource TaskCardTemplate}"/>
                                                </ScrollViewer>

                                                <Grid VerticalAlignment="Top" Margin="4,0,4,0" IsHitTestVisible="False"
                                                      Visibility="{Binding Count, Converter={StaticResource ZeroToVisible}}">
                                                    <Rectangle Height="52" RadiusX="8" RadiusY="8"
                                                               Stroke="{DynamicResource BorderStrong}" StrokeThickness="1"
                                                               StrokeDashArray="3 3" Opacity="0.55"/>
                                                    <TextBlock Text="拖到这里" Style="{StaticResource Caption}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                            </DockPanel>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter TargetName="laneTitle" Property="Foreground" Value="{DynamicResource Danger}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="laneDropOverlay" Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="{StaticResource DurXs}" EasingFunction="{StaticResource EaseOut}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="laneDropOverlay" Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 目标列：放目标，不是任务；任务拖到目标卡片上就挂过去了 -->
                        <Border Grid.Column="4" Style="{StaticResource LaneBorder}" Margin="4,0,4,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="4,0,4,8" Margin="0,0,0,10"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="目标" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ActiveGoals.Count}"
                                                   Style="{StaticResource Eyebrow}"
                                                   Foreground="{DynamicResource TextTertiary}"/>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                                        <ItemsControl x:Name="GoalsHost" ItemsSource="{Binding ActiveGoals}" Margin="4,0,4,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:GoalVM}">
                                                    <Border x:Name="goalCard" Tag="goal" Style="{StaticResource CardBorder}"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Grid>
                                                            <Border x:Name="goalDropOverlay" Background="{DynamicResource AccentTint}"
                                                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                                                    CornerRadius="8" Margin="-10,-8" Opacity="0" IsHitTestVisible="False"/>
                                                            <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Width="6" Height="6" Fill="{Binding Color}"
                                                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                                           Style="{StaticResource CardTitle}"/>
                                                                <TextBlock Grid.Column="2" Text="&#xE8A1;"
                                                                           FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                                           ToolTip="包含子目标，拖入日程可选择具体子目标"
                                                                           Visibility="{Binding HasSubGoals, Converter={StaticResource BoolToVisible}}"/>
                                                            </Grid>

                                                            <Grid x:Name="bar" Height="3" Margin="0,7,0,0">
                                                                <Border Background="{DynamicResource Surface3}" CornerRadius="2"/>
                                                                <Border Background="{DynamicResource Accent}" CornerRadius="2"
                                                                        HorizontalAlignment="Left">
                                                                    <Border.Width>
                                                                        <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                                            <Binding ElementName="bar" Path="ActualWidth"/>
                                                                            <Binding Path="Progress"/>
                                                                        </MultiBinding>
                                                                    </Border.Width>
                                                                </Border>
                                                            </Grid>

                                                            <TextBlock Text="{Binding ProgressText}"
                                                                       Style="{StaticResource Caption}" Margin="0,5,0,0"/>

                                                            <ItemsControl x:Name="goalTasks" ItemsSource="{Binding Tasks}"
                                                                          Margin="0,7,0,0" Visibility="Collapsed" Opacity="0">
                                                                <ItemsControl.RenderTransform>
                                                                    <TranslateTransform x:Name="goalTasksShift" Y="-4"/>
                                                                </ItemsControl.RenderTransform>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:TaskVM}">
                                                                        <TextBlock x:Name="taskRow" Text="{Binding Title}"
                                                                                   Style="{StaticResource Caption}"
                                                                                   Margin="0,3,0,0"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <DataTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                                                <Setter TargetName="taskRow" Property="TextDecorations" Value="Strikethrough"/>
                                                                                <Setter TargetName="taskRow" Property="Opacity" Value="0.5"/>
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter TargetName="goalTasks" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="goalCard" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                                                            <Setter TargetName="goalCard" Property="Cursor" Value="Arrow"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="goalTasks" Storyboard.TargetProperty="Opacity"
                                                                                         From="0" To="1" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                                                                        <DoubleAnimation Storyboard.TargetName="goalTasksShift" Storyboard.TargetProperty="Y"
                                                                                         From="-4" To="0" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="goalDropOverlay" Storyboard.TargetProperty="Opacity"
                                                                                         To="1" Duration="{StaticResource DurXs}" EasingFunction="{StaticResource EaseOut}"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="goalDropOverlay" Storyboard.TargetProperty="Opacity"
                                                                                         To="0" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel VerticalAlignment="Top" IsHitTestVisible="False" Margin="4,0,4,0"
                                                Visibility="{Binding ActiveGoals.Count, Converter={StaticResource ZeroToVisible}}">
                                        <Rectangle Height="52" RadiusX="8" RadiusY="8"
                                                   Stroke="{DynamicResource BorderStrong}" StrokeThickness="1"
                                                   StrokeDashArray="3 3" Opacity="0.55"/>
                                        <TextBlock Text="还没有目标" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 视图：24 小时 × 日期 -->
                    <Grid x:Name="PageTimeline" Margin="16,14,16,0"
                          PreviewMouseWheel="PageTimeline_PreviewMouseWheel"
                          Visibility="{Binding IsTimeline, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <ContentControl x:Name="TimelinePageHost" IsTabStop="False" Template="{x:Null}"/>
                    </Grid>

                    <!-- 目标页：小卡与导图大卡错落 Bento 网格 + 下方已完成目标区 -->
                    <Grid x:Name="PageGoals" Margin="24,14,24,0"
                          Visibility="{Binding IsGoals, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <ContentControl x:Name="GoalsPageHost" IsTabStop="False" Template="{x:Null}"/>
                    </Grid>

                    <!-- 标签 / 人物 / 地点管理页：三段切换，自适应矩形卡片网格 -->
                    <Grid x:Name="PageTags" Margin="24,14,24,0"
                          Visibility="{Binding IsTags, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <ContentControl x:Name="TagsPageHost" IsTabStop="False" Template="{x:Null}"/>
                    </Grid>

                    <!-- 艾森豪威尔：两个标记决定的四格 -->
                    <Grid x:Name="PageEisenhower" Margin="16,14,16,0"
                          Visibility="{Binding IsEisenhower, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <ContentControl x:Name="EisenhowerPageHost" IsTabStop="False" Template="{x:Null}"/>
                    </Grid>

                    <!-- 专注页：自动跟随日程 + 自由专注正计时 + 悬浮窗与音效管理 -->
                    <Grid x:Name="PageFocus" Margin="24,14,24,0"
                          Visibility="{Binding IsFocusPage, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <ContentControl x:Name="FocusPageHost" IsTabStop="False" Template="{x:Null}"/>
                    </Grid>

                    <!-- 截止日期页：按天分组展示仅设截止日的日程 + 设了截止日的目标/子目标 -->
                    <Grid x:Name="PageDeadlines" Margin="24,14,24,0"
                          Visibility="{Binding IsDeadlines, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <ContentControl x:Name="DeadlinesPageHost" IsTabStop="False" Template="{x:Null}"/>
                    </Grid>

                    <!-- 未来事项页：无明确截止日期、只是将来要做的事情 -->
                    <Grid x:Name="PageFuture" Margin="24,14,24,0"
                          Visibility="{Binding IsFuture, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <ContentControl x:Name="FuturePageHost" IsTabStop="False" Template="{x:Null}"/>
                    </Grid>

                    <!-- 逾期页：网格卡片，窗口越宽列越多 -->
                    <Grid x:Name="PageOverdue" Margin="24,14,24,0"
                          Visibility="{Binding IsOverduePage, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <ContentControl x:Name="OverduePageHost" IsTabStop="False" Template="{x:Null}"/>
                    </Grid>

                    <!-- 还没做的页 -->
                    <Grid x:Name="PagePlaceholder"
                          Visibility="{Binding IsPlaceholder, Converter={StaticResource BoolToVisible}}">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430">
                            <TextBlock Text="待做" Style="{StaticResource Eyebrow}"
                                       Foreground="{DynamicResource TextDisabled}"/>
                            <TextBlock Text="{Binding CurrentTitle}" FontSize="19" FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding CurrentBlurb}" TextWrapping="Wrap" LineHeight="21"
                                       FontSize="13" FontWeight="Medium" Margin="0,12,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <Border Background="{DynamicResource Surface3}" CornerRadius="6"
                                    Padding="10,5" HorizontalAlignment="Left" Margin="0,20,0,0">
                                <TextBlock Text="先把结构定下来，功能随后补" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 状态栏 -->
                <Grid Grid.Row="2" Margin="16,4,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusLeft}" Style="{StaticResource Caption}"/>
                    <TextBlock Grid.Column="2" Text="{Binding StatusRight}" Style="{StaticResource Caption}"
                               ToolTip="{Binding DataPath}"
                               Foreground="{DynamicResource TextDisabled}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= 标签详情按日时间流浮层 ================= -->
        <Grid x:Name="TagDetailLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="TagDetailScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="TagDetailScrim_Click"/>
            <Border x:Name="TagDetailDialog" Width="980" Height="560"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True"
                    Opacity="0" RenderTransformOrigin="0.5,0.5"
                    PreviewMouseWheel="TagDetailScroll_PreviewMouseWheel">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="TagDetailScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="TagDetailShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <ContentControl x:Name="TagDetailBodyHost" IsTabStop="False" Template="{x:Null}"/>
            </Border>
        </Grid>

        <!-- ================= 日程编辑浮层（新建 / 编辑同一个） ================= -->
        <Grid x:Name="EditorLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="EditorScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="EditorScrim_Click"/>
            <Border x:Name="EditorDialog" Width="600" MaxHeight="680"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True"
                    Opacity="0" RenderTransformOrigin="0.5,0.5"
                    KeyDown="Editor_KeyDown">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="EditorScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="EditorShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <ContentControl x:Name="EditorBodyHost" IsTabStop="False" Template="{x:Null}"/>
            </Border>
        </Grid>

        <!-- ================= 设置浮层 ================= -->
        <Grid x:Name="SettingsLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="SettingsScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="SettingsScrim_Click"/>
            <Border x:Name="SettingsDialog" Width="540" MaxHeight="640"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SettingsScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="SettingsShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <ContentControl x:Name="SettingsBodyHost" IsTabStop="False" Template="{x:Null}"/>
            </Border>
        </Grid>

        <!-- ================= 快捷卡片管理浮层 ================= -->
        <Grid x:Name="PresetManagerLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="PresetManagerScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="PresetManagerScrim_Click"/>
            <Border x:Name="PresetManagerDialog" Width="560" MaxHeight="660"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True"
                    Opacity="0" RenderTransformOrigin="0.5,0.5"
                    KeyDown="PresetManager_KeyDown">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PresetManagerScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="PresetManagerShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <ContentControl x:Name="PresetManagerBodyHost" IsTabStop="False" Template="{x:Null}"/>
            </Border>
        </Grid>

        <!-- ================= 目标树结构编辑浮层 ================= -->
        <Grid x:Name="GoalTreeEditorLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="GoalTreeEditorScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="GoalTreeEditorScrim_Click"/>
            <Border x:Name="GoalTreeEditorDialog" Width="940" Height="630"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="GoalTreeEditorScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="GoalTreeEditorShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <ContentControl x:Name="GoalTreeEditorBodyHost" IsTabStop="False" Template="{x:Null}"/>
            </Border>
        </Grid>

        <!-- ================= 目标树多选浮层（置于编辑浮层之上） ================= -->
        <Grid x:Name="GoalPickerLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="GoalPickerScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="GoalPickerScrim_Click"/>
            <Border x:Name="GoalPickerDialog" Width="780" Height="540"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="GoalPickerScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="GoalPickerShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <ContentControl x:Name="GoalPickerBodyHost" IsTabStop="False" Template="{x:Null}"/>
            </Border>
        </Grid>

        <!-- ================= 目标截止日期选择浮层（置于目标页与目标树编辑器之上） ================= -->
        <Grid x:Name="DeadlinePickerLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="DeadlinePickerScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="DeadlinePickerScrim_Click"/>
            <Border x:Name="DeadlinePickerDialog" Width="312"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" Padding="16,14"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="DeadlinePickerScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="DeadlinePickerShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <ContentControl x:Name="DeadlinePickerBodyHost" IsTabStop="False" Template="{x:Null}"/>
            </Border>
        </Grid>

        <!-- ================= 导入确认浮层（置于设置浮层之上） ================= -->
        <Grid x:Name="ImportConfirmLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="ImportConfirmScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="ImportConfirmScrim_Click"/>
            <Border x:Name="ImportConfirmDialog" Width="468"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImportConfirmScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="ImportConfirmShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <ContentControl x:Name="ImportConfirmBodyHost" IsTabStop="False" Template="{x:Null}"/>
            </Border>
        </Grid>

        <!-- ================= 全局搜索浮层（Command Palette） ================= -->
        <Grid x:Name="SearchLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="SearchScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="SearchScrim_Click"/>
            <Border x:Name="SearchDialog" Width="560" MaxHeight="520"
                    Margin="0,72,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SearchScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="SearchShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <ContentControl x:Name="SearchBodyHost" IsTabStop="False" Template="{x:Null}"/>
            </Border>
        </Grid>

        <!-- ================= 无时段日程专注时长选择浮层 ================= -->
        <Grid x:Name="FocusDurationLayer" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="FocusDurationScrim" Background="{DynamicResource Scrim}" Opacity="0"
                    MouseLeftButtonDown="FocusDurationScrim_Click"/>
            <Border x:Name="FocusDurationDialog" Width="340"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="12" Padding="18,16"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="FocusDurationScale" ScaleX="0.97" ScaleY="0.97"/>
                        <TranslateTransform x:Name="FocusDurationShift" Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="选择专注方式" FontSize="15" FontWeight="SemiBold"/>
                        <Button Style="{StaticResource GhostButton}" Content="&#xE711;"
                                FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                HorizontalAlignment="Right" Padding="6,4"
                                Click="FocusDurationClose_Click"/>
                    </Grid>
                    <TextBlock x:Name="FocusDurationTaskTitle" FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,12"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Style="{StaticResource GhostButton}" Background="{DynamicResource Surface3}"
                                Padding="12,7" Margin="0,0,8,8" Content="15 分钟" Tag="15"
                                Click="FocusDurationPick_Click"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Padding="14,7" Margin="0,0,8,8" Content="25 分钟" Tag="25"
                                Click="FocusDurationPick_Click"/>
                        <Button Style="{StaticResource GhostButton}" Background="{DynamicResource Surface3}"
                                Padding="12,7" Margin="0,0,8,8" Content="45 分钟" Tag="45"
                                Click="FocusDurationPick_Click"/>
                        <Button Style="{StaticResource GhostButton}" Background="{DynamicResource Surface3}"
                                Padding="12,7" Margin="0,0,8,8" Content="60 分钟" Tag="60"
                                Click="FocusDurationPick_Click"/>
                    </WrapPanel>
                    <Button Style="{StaticResource GhostButton}" Background="{DynamicResource Surface3}"
                            HorizontalContentAlignment="Center" Padding="12,8"
                            Content="正计时专注（不设结束时间）"
                            Click="FocusDurationStopwatch_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 操作反馈胶囊提示 -->
        <Border x:Name="ToastPill" Grid.RowSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28" Padding="14,7" CornerRadius="16"
                Background="{DynamicResource Surface4}"
                BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="8"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.18"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ToastDot" Width="6" Height="6" Fill="{DynamicResource Accent}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="ToastText" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 标签颜色选择浮层 -->
        <Popup x:Name="TagColorPopup"
               StaysOpen="False"
               AllowsTransparency="True"
               Placement="Bottom"
               VerticalOffset="4">
            <Border Margin="8"
                    Padding="10,9"
                    CornerRadius="10"
                    Background="{DynamicResource Surface4}"
                    BorderBrush="{DynamicResource BorderStrong}"
                    BorderThickness="1"
                    RenderOptions.ClearTypeHint="Enabled">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.20"/>
                </Border.Effect>
                <UniformGrid x:Name="TagColorPaletteGrid" Columns="6" Rows="2"/>
            </Border>
        </Popup>

        </Grid>

        <!-- 拖拽幽灵层 -->
        <Canvas x:Name="DragLayer" IsHitTestVisible="False"/>
    </Grid>
</Window>
