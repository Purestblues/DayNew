                                                     Style="{StaticResource SubtlePasswordBox}"
                                                     Background="{DynamicResource Surface2}"
                                                     Height="30" VerticalContentAlignment="Center"
                                                     ToolTip="坚果云第三方应用管理中生成的应用专属密码"
                                                     AutomationProperties.Name="WebDAV 应用专属密码"
                                                     AutomationProperties.AutomationId="WebDavPasswordBox"
