<Window x:Class="DayNew.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DayNew.Core"
        xmlns:vm="clr-namespace:DayNew.ViewModels"
        Title="日新 DayNew"
        Width="1360" Height="820"
        MinWidth="1080" MinHeight="620"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="{DynamicResource Surface1}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <core:ZeroToVisibleConverter x:Key="ZeroToVisible"/>
        <core:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
        <core:EmptyToVisibleConverter x:Key="EmptyToVisible"/>
        <core:BoolToVisibleConverter x:Key="BoolToVisible"/>
        <core:RatioToWidthConverter x:Key="RatioToWidth"/>
        <core:TextEqualsConverter x:Key="TextEquals"/>

        <Style x:Key="TitleEditor" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionPill}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagRemoveButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="3,0,0,0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="AutomationProperties.Name" Value="移除标签"/>
        </Style>

        <!-- 日程卡片上的目标胶囊（两层：总目标 + 直属子目标） -->
        <DataTemplate x:Key="CompactGoalChipTemplate" DataType="{x:Type vm:GoalChipVM}">
            <Border Background="{DynamicResource Surface3}" CornerRadius="4"
                    Padding="5,1" Margin="0,0,4,3" ToolTip="{Binding ToolTipText}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="5" Height="5" Fill="{Binding Color}"
                             VerticalAlignment="Center" Margin="0,0,4,0"
                             Visibility="{Binding IsRoot, Converter={StaticResource BoolToVisible}}"/>
                    <TextBlock Text="{Binding DisplayText}" FontSize="11" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 概览 / 逾期 共用的任务卡片模板 -->
        <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type vm:TaskVM}">
            <Border x:Name="card" Tag="card" Style="{StaticResource CardBorder}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="开始专注" Click="MenuStartFocus_Click"/>
                        <MenuItem Header="标记完成 / 取消" Click="MenuToggleDone_Click"/>
                        <MenuItem Header="移到今天" Click="MenuMoveToday_Click"/>
                        <MenuItem Header="移到明天" Click="MenuMoveTomorrow_Click"/>
                        <MenuItem Header="移到未来事项" Click="MenuMoveFuture_Click"/>
                        <Separator/>
                        <MenuItem Header="删除" Click="MenuDelete_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton Grid.Column="0" Style="{StaticResource CheckDot}"
                                  IsChecked="{Binding Done, Mode=OneWay}"
                                  VerticalAlignment="Top" Margin="0,2,9,0"
                                  Click="Check_Click"/>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="6" Height="6" Fill="{Binding PrimaryGoalColor}"
                                 VerticalAlignment="Top" Margin="0,7,6,0"
                                 Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}"/>

                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="titleBox" Style="{StaticResource TitleEditor}"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="Collapsed"
                                     GotFocus="InlineTaskField_GotFocus"
                                     LostFocus="InlineTaskField_LostFocus"
                                     KeyDown="TitleBox_KeyDown"/>
                            <TextBlock x:Name="titleText" Text="{Binding Title}"
                                       Style="{StaticResource CardTitle}"/>
                            <Grid x:Name="metaRow" Margin="0,1,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="remindBell" Grid.Column="0" Text="&#xEA8F;"
                                           FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                           Foreground="{DynamicResource TextTertiary}"
                                           VerticalAlignment="Center" Margin="0,0,5,0"
                                           ToolTip="{Binding RemindTooltip}"
                                           Visibility="{Binding ShowRemindBell, Converter={StaticResource BoolToVisible}}"/>
                                <TextBlock x:Name="metaText" Grid.Column="1" Text="{Binding MetaText}"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <WrapPanel x:Name="peopleLocRow" Margin="0,2,0,0"
                                       Visibility="{Binding HasPeopleOrLocations, Converter={StaticResource BoolToVisible}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                            Visibility="{Binding HasPersons, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding PersonsText}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding HasLocations, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding LocationsText}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                            </WrapPanel>
                            <ItemsControl x:Name="compactGoalChips" ItemsSource="{Binding CompactGoalChips}"
                                          ItemTemplate="{StaticResource CompactGoalChipTemplate}"
                                          Margin="0,4,0,0"
                                          Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <StackPanel x:Name="editor" Visibility="Collapsed"
                                        Opacity="0" Margin="0,9,0,0">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="editorShift" Y="-4"/>
                                </StackPanel.RenderTransform>
                                <ItemsControl ItemsSource="{Binding FullGoalChips}" Margin="0,0,0,6"
                                              Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GoalChipVM}">
                                            <Border Background="{DynamicResource Surface3}" CornerRadius="4"
                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                    Padding="6,2" Margin="0,0,4,4" ToolTip="{Binding ToolTipText}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding Color}"
                                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding DisplayText}" FontSize="11.5" FontWeight="Medium"
                                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid>
                                    <TextBox x:Name="noteBox" Style="{StaticResource SubtleInput}"
                                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                             GotFocus="InlineTaskField_GotFocus"
                                             LostFocus="InlineTaskField_LostFocus"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="46" MaxHeight="140"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="备注（选填）" IsHitTestVisible="False"
                                               FontSize="12.5" FontWeight="Medium" Margin="8,6,0,0"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Visibility="{Binding Note, Converter={StaticResource EmptyToVisible}}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,7,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagChip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding Color}"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource TagText}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Content="&#xE711;"
                                                            Style="{StaticResource TagRemoveButton}"
                                                            Tag="{Binding}"
                                                            Click="TagRemove_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid HorizontalAlignment="Left" Margin="0,2,0,0">
                                    <TextBox x:Name="tagBox" Style="{StaticResource SubtleInput}"
                                             Width="96" Height="28"
                                             ToolTip="回车添加标签"
                                             KeyDown="TagInput_KeyDown"/>
                                    <TextBlock Text="+ 标签" IsHitTestVisible="False"
                                               FontSize="12" FontWeight="Medium" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Visibility="{Binding Text, ElementName=tagBox, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Persons}" Margin="0,6,0,0"
                                              Visibility="{Binding HasPersons, Converter={StaticResource BoolToVisible}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagChip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource TagText}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Content="&#xE711;"
                                                            Style="{StaticResource TagRemoveButton}"
                                                            AutomationProperties.Name="移除人物"
                                                            Tag="{Binding}"
                                                            Click="PersonRemove_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Locations}" Margin="0,4,0,0"
                                              Visibility="{Binding HasLocations, Converter={StaticResource BoolToVisible}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagChip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource TagText}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Content="&#xE711;"
                                                            Style="{StaticResource TagRemoveButton}"
                                                            AutomationProperties.Name="移除地点"
                                                            Tag="{Binding}"
                                                            Click="LocationRemove_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <WrapPanel Margin="0,3,0,0">
                                    <Grid HorizontalAlignment="Left" Margin="0,0,6,2">
                                        <TextBox x:Name="personBox" Style="{StaticResource SubtleInput}"
                                                 Width="96" Height="28"
                                                 ToolTip="回车添加人物"
                                                 KeyDown="PersonInput_KeyDown"/>
                                        <TextBlock Text="+ 人物" IsHitTestVisible="False"
                                                   FontSize="12" FontWeight="Medium" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Visibility="{Binding Text, ElementName=personBox, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                    </Grid>
                                    <Grid HorizontalAlignment="Left" Margin="0,0,0,2">
                                        <TextBox x:Name="locationBox" Style="{StaticResource SubtleInput}"
                                                 Width="96" Height="28"
                                                 ToolTip="回车添加地点"
                                                 KeyDown="LocationInput_KeyDown"/>
                                        <TextBlock Text="+ 地点" IsHitTestVisible="False"
                                                   FontSize="12" FontWeight="Medium" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Visibility="{Binding Text, ElementName=locationBox, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                    </Grid>
                                </WrapPanel>

                                <Grid HorizontalAlignment="Left" Margin="0,7,0,0">
                                    <TextBox x:Name="timeBox" Style="{StaticResource SubtleInput}"
                                             Height="28" Width="108"
                                             Text="{Binding TimeLabel, Mode=OneTime}"
                                             ToolTip="比如 9-10:30；留空回车 = 不要时间"
                                             KeyDown="TimeBox_KeyDown"
                                             LostFocus="TimeBox_LostFocus"/>
                                    <TextBlock Text="时间 9-10:30" IsHitTestVisible="False"
                                               FontSize="11.5" FontWeight="Medium" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Visibility="{Binding Text, ElementName=timeBox, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="紧急"
                                                  IsChecked="{Binding IsUrgent, Mode=OneWay}"
                                                  ToolTip="艾森豪威尔的两个轴：紧急"
                                                  Click="Urgent_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="重要"
                                                  IsChecked="{Binding IsImportant, Mode=OneWay}"
                                                  ToolTip="艾森豪威尔的两个轴：重要"
                                                  Click="Important_Click"/>
                                </StackPanel>

                                <WrapPanel Margin="0,7,0,0" ToolTip="{Binding RemindTooltip}">
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="不提醒" Tag="none"
                                                  Margin="0,0,4,4"
                                                  IsChecked="{Binding IsRemindNone, Mode=OneWay}"
                                                  Click="TaskRemindChip_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="前15分" Tag="pre15"
                                                  Margin="0,0,4,4"
                                                  IsChecked="{Binding IsRemindPre15, Mode=OneWay}"
                                                  Click="TaskRemindChip_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="前5分" Tag="pre5"
                                                  Margin="0,0,4,4"
                                                  IsChecked="{Binding IsRemindPre5, Mode=OneWay}"
                                                  Click="TaskRemindChip_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="开始" Tag="start"
                                                  Margin="0,0,4,4"
                                                  Visibility="{Binding IsDeadlineOnlyRemind, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"
                                                  IsChecked="{Binding IsRemindStart, Mode=OneWay}"
                                                  Click="TaskRemindChip_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="{Binding RemindEndShortText}" Tag="end"
                                                  Margin="0,0,4,4"
                                                  IsChecked="{Binding IsRemindEnd, Mode=OneWay}"
                                                  Click="TaskRemindChip_Click"/>
                                </WrapPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left" Padding="7,4" FontSize="11.5"
                                            Content="{Binding RepeatLabel}"
                                            ToolTip="点击切换：不重复 / 每天 / 每周 / 每月"
                                            Click="Repeat_Click"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource GhostButton}"
                                                Padding="7,4" FontSize="11.5" Margin="0,0,4,0"
                                                Foreground="{DynamicResource Accent}"
                                                Content="专注"
                                                ToolTip="开始专注此日程"
                                                Click="ExpandFocus_Click"/>
                                        <Button Style="{StaticResource GhostButton}"
                                                Padding="7,4" FontSize="11.5"
                                                Foreground="{DynamicResource TextTertiary}"
                                                Content="删除" Click="Delete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Column="2" Text="&#x22EE;&#x22EE;"
                               FontSize="9" Margin="6,1,0,0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource TextDisabled}"/>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="editor" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="titleBox" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="titleText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="metaRow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="peopleLocRow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="compactGoalChips" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                    <Setter TargetName="card" Property="Cursor" Value="Arrow"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="editor" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                                <DoubleAnimation Storyboard.TargetName="editorShift" Storyboard.TargetProperty="Y"
                                                 From="-4" To="0" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Done}" Value="True"/>
                        <Condition Binding="{Binding IsExpanded}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="card" Property="Opacity" Value="0.5"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="titleText" Property="TextDecorations" Value="Strikethrough"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetaText}" Value="">
                    <Setter TargetName="metaText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding MetaText}" Value=""/>
                        <Condition Binding="{Binding ShowRemindBell}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="metaRow" Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    
        <ControlTemplate x:Key="TimelinePageTemplate" TargetType="ContentControl">
            <Grid>
<Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 工具条：回到今日今时 + 快捷日程预设卡片 + 管理入口 + 缩放档 -->
                        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="回到今日今时" Style="{StaticResource GhostButton}"
                                    AutomationProperties.Name="回到今日今时"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Padding="9,4" Margin="0,0,8,0" Click="Today_Click"/>

                            <ScrollViewer x:Name="PresetsScroll" Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center" Margin="0,0,8,0">
                                <ItemsControl x:Name="PresetsHost" ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SchedulePresetVM}">
                                            <Border x:Name="presetChip" Tag="preset"
                                                    Background="{DynamicResource Surface2}"
                                                    BorderBrush="{DynamicResource BorderSubtle}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    Padding="9,4" Margin="0,0,6,0"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    ToolTip="按住拖到下方时间轴直接添加">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding DotBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"
                                                             Visibility="{Binding HasDot, Converter={StaticResource BoolToVisible}}"/>
                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding DurationLabel}"
                                                               FontSize="11" FontWeight="Medium"
                                                               VerticalAlignment="Center" Margin="5,0,0,0"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock Text="&#xEA8F;"
                                                               FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               VerticalAlignment="Center" Margin="4,0,0,0"
                                                               ToolTip="{Binding RemindTooltip}"
                                                               Visibility="{Binding HasRemind, Converter={StaticResource BoolToVisible}}"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="presetChip" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="presetChip" Property="Background" Value="{DynamicResource Surface3}"/>
                                                    <Setter TargetName="presetChip" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ManagePresetsButton" Style="{StaticResource GhostButton}"
                                        Padding="8,4" Margin="0,0,6,0"
                                        ToolTip="新增、编辑或删除快捷日程卡片"
                                        AutomationProperties.Name="管理快捷卡片"
                                        AutomationProperties.AutomationId="ManagePresetsButton"
                                        Click="ManagePresets_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="10.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="快捷卡片" FontSize="12" FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <ItemsControl ItemsSource="{Binding ZoomOptions}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ZoomOptionVM}">
                                            <ToggleButton Style="{StaticResource SegmentButton}"
                                                          Content="{Binding Label}"
                                                          Tag="{Binding Index}"
                                                          IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                                          Click="Zoom_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <!-- 日期表头（跟着横向滚动） -->
                        <ScrollViewer x:Name="HeaderScroll" Grid.Row="1" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      IsHitTestVisible="False" Focusable="False">
                            <ItemsControl ItemsSource="{Binding TimelineDays}" Width="{Binding TimelineWidth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineDayVM}">
                                        <Border Width="160" Padding="10,0,0,7"
                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                BorderThickness="0,0,1,1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="dayName" Text="{Binding DayName}"
                                                           Style="{StaticResource Eyebrow}"
                                                           FontSize="13.5" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="dayNumber" Text="{Binding DayNumber}"
                                                           Style="{StaticResource Caption}"
                                                           FontSize="12.5" VerticalAlignment="Center"
                                                           Margin="7,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="dayName" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="dayNumber" Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 左侧刻度（跟着纵向滚动） -->
                        <ScrollViewer x:Name="GutterScroll" Grid.Row="2" Grid.Column="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsHitTestVisible="False" Focusable="False">
                            <Grid Width="66" Height="{Binding GridHeight}">
                                <ItemsControl ItemsSource="{Binding TimelineHours}" Width="66">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineHourVM}">
                                            <TextBlock x:Name="tickText" Text="{Binding Text}" Height="{Binding Height}"
                                                       FontSize="11.5" FontWeight="Medium" Margin="0,0,8,0"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHour}" Value="True">
                                                    <Setter TargetName="tickText" Property="FontSize" Value="12.5"/>
                                                    <Setter TargetName="tickText" Property="FontWeight" Value="SemiBold"/>
                                                    <Setter TargetName="tickText" Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCoveredByNow}" Value="True">
                                                    <Setter TargetName="tickText" Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 当前分钟徽标（跟随红线高度） -->
                                <Canvas IsHitTestVisible="False">
                                    <Border Canvas.Top="{Binding NowBadgeTop}" Canvas.Right="6"
                                            Height="18" Padding="5,0" CornerRadius="4"
                                            Background="{DynamicResource Danger}">
                                        <TextBlock Text="{Binding NowTimeText}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource OnAccent}"
                                                   Typography.NumeralAlignment="Tabular"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>

                        <!-- 网格 + 任务块 -->
                        <ScrollViewer x:Name="BodyScroll" Grid.Row="2" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="BodyScroll_ScrollChanged">
                            <Grid Width="{Binding TimelineWidth}" Height="{Binding GridHeight}">
                                <ItemsControl x:Name="DaysHost" ItemsSource="{Binding TimelineDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineDayVM}">
                                            <Border Width="160" Background="{Binding GridBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtle}"
                                                    BorderThickness="0,0,1,0">
                                                <Grid>
                                                    <Border Background="{DynamicResource AccentTint}" Opacity="0.3"
                                                            IsHitTestVisible="False"
                                                            Visibility="{Binding IsToday, Converter={StaticResource BoolToVisible}}"/>

                                                    <ItemsControl ItemsSource="{Binding Blocks}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:TimelineBlockVM}">
                                                                <Border x:Name="blk" Width="{Binding Width}" Height="{Binding Height}"
                                                                        Tag="block" ClipToBounds="True"
                                                                        Background="{DynamicResource Surface2}"
                                                                        BorderBrush="{DynamicResource BorderStrong}"
                                                                        BorderThickness="1" CornerRadius="4"
                                                                        Cursor="Hand"
                                                                        RenderTransformOrigin="0.5,0.5"
                                                                        ToolTip="{Binding BlockToolTip}">
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="开始专注" Click="MenuStartFocusBlock_Click"/>
                                                                            <MenuItem Header="编辑日程" Click="MenuEditBlock_Click"/>
                                                                            <MenuItem Header="标记完成 / 取消" Click="MenuToggleDoneBlock_Click"/>
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>
                                                                    <Grid>
                                                                        <Border x:Name="blkHover" Background="{DynamicResource HoverOverlay}"
                                                                                CornerRadius="3" Opacity="0" IsHitTestVisible="False"/>
                                                                        <Grid x:Name="blkSingleLine" Margin="6,0" VerticalAlignment="Center"
                                                                              Visibility="Collapsed">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock x:Name="blkSingleTitle" Text="{Binding Title}"
                                                                                       FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                                                        Margin="4,0,0,0"
                                                                                        Visibility="{Binding HasInlineDots, Converter={StaticResource BoolToVisible}}">
                                                                                <ItemsControl ItemsSource="{Binding Task.Tags}" VerticalAlignment="Center">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal"/>
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Ellipse Width="4" Height="4" Fill="{Binding Color}"
                                                                                                     VerticalAlignment="Center" Margin="0,0,2,0"
                                                                                                     ToolTip="{Binding Name}"/>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <ItemsControl ItemsSource="{Binding Task.DistinctGoals}" VerticalAlignment="Center"
                                                                                              Visibility="{Binding Task.HasGoal, Converter={StaticResource BoolToVisible}}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal"/>
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate DataType="{x:Type vm:GoalVM}">
                                                                                            <Ellipse Width="4" Height="4" Fill="{Binding Color}"
                                                                                                     VerticalAlignment="Center" Margin="1,0,1,0"
                                                                                                     ToolTip="{Binding Title}"/>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="8.5"
                                                                                           Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="2,0,0,0"
                                                                                           ToolTip="{Binding Task.PersonsText}"
                                                                                           Visibility="{Binding Task.HasPersons, Converter={StaticResource BoolToVisible}}"/>
                                                                                <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="8.5"
                                                                                           Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="2,0,0,0"
                                                                                           ToolTip="{Binding Task.LocationsText}"
                                                                                           Visibility="{Binding Task.HasLocations, Converter={StaticResource BoolToVisible}}"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                                                                <TextBlock Text="&#xEA8F;"
                                                                                           FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                                           VerticalAlignment="Center" Margin="0,0,3,0"
                                                                                           ToolTip="{Binding Task.RemindTooltip}"
                                                                                           Visibility="{Binding Task.ShowRemindBell, Converter={StaticResource BoolToVisible}}"/>
                                                                                <TextBlock Text="{Binding TimeText}"
                                                                                           FontSize="10.5" FontWeight="Medium"
                                                                                           VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                                           Typography.NumeralAlignment="Tabular"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <Grid x:Name="blkContent" Margin="6,3">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                                                                <TextBlock x:Name="blkTitle" Text="{Binding Title}"
                                                                                           FontSize="12" FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock x:Name="blkTime" Text="{Binding TimeText}" FontSize="10.5" FontWeight="Medium"
                                                                                               Foreground="{DynamicResource TextTertiary}"
                                                                                               VerticalAlignment="Center"
                                                                                               Typography.NumeralAlignment="Tabular"/>
                                                                                    <TextBlock Text="&#xEA8F;"
                                                                                               FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                                                               Foreground="{DynamicResource TextTertiary}"
                                                                                               VerticalAlignment="Center" Margin="4,0,0,0"
                                                                                               ToolTip="{Binding Task.RemindTooltip}"
                                                                                               Visibility="{Binding Task.ShowRemindBell, Converter={StaticResource BoolToVisible}}"/>
                                                                                </StackPanel>
                                                                            </StackPanel>

                                                                            <!-- 右侧：所属标签 + 目标。和标题/时间左右并排，短块也能完整展示 -->
                                                                            <StackPanel x:Name="blkMeta" Grid.Column="1"
                                                                                        MaxWidth="82" Margin="6,1,0,0"
                                                                                        VerticalAlignment="Top" HorizontalAlignment="Right"
                                                                                        Visibility="{Binding HasSideMeta, Converter={StaticResource BoolToVisible}}">
                                                                                <ItemsControl ItemsSource="{Binding Task.Tags}" HorizontalAlignment="Right">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <WrapPanel HorizontalAlignment="Right"/>
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Margin="4,0,0,1">
                                                                                                <Ellipse Width="4" Height="4" Fill="{Binding Color}"
                                                                                                         VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Medium"
                                                                                                           MaxWidth="52" TextTrimming="CharacterEllipsis"
                                                                                                           Foreground="{DynamicResource TextTertiary}"/>
                                                                                            </StackPanel>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>

                                                                                <ItemsControl ItemsSource="{Binding Task.CompactGoalChips}" HorizontalAlignment="Right"
                                                                                              Margin="0,1,0,0"
                                                                                              Visibility="{Binding Task.HasGoal, Converter={StaticResource BoolToVisible}}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <WrapPanel HorizontalAlignment="Right"/>
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate DataType="{x:Type vm:GoalChipVM}">
                                                                                            <StackPanel Orientation="Horizontal" Margin="3,0,0,1" ToolTip="{Binding ToolTipText}">
                                                                                                <Ellipse Width="4" Height="4" Fill="{Binding Color}"
                                                                                                         VerticalAlignment="Center" Margin="0,0,2,0"
                                                                                                         Visibility="{Binding IsRoot, Converter={StaticResource BoolToVisible}}"/>
                                                                                                <TextBlock Text="{Binding DisplayText}" FontSize="10" FontWeight="Medium"
                                                                                                           MaxWidth="64" TextTrimming="CharacterEllipsis"
                                                                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                                                            </StackPanel>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0"
                                                                                            ToolTip="{Binding Task.PersonsText}"
                                                                                            Visibility="{Binding Task.HasPersons, Converter={StaticResource BoolToVisible}}">
                                                                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                    <TextBlock Text="{Binding Task.PersonsText}" FontSize="10" FontWeight="Medium"
                                                                                               MaxWidth="64" TextTrimming="CharacterEllipsis"
                                                                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0"
                                                                                            ToolTip="{Binding Task.LocationsText}"
                                                                                            Visibility="{Binding Task.HasLocations, Converter={StaticResource BoolToVisible}}">
                                                                                    <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                    <TextBlock Text="{Binding Task.LocationsText}" FontSize="10" FontWeight="Medium"
                                                                                               MaxWidth="64" TextTrimming="CharacterEllipsis"
                                                                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <!-- 上下边缘调整时间热区（以 5 分钟为单位） -->
                                                                        <Border x:Name="topResize" Tag="blockTopEdge" Height="5" VerticalAlignment="Top"
                                                                                Background="Transparent" Cursor="SizeNS" Panel.ZIndex="10">
                                                                            <Border x:Name="topGrip" Height="2" VerticalAlignment="Top" Margin="10,1,10,0"
                                                                                    CornerRadius="1" Background="{DynamicResource Accent}" Opacity="0"
                                                                                    IsHitTestVisible="False"/>
                                                                        </Border>
                                                                        <Border x:Name="bottomResize" Tag="blockBottomEdge" Height="5" VerticalAlignment="Bottom"
                                                                                Background="Transparent" Cursor="SizeNS" Panel.ZIndex="10">
                                                                            <Border x:Name="bottomGrip" Height="2" VerticalAlignment="Bottom" Margin="10,0,10,1"
                                                                                    CornerRadius="1" Background="{DynamicResource Accent}" Opacity="0"
                                                                                    IsHitTestVisible="False"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <Trigger SourceName="topResize" Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="topGrip" Property="Opacity" Value="0.85"/>
                                                                    </Trigger>
                                                                    <Trigger SourceName="bottomResize" Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bottomGrip" Property="Opacity" Value="0.85"/>
                                                                    </Trigger>
                                                                    <Trigger SourceName="blk" Property="IsMouseOver" Value="True">
                                                                        <Trigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="blkHover" Storyboard.TargetProperty="Opacity"
                                                                                                     To="1" Duration="{StaticResource DurXs}" EasingFunction="{StaticResource EaseOut}"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.EnterActions>
                                                                        <Trigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="blkHover" Storyboard.TargetProperty="Opacity"
                                                                                                     To="0" Duration="{StaticResource DurXs}" EasingFunction="{StaticResource EaseOut}"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.ExitActions>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                                                        <Setter TargetName="blk" Property="Opacity" Value="0.5"/>
                                                                        <Setter TargetName="blkTitle" Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter TargetName="blkSingleTitle" Property="TextDecorations" Value="Strikethrough"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSingleLine}" Value="True">
                                                                        <Setter TargetName="blkContent" Property="Visibility" Value="Collapsed"/>
                                                                        <Setter TargetName="blkSingleLine" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                                                        <Setter TargetName="blkContent" Property="Margin" Value="6,2"/>
                                                                        <Setter TargetName="blkTitle" Property="FontSize" Value="11"/>
                                                                        <Setter TargetName="blkTime" Property="FontSize" Value="10"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSmallBlock}" Value="True">
                                                                        <Setter TargetName="topResize" Property="Height" Value="4"/>
                                                                        <Setter TargetName="bottomResize" Property="Height" Value="4"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 当前时刻红线（分钟级：跨全宽淡红线 + 今日列高亮实线与圆点） -->
                                <Canvas IsHitTestVisible="False">
                                    <Border Canvas.Top="{Binding NowLineTop}" Canvas.Left="0"
                                            Width="{Binding TimelineWidth}" Height="1"
                                            Background="{DynamicResource Danger}" Opacity="0.45"/>
                                    <Border Canvas.Top="{Binding NowLineTop}" Canvas.Left="{Binding NowTodayLeft}"
                                            Width="160" Height="1.5" Margin="0,-0.25,0,0"
                                            Background="{DynamicResource Danger}"/>
                                    <Ellipse Canvas.Top="{Binding NowDotTop}" Canvas.Left="{Binding NowTodayLeft}"
                                             Width="7" Height="7" Margin="-3.5,0,0,0"
                                             Fill="{DynamicResource Danger}"/>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
</Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="GoalsPageTemplate" TargetType="ContentControl">
            <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14" MaxWidth="620" HorizontalAlignment="Left">
                                <TextBox x:Name="GoalInput" Style="{StaticResource SubtleInput}" Height="38"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding GoalInput, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="GoalInput_KeyDown"/>
                                <TextBlock Text="新建目标，回车确认（比如「学 Python」或「发小论文」）"
                                           IsHitTestVisible="False" VerticalAlignment="Center"
                                           Margin="9,0,0,0" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextDisabled}"
                                           Visibility="{Binding Text, ElementName=GoalInput, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                            </Grid>

                            <ScrollViewer x:Name="GoalsPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,0,20">
                                    <ItemsControl x:Name="ActiveGoalsHost" ItemsSource="{Binding ActiveGoals}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <core:ResponsiveGridPanel MinColumnWidth="268" ColumnGap="12" RowGap="12"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="core:ResponsiveGridPanel.ColumnSpan" Value="{Binding CardColumnSpan}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:GoalVM}">
                                                <Border x:Name="goalPageCard" Tag="goalpagecard"
                                                        Style="{StaticResource GridCard}"
                                                        Height="{Binding CardHeight}"
                                                        MaxWidth="{Binding CardMaxWidth}"
                                                        HorizontalAlignment="Stretch"
                                                        Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                                                        AutomationProperties.Name="{Binding Title}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- 卡片头部：色点 + 标题 + 结构编辑/重置/查看按钮 -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="8" Height="8" Fill="{Binding Color}"
                                                                     VerticalAlignment="Center" Margin="0,1,8,0"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBox Style="{StaticResource TitleEditor}"
                                                                         HorizontalAlignment="Left" MinWidth="32"
                                                                         VerticalAlignment="Center" Cursor="IBeam"
                                                                         ToolTip="点击名称可重命名"
                                                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <Border x:Name="subGoalBadge" Visibility="Collapsed"
                                                                        Background="{DynamicResource Surface3}" CornerRadius="4"
                                                                        Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Nodes.Count, StringFormat={}{0} 个子目标}"
                                                                               FontSize="10.5" FontWeight="Medium"
                                                                               Foreground="{DynamicResource TextTertiary}"
                                                                               Typography.NumeralAlignment="Tabular"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                <Button Style="{StaticResource GhostButton}"
                                                                        Padding="7,3" FontSize="11.5" Margin="0,0,2,0"
                                                                        ToolTip="编辑子目标结构树"
                                                                        Tag="{Binding}" Click="OpenGoalTreeEditor_Click">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE8A1;" FontFamily="{StaticResource IconFont}"
                                                                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="编辑目标树" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button x:Name="resetViewBtn" Style="{StaticResource GhostButton}"
                                                                        Padding="7,3" FontSize="11.5" Margin="0,0,2,0"
                                                                        Content="重置视图" Visibility="Collapsed"
                                                                        ToolTip="回到 100% 初始视角"
                                                                        Tag="{Binding}" Click="ResetGoalCanvas_Click"/>
                                                                <Button Style="{StaticResource GhostButton}"
                                                                        Padding="7,3" FontSize="11.5"
                                                                        Content="查看日程" ToolTip="查看该目标下的全部日程"
                                                                        Tag="{Binding}" Click="OpenGoalDetail_Click"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- 简单卡片：仅显示居中进度条 -->
                                                        <Grid x:Name="simpleProgressBar" Grid.Row="1" Height="4" VerticalAlignment="Center"
                                                              Margin="0,8,0,8">
                                                            <Border Background="{DynamicResource BorderSubtle}" CornerRadius="2"/>
                                                            <Border Background="{DynamicResource Accent}" CornerRadius="2"
                                                                    HorizontalAlignment="Left">
                                                                <Border.Width>
                                                                    <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                                        <Binding ElementName="simpleProgressBar" Path="ActualWidth"/>
                                                                        <Binding Path="Progress"/>
                                                                    </MultiBinding>
                                                                </Border.Width>
                                                            </Border>
                                                        </Grid>

                                                        <!-- 导图大卡片：内嵌可缩放拖拽的目标结构树 -->
                                                        <Grid x:Name="goalCanvasSection" Grid.Row="1" Margin="0,8,0,8" Visibility="Collapsed">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="3"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid x:Name="treeProgressBar" Grid.Row="0" Height="3" Margin="0,0,0,0">
                                                                <Border Background="{DynamicResource BorderSubtle}" CornerRadius="2"/>
                                                                <Border Background="{DynamicResource Accent}" CornerRadius="2"
                                                                        HorizontalAlignment="Left">
                                                                    <Border.Width>
                                                                        <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                                            <Binding ElementName="treeProgressBar" Path="ActualWidth"/>
                                                                            <Binding Path="Progress"/>
                                                                        </MultiBinding>
                                                                    </Border.Width>
                                                                </Border>
                                                            </Grid>

                                                            <Border x:Name="goalCanvasViewport" Grid.Row="1" Tag="goalcanvas"
                                                                    Margin="0,6,0,0" CornerRadius="8"
                                                                    Background="{DynamicResource Surface3}"
                                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                                    ClipToBounds="True" Cursor="Hand"
                                                                    PreviewMouseWheel="GoalCardCanvas_PreviewMouseWheel"
                                                                    MouseLeave="GoalCardCanvas_MouseLeave">
                                                                <Grid>
                                                                    <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                                                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                                                        <Canvas.RenderTransform>
                                                                            <TransformGroup>
                                                                                <ScaleTransform ScaleX="{Binding ViewZoom}" ScaleY="{Binding ViewZoom}"/>
                                                                                <TranslateTransform X="{Binding ViewPanX}" Y="{Binding ViewPanY}"/>
                                                                            </TransformGroup>
                                                                        </Canvas.RenderTransform>

                                                                        <!-- 有向边（归属实线 / 递进虚线箭头） -->
                                                                        <ItemsControl ItemsSource="{Binding Edges}" IsHitTestVisible="False">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <Canvas/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate DataType="{x:Type vm:GoalEdgeVM}">
                                                                                    <Canvas>
                                                                                        <Path x:Name="edgeLine" Data="{Binding LineGeometry}"
                                                                                              Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.5"/>
                                                                                        <Path x:Name="edgeArrow" Data="{Binding ArrowGeometry}"
                                                                                              Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                                                                                    </Canvas>
                                                                                    <DataTemplate.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsProgress}" Value="True">
                                                                                            <Setter TargetName="edgeLine" Property="Stroke" Value="{DynamicResource Accent}"/>
                                                                                            <Setter TargetName="edgeLine" Property="StrokeDashArray" Value="4 2"/>
                                                                                            <Setter TargetName="edgeArrow" Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </DataTemplate.Triggers>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <!-- 节点 -->
                                                                        <ItemsControl ItemsSource="{Binding AllCanvasNodes}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <Canvas/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemContainerStyle>
                                                                                <Style TargetType="ContentPresenter">
                                                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                                                </Style>
                                                                            </ItemsControl.ItemContainerStyle>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate DataType="{x:Type vm:GoalNodeVM}">
                                                                                    <Border x:Name="nodeBox" Tag="goalcardnode"
                                                                                            Width="{Binding Width}" Height="{Binding Height}"
                                                                                            Background="{DynamicResource Surface2}"
                                                                                            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                                                                                            CornerRadius="6" Padding="8,5" Cursor="Hand"
                                                                                            MouseEnter="GoalCardNode_MouseEnter"
                                                                                            MouseLeave="GoalCardNode_MouseLeave">
                                                                                        <Grid>
                                                                                            <Grid.RowDefinitions>
                                                                                                <RowDefinition Height="*"/>
                                                                                                <RowDefinition Height="Auto"/>
                                                                                            </Grid.RowDefinitions>
                                                                                            <Border x:Name="nodeTint" Grid.RowSpan="2"
                                                                                                    CornerRadius="5" Margin="-8,-5"
                                                                                                    Background="Transparent" IsHitTestVisible="False"/>
                                                                                            <Grid Grid.Row="0">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <Ellipse x:Name="rootDot" Width="6" Height="6" Fill="{Binding Owner.Color}"
                                                                                                         VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                                                                                <TextBlock x:Name="doneTick" Grid.Column="0" Text="&#xE73E;"
                                                                                                           FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                                                           Foreground="{DynamicResource Success}"
                                                                                                           VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Collapsed"/>
                                                                                                <TextBlock x:Name="nodeTitle" Grid.Column="1" Text="{Binding DisplayTitle}"
                                                                                                           FontSize="12" FontWeight="SemiBold"
                                                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                                                                <Border Grid.Column="2" Background="{DynamicResource Surface3}" CornerRadius="4"
                                                                                                        Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                                                        Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisible}}">
                                                                                                    <TextBlock Text="{Binding TaskBadgeText}" FontSize="10" FontWeight="Medium"
                                                                                                               Foreground="{DynamicResource TextTertiary}"
                                                                                                               Typography.NumeralAlignment="Tabular"/>
                                                                                                </Border>
                                                                                            </Grid>
                                                                                            <StackPanel x:Name="cardDueRow" Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0"
                                                                                                        Visibility="{Binding HasDue, Converter={StaticResource BoolToVisible}}">
                                                                                                <TextBlock x:Name="cardDueIcon" Text="&#xE787;"
                                                                                                           FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                                                <TextBlock x:Name="cardDueText" Text="{Binding DueBadgeText}"
                                                                                                           FontSize="10" FontWeight="Medium"
                                                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                                                           VerticalAlignment="Center"
                                                                                                           Typography.NumeralAlignment="Tabular"/>
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <DataTemplate.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                                                            <Setter TargetName="rootDot" Property="Visibility" Value="Visible"/>
                                                                                            <Setter TargetName="nodeBox" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsDueOverdue}" Value="True">
                                                                                            <Setter TargetName="cardDueIcon" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                                                            <Setter TargetName="cardDueText" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                            <Setter TargetName="doneTick" Property="Visibility" Value="Visible"/>
                                                                                            <Setter TargetName="nodeTint" Property="Background" Value="{DynamicResource SuccessTint}"/>
                                                                                            <Setter TargetName="nodeBox" Property="BorderBrush" Value="{DynamicResource Success}"/>
                                                                                            <Setter TargetName="nodeTitle" Property="TextDecorations" Value="Strikethrough"/>
                                                                                            <Setter TargetName="nodeTitle" Property="Opacity" Value="0.72"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                                                                            <Setter TargetName="nodeBox" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                                        </DataTrigger>
                                                                                    </DataTemplate.Triggers>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <!-- 连线文字说明标签（只读展示，置顶防遮挡） -->
                                                                        <ItemsControl ItemsSource="{Binding Edges}" IsHitTestVisible="False">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <Canvas/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemContainerStyle>
                                                                                <Style TargetType="ContentPresenter">
                                                                                    <Setter Property="Canvas.Left" Value="{Binding MidX}"/>
                                                                                    <Setter Property="Canvas.Top" Value="{Binding MidY}"/>
                                                                                </Style>
                                                                            </ItemsControl.ItemContainerStyle>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate DataType="{x:Type vm:GoalEdgeVM}">
                                                                                    <Grid Width="220" Height="40" Margin="-110,-20,0,0" Background="{x:Null}"
                                                                                          Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisible}}">
                                                                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                Background="{DynamicResource Surface4}"
                                                                                                BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                                                                                                CornerRadius="8" Padding="6,1.5">
                                                                                            <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="Medium"
                                                                                                       MaxWidth="130" TextTrimming="CharacterEllipsis"
                                                                                                       Foreground="{DynamicResource TextSecondary}"/>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Canvas>

                                                                    <!-- 节点悬停具体信息浮层（固定视口字号，不随画布缩放失真） -->
                                                                    <Canvas>
                                                                        <Border x:Name="goalHoverPopover" Tag="goalhoverpopover"
                                                                                Canvas.Left="{Binding HoverAnchorX}" Canvas.Top="{Binding HoverAnchorY}"
                                                                                Width="228" Padding="10,8" CornerRadius="8"
                                                                                Background="{DynamicResource Surface4}"
                                                                                BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                                                                                Visibility="{Binding HasHoveredNode, Converter={StaticResource BoolToVisible}}"
                                                                                MouseEnter="GoalCardHoverPopover_MouseEnter"
                                                                                MouseLeave="GoalCardHoverPopover_MouseLeave">
                                                                            <Border.Effect>
                                                                                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.22"/>
                                                                            </Border.Effect>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding HoveredNode.DisplayTitle}"
                                                                                           FontSize="12.5" FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                                                <TextBlock Text="{Binding HoveredNode.HoverStatusText}"
                                                                                           Style="{StaticResource Caption}" Margin="0,2,0,6"/>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Button Style="{StaticResource GhostButton}"
                                                                                            Padding="7,3" FontSize="11.5" Margin="0,0,4,0"
                                                                                            Foreground="{DynamicResource Accent}"
                                                                                            Content="{Binding HoveredNode.CompleteActionText}"
                                                                                            Tag="{Binding HoveredNode}"
                                                                                            Click="GoalCardNodeToggleComplete_Click"/>
                                                                                    <Button Style="{StaticResource GhostButton}"
                                                                                            Padding="7,3" FontSize="11.5" Margin="0,0,4,0"
                                                                                            Content="查看日程"
                                                                                            Tag="{Binding HoveredNode}"
                                                                                            Click="GoalCardNodeDetail_Click"/>
                                                                                    <Button Style="{StaticResource GhostButton}"
                                                                                            Padding="6,3" FontSize="11"
                                                                                            FontFamily="{StaticResource IconFont}"
                                                                                            Content="&#xE787;" ToolTip="设置节点截止日期"
                                                                                            Tag="{Binding HoveredNode}"
                                                                                            Click="GoalCardNodeSetDue_Click"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Canvas>

                                                                    <!-- 缩放与操作提示 -->
                                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                            Margin="0,0,8,6" Padding="7,2" CornerRadius="4"
                                                                            Background="{DynamicResource Surface4}"
                                                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                                            Opacity="0.88" IsHitTestVisible="False">
                                                                        <TextBlock FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextTertiary}"
                                                                                   Typography.NumeralAlignment="Tabular">
                                                                            <Run Text="{Binding ZoomLabel, Mode=OneWay}"/>
                                                                            <Run Text=" · 拖拽节点 · 滚轮缩放 · 右键/空格拖画布"/>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>

                                                        <!-- 卡片底部：进度 + 截止日期 + 标记完成 + 删除 -->
                                                        <Grid Grid.Row="2">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProgressText}"
                                                                           Style="{StaticResource Caption}"
                                                                           VerticalAlignment="Center"/>
                                                                <Button Style="{StaticResource GhostButton}"
                                                                        Padding="6,2" Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip="设置或修改该目标的截止日期"
                                                                        Tag="{Binding}" Click="GoalCardSetDue_Click">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock x:Name="goalCardDueIcon" Text="&#xE787;"
                                                                                   FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                        <TextBlock x:Name="goalCardDueLabel" Text="{Binding DueBadgeText}"
                                                                                   FontSize="11" FontWeight="Medium"
                                                                                   Foreground="{DynamicResource Accent}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Style="{StaticResource GhostButton}" Content="标记完成"
                                                                        Padding="8,4" Margin="0,0,2,0"
                                                                        Foreground="{DynamicResource Accent}"
                                                                        Tag="{Binding}" Click="ToggleGoalComplete_Click"/>
                                                                <Button Style="{StaticResource GhostButton}"
                                                                        Content="删除" Foreground="{DynamicResource TextTertiary}"
                                                                        Tag="{Binding}" Click="DeleteGoal_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HasDue}" Value="False">
                                                        <Setter TargetName="goalCardDueLabel" Property="Text" Value="设截止日"/>
                                                        <Setter TargetName="goalCardDueLabel" Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                                        <Setter TargetName="goalCardDueIcon" Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDueOverdue}" Value="True">
                                                        <Setter TargetName="goalCardDueLabel" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                        <Setter TargetName="goalCardDueIcon" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasSubGoals}" Value="True">
                                                        <Setter TargetName="simpleProgressBar" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="goalCanvasSection" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="resetViewBtn" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="subGoalBadge" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="goalPageCard" Property="Cursor" Value="Arrow"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 下方独立区域：已完成目标 -->
                                    <StackPanel Margin="0,24,0,0"
                                                Visibility="{Binding HasCompletedGoals, Converter={StaticResource BoolToVisible}}">
                                        <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                                                Padding="0,16,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="已完成目标" Style="{StaticResource Eyebrow}" FontSize="13"/>
                                                <TextBlock Text="{Binding CompletedGoals.Count}" Style="{StaticResource Eyebrow}"
                                                           Foreground="{DynamicResource TextTertiary}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding CompletedGoals}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <core:ResponsiveGridPanel MinColumnWidth="268" ColumnGap="12" RowGap="12"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:GoalVM}">
                                                    <Border Style="{StaticResource GridCard}" Height="116" Opacity="0.82"
                                                            AutomationProperties.Name="{Binding Title}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Width="8" Height="8" Fill="{Binding Color}"
                                                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                <TextBlock Grid.Column="1" Text="&#xE73E;"
                                                                           FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                           Foreground="{DynamicResource Success}"
                                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                                           Style="{StaticResource CardTitle}"
                                                                           TextDecorations="Strikethrough"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>

                                                            <TextBlock Grid.Row="1" Text="{Binding ProgressText}"
                                                                       Style="{StaticResource Caption}" VerticalAlignment="Center"/>

                                                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Style="{StaticResource GhostButton}" Content="恢复未完成"
                                                                        Padding="8,3" Margin="0,0,2,0"
                                                                        Tag="{Binding}" Click="ToggleGoalComplete_Click"/>
                                                                <Button Style="{StaticResource GhostButton}" Content="查看日程"
                                                                        Padding="8,3" Margin="0,0,2,0"
                                                                        Tag="{Binding}" Click="OpenGoalDetail_Click"/>
                                                                <Button Style="{StaticResource GhostButton}" Content="删除"
                                                                        Padding="8,3" Foreground="{DynamicResource TextTertiary}"
                                                                        Tag="{Binding}" Click="DeleteGoal_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="TagsPageTemplate" TargetType="ContentControl">
            <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ToggleButton Style="{StaticResource SegmentButton}" Content="标签" Tag="Tags"
                                                  AutomationProperties.Name="标签"
                                                  AutomationProperties.AutomationId="TagsTabButton"
                                                  IsChecked="{Binding IsTagTabTags, Mode=OneWay}"
                                                  Click="TagPageTab_Click"/>
                                    <ToggleButton Style="{StaticResource SegmentButton}" Content="人物" Tag="Persons"
                                                  AutomationProperties.Name="人物"
                                                  AutomationProperties.AutomationId="PersonsTabButton"
                                                  IsChecked="{Binding IsTagTabPersons, Mode=OneWay}"
                                                  Click="TagPageTab_Click"/>
                                    <ToggleButton Style="{StaticResource SegmentButton}" Content="地点" Tag="Locations"
                                                  AutomationProperties.Name="地点"
                                                  AutomationProperties.AutomationId="LocationsTabButton"
                                                  IsChecked="{Binding IsTagTabLocations, Mode=OneWay}"
                                                  Click="TagPageTab_Click"/>
                                </StackPanel>

                                <Grid MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="420"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="TagEntityInputBox" Style="{StaticResource SubtleInput}" Height="36"
                                                 VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="新建标签人物或地点输入框"
                                                 AutomationProperties.AutomationId="TagEntityInputBox"
                                                 Text="{Binding TagEntityInput, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="TagEntityInput_KeyDown"/>
                                        <TextBlock Text="{Binding TagEntityPlaceholder}"
                                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                                   Margin="9,0,0,0" FontSize="12.5" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextDisabled}"
                                                   Visibility="{Binding Text, ElementName=TagEntityInputBox, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                    </Grid>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                            Content="{Binding TagEntityButtonText}"
                                            Height="36" Padding="14,0" Margin="8,0,0,0" FontSize="12.5"
                                            AutomationProperties.Name="{Binding TagEntityButtonText}"
                                            AutomationProperties.AutomationId="TagEntityCreateButton"
                                            Click="SubmitTagEntity_Click"/>
                                </Grid>

                                <TextBlock MaxWidth="760" HorizontalAlignment="Left"
                                           Text="{Binding TagPageBlurb}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding IsTagTabTags, Converter={StaticResource BoolToVisible}}">
                                    <ItemsControl ItemsSource="{Binding TagRows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <core:ResponsiveGridPanel MinColumnWidth="224" ColumnGap="12" RowGap="10"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TagRowVM}">
                                                <Border x:Name="tagCard" Tag="tagcard"
                                                        Style="{StaticResource GridCard}"
                                                        Height="80" Padding="14,11" Cursor="Hand"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        ToolTip="点击查看该标签下的日程"
                                                        AutomationProperties.Name="{Binding Tag.Name}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0"
                                                                    Style="{StaticResource GhostButton}"
                                                                    Width="22" Height="22" Padding="0"
                                                                    Margin="-6,1,4,0"
                                                                    VerticalAlignment="Center"
                                                                    Tag="{Binding Tag}"
                                                                    ToolTip="点击更换标签颜色"
                                                                    AutomationProperties.Name="更换标签颜色"
                                                                    Click="TagColorDot_Click">
                                                                <Ellipse Width="10" Height="10" Fill="{Binding Tag.Color}"/>
                                                            </Button>
                                                            <TextBox Grid.Column="1" Style="{StaticResource TitleEditor}"
                                                                     FontSize="15.5" FontWeight="Bold"
                                                                     HorizontalAlignment="Left" MinWidth="32"
                                                                     VerticalAlignment="Center" Cursor="IBeam"
                                                                     ToolTip="点击名称可重命名"
                                                                     GotFocus="EntityNameBox_GotFocus" LostFocus="EntityNameBox_LostFocus"
                                                                     KeyDown="EntityNameBox_KeyDown"
                                                                     Text="{Binding Tag.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                                       FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                       Foreground="{DynamicResource TextTertiary}"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </Grid>

                                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding CountText}"
                                                                       FontSize="12.5" FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                            <Button x:Name="deleteBtn" Grid.Column="1"
                                                                    Style="{StaticResource GhostButton}"
                                                                    FontFamily="{StaticResource IconFont}"
                                                                    FontSize="12" Content="&#xE74D;"
                                                                    Padding="6,4" Margin="6,0,0,0"
                                                                    Opacity="0"
                                                                    Foreground="{DynamicResource TextTertiary}"
                                                                    Tag="{Binding Tag}"
                                                                    ToolTip="从所有日程上拿掉这个标签"
                                                                    AutomationProperties.Name="删除标签"
                                                                    Click="DeleteTagRow_Click"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="tagCard" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="deleteBtn" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid Visibility="{Binding IsTagTabPersons, Converter={StaticResource BoolToVisible}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding PersonRows}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <core:ResponsiveGridPanel MinColumnWidth="224" ColumnGap="12" RowGap="10"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:PersonRowVM}">
                                                    <Border x:Name="personCard" Tag="personcard"
                                                            Style="{StaticResource GridCard}"
                                                            Height="80" Padding="14,11" Cursor="Hand"
                                                            RenderTransformOrigin="0.5,0.5"
                                                            ToolTip="点击查看该人物关联的日程"
                                                            AutomationProperties.Name="{Binding Person.Name}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="14.5"
                                                                           Foreground="{DynamicResource TextSecondary}"
                                                                           VerticalAlignment="Center" Margin="0,1,9,0"/>
                                                                <TextBox Grid.Column="1" Style="{StaticResource TitleEditor}"
                                                                         FontSize="15.5" FontWeight="Bold"
                                                                         HorizontalAlignment="Left" MinWidth="32"
                                                                         VerticalAlignment="Center" Cursor="IBeam"
                                                                         ToolTip="点击名称可重命名"
                                                                         GotFocus="EntityNameBox_GotFocus" LostFocus="EntityNameBox_LostFocus"
                                                                         KeyDown="EntityNameBox_KeyDown"
                                                                         Text="{Binding Person.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                                           FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            </Grid>

                                                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding CountText}"
                                                                           FontSize="12.5" FontWeight="Medium"
                                                                           Foreground="{DynamicResource TextSecondary}"
                                                                           Typography.NumeralAlignment="Tabular"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>
                                                                <Button x:Name="deleteBtn" Grid.Column="1"
                                                                        Style="{StaticResource GhostButton}"
                                                                        FontFamily="{StaticResource IconFont}"
                                                                        FontSize="12" Content="&#xE74D;"
                                                                        Padding="6,4" Margin="6,0,0,0"
                                                                        Opacity="0"
                                                                        Foreground="{DynamicResource TextTertiary}"
                                                                        Tag="{Binding Person}"
                                                                        ToolTip="从所有日程上移除该人物"
                                                                        AutomationProperties.Name="删除人物"
                                                                        Click="DeletePersonRow_Click"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="personCard" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="deleteBtn" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding PersonRows.Count, Converter={StaticResource ZeroToVisible}}">
                                        <TextBlock Text="还没有人物" FontSize="15" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="在上方输入框直接新建，或在日程弹窗中关联人物"
                                                   Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Visibility="{Binding IsTagTabLocations, Converter={StaticResource BoolToVisible}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding LocationRows}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <core:ResponsiveGridPanel MinColumnWidth="224" ColumnGap="12" RowGap="10"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:LocationRowVM}">
                                                    <Border x:Name="locationCard" Tag="locationcard"
                                                            Style="{StaticResource GridCard}"
                                                            Height="80" Padding="14,11" Cursor="Hand"
                                                            RenderTransformOrigin="0.5,0.5"
                                                            ToolTip="点击查看该地点关联的日程"
                                                            AutomationProperties.Name="{Binding Location.Name}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="14.5"
                                                                           Foreground="{DynamicResource TextSecondary}"
                                                                           VerticalAlignment="Center" Margin="0,1,9,0"/>
                                                                <TextBox Grid.Column="1" Style="{StaticResource TitleEditor}"
                                                                         FontSize="15.5" FontWeight="Bold"
                                                                         HorizontalAlignment="Left" MinWidth="32"
                                                                         VerticalAlignment="Center" Cursor="IBeam"
                                                                         ToolTip="点击名称可重命名"
                                                                         GotFocus="EntityNameBox_GotFocus" LostFocus="EntityNameBox_LostFocus"
                                                                         KeyDown="EntityNameBox_KeyDown"
                                                                         Text="{Binding Location.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                                           FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            </Grid>

                                                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding CountText}"
                                                                           FontSize="12.5" FontWeight="Medium"
                                                                           Foreground="{DynamicResource TextSecondary}"
                                                                           Typography.NumeralAlignment="Tabular"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>
                                                                <Button x:Name="deleteBtn" Grid.Column="1"
                                                                        Style="{StaticResource GhostButton}"
                                                                        FontFamily="{StaticResource IconFont}"
                                                                        FontSize="12" Content="&#xE74D;"
                                                                        Padding="6,4" Margin="6,0,0,0"
                                                                        Opacity="0"
                                                                        Foreground="{DynamicResource TextTertiary}"
                                                                        Tag="{Binding Location}"
                                                                        ToolTip="从所有日程上移除该地点"
                                                                        AutomationProperties.Name="删除地点"
                                                                        Click="DeleteLocationRow_Click"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="locationCard" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="deleteBtn" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding LocationRows.Count, Converter={StaticResource ZeroToVisible}}">
                                        <TextBlock Text="还没有地点" FontSize="15" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="在上方输入框直接新建，或在日程弹窗中关联地点"
                                                   Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="EisenhowerPageTemplate" TargetType="ContentControl">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,0,4,6">
                    <ToggleButton Style="{StaticResource FlagChip}"
                                  HorizontalAlignment="Right"
                                  Margin="0"
                                  Content="仅未来 3 天"
                                  IsChecked="{Binding EisenhowerNextThreeDaysOnly, Mode=TwoWay}"
                                  AutomationProperties.Name="仅未来 3 天"
                                  AutomationProperties.AutomationId="EisenhowerNextThreeDaysToggle"
                                  ToolTip="默认只加载未来三天内的未完成日程；取消勾选可查看全部未完成日程"/>
                </Grid>
                <ItemsControl x:Name="QuadrantsHost" ItemsSource="{Binding Quadrants}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" Rows="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QuadrantVM}">
                                    <Border x:Name="quad" Style="{StaticResource QuadCell}"
                                            Margin="4" Padding="12,10">
                                        <Grid>
                                            <Border x:Name="quadDropOverlay" Background="{DynamicResource AccentTint}"
                                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                                    CornerRadius="8" Margin="-12,-10" Opacity="0" IsHitTestVisible="False"/>
                                            <DockPanel>
                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Eyebrow}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Count}"
                                                               Style="{StaticResource Eyebrow}"
                                                               Foreground="{DynamicResource TextTertiary}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                                           Foreground="{DynamicResource TextDisabled}" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <Grid>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Padding="0,0,4,0">
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:TaskVM}">
                                                            <Border x:Name="row" Tag="boardrow"
                                                                    Style="{StaticResource CardBorder}"
                                                                    Width="228" Margin="0,0,8,8"
                                                                    RenderTransformOrigin="0.5,0.5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Width="6" Height="6" Fill="{Binding PrimaryGoalColor}"
                                                                             VerticalAlignment="Top" Margin="0,7,7,0"
                                                                             Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}"/>
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   Style="{StaticResource CardTitle}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <Grid Margin="0,1,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="&#xEA8F;"
                                                                                       FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                                                                       Foreground="{DynamicResource TextTertiary}"
                                                                                       VerticalAlignment="Center" Margin="0,0,5,0"
                                                                                       ToolTip="{Binding RemindTooltip}"
                                                                                       Visibility="{Binding ShowRemindBell, Converter={StaticResource BoolToVisible}}"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding MetaText}"
                                                                                       Style="{StaticResource Caption}"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                        <WrapPanel Margin="0,2,0,0"
                                                                                   Visibility="{Binding HasPeopleOrLocations, Converter={StaticResource BoolToVisible}}">
                                                                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                                                                        Visibility="{Binding HasPersons, Converter={StaticResource BoolToVisible}}">
                                                                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                                           VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                <TextBlock Text="{Binding PersonsText}" Style="{StaticResource Caption}"
                                                                                           MaxWidth="172" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <StackPanel Orientation="Horizontal"
                                                                                        Visibility="{Binding HasLocations, Converter={StaticResource BoolToVisible}}">
                                                                                <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                                           VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                <TextBlock Text="{Binding LocationsText}" Style="{StaticResource Caption}"
                                                                                           MaxWidth="172" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </WrapPanel>
                                                                        <ItemsControl ItemsSource="{Binding CompactGoalChips}"
                                                                                      ItemTemplate="{StaticResource CompactGoalChipTemplate}"
                                                                                      Margin="0,4,0,0"
                                                                                      Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                                    <Setter TargetName="row" Property="Opacity" Value="0.5"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </ScrollViewer>

                                                <Rectangle VerticalAlignment="Top" Height="48" RadiusX="6" RadiusY="6"
                                                           Stroke="{DynamicResource BorderStrong}" StrokeThickness="1"
                                                           StrokeDashArray="3 3" Opacity="0.45"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding Count, Converter={StaticResource ZeroToVisible}}"/>
                                            </Grid>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="quadDropOverlay" Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="{StaticResource DurXs}" EasingFunction="{StaticResource EaseOut}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="quadDropOverlay" Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="{StaticResource DurS}" EasingFunction="{StaticResource EaseOut}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
            </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="DeadlinesPageTemplate" TargetType="ContentControl">
            <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="截止日期" FontSize="16" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DeadlineCount}" Style="{StaticResource Eyebrow}"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="只设了截止日、不占具体时段的日程，以及设了截止日的目标与子目标，按日期分组。"
                                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="AddDeadlineButton" Grid.Column="1"
                                        Style="{StaticResource PrimaryButton}" Padding="12,6"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="新建截止事项"
                                        AutomationProperties.AutomationId="AddDeadlineButton"
                                        Click="AddDeadline_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="新建" FontSize="12.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="DeadlinesHost" ItemsSource="{Binding DeadlineGroups}"
                                                  Margin="0,0,0,16">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DeadlineDayGroupVM}">
                                                <StackPanel Margin="0,0,0,18">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock x:Name="groupHeader" Text="{Binding HeaderText}"
                                                                   FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource Eyebrow}"
                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                   VerticalAlignment="Center" Margin="8,2,0,0"/>
                                                    </StackPanel>

                                                    <ItemsControl ItemsSource="{Binding Goals}"
                                                                  Margin="0,0,0,8"
                                                                  Visibility="{Binding HasGoals, Converter={StaticResource BoolToVisible}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <core:ResponsiveGridPanel MinColumnWidth="252" ColumnGap="12" RowGap="8"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:DeadlineGoalItemVM}">
                                                                <Button Style="{StaticResource DeadlineGoalCardButton}"
                                                                        Tag="{Binding}"
                                                                        ToolTip="点击打开目标树编辑"
                                                                        AutomationProperties.Name="{Binding Title}"
                                                                        Click="DeadlineGoal_Click">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Ellipse Width="7" Height="7" Fill="{Binding Color}"
                                                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                                <TextBlock Text="{Binding SubLabel}" Style="{StaticResource Caption}"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock x:Name="goalDeadlineTimeText" Text="{Binding DueTimeText}"
                                                                                           FontSize="11.5" FontWeight="Medium"
                                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                           Typography.NumeralAlignment="Tabular"
                                                                                           Visibility="{Binding HasDueTime, Converter={StaticResource BoolToVisible}}"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                        <Border Grid.Column="2" Background="{DynamicResource Surface3}"
                                                                                CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                                                VerticalAlignment="Center"
                                                                                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisible}}">
                                                                            <TextBlock Text="{Binding ProgressText}" FontSize="11" FontWeight="Medium"
                                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                                       Typography.NumeralAlignment="Tabular"/>
                                                                        </Border>
                                                                        <TextBlock Grid.Column="3" Text="&#xE76C;"
                                                                                   FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                                   Foreground="{DynamicResource TextDisabled}"
                                                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                    </Grid>
                                                                </Button>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                        <Setter TargetName="goalDeadlineTimeText" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <ItemsControl ItemsSource="{Binding Tasks}"
                                                                  ItemTemplate="{StaticResource TaskCardTemplate}"
                                                                  Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisible}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <core:ResponsiveGridPanel MinColumnWidth="252" ColumnGap="12" RowGap="4"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter TargetName="groupHeader" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter TargetName="groupHeader" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding DeadlineCount, Converter={StaticResource ZeroToVisible}}">
                                    <TextBlock Text="没有待办截止事项" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="只设截止日不占时段的日程，以及设了截止日的目标会收在这里"
                                               Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="FuturePageTemplate" TargetType="ContentControl">
            <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="未来事项" FontSize="16" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FutureTaskCount}" Style="{StaticResource Eyebrow}"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="暂时没有明确日期、将来要做的事；确定时间后可右键移到今天/明天，或双击设定日期。"
                                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="AddFutureButton" Grid.Column="1"
                                        Style="{StaticResource PrimaryButton}" Padding="12,6"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="新建未来事项"
                                        AutomationProperties.AutomationId="AddFutureButton"
                                        Click="AddFuture_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="新建" FontSize="12.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="FutureHost" ItemsSource="{Binding FutureTasks}"
                                                  ItemTemplate="{StaticResource TaskCardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <core:ResponsiveGridPanel MinColumnWidth="252" ColumnGap="12" RowGap="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding FutureTaskCount, Converter={StaticResource ZeroToVisible}}">
                                    <TextBlock Text="还没有未来事项" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="把暂时没定日期的想法收在这里，不会稀释「之后」档位"
                                               Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="OverduePageTemplate" TargetType="ContentControl">
            <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="逾期" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Danger}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding OverdueLane.Count}" Style="{StaticResource Eyebrow}"
                                               Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center" Margin="8,2,0,0"/>
                                </StackPanel>
                                <TextBlock Text="已过截止日还没完成的日程；单击展开、双击弹窗编辑，右键可一键移到今天或明天。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="OverdueHost" ItemsSource="{Binding OverdueLane.Items}"
                                                  ItemTemplate="{StaticResource TaskCardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <core:ResponsiveGridPanel MinColumnWidth="252" ColumnGap="12" RowGap="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding OverdueLane.Count, Converter={StaticResource ZeroToVisible}}">
                                    <TextBlock Text="没有逾期的日程" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="所有日程都在掌控之中" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="TagDetailBodyTemplate" TargetType="ContentControl">
            <DockPanel>
                    <!-- 顶部栏 -->
                    <Border DockPanel.Dock="Top" Padding="20,14,14,12"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{Binding DetailColor}"
                                         VerticalAlignment="Center" Margin="0,1,9,0"
                                         Visibility="{Binding DetailHasColorDot, Converter={StaticResource BoolToVisible}}"/>
                                <TextBlock Text="{Binding DetailIconGlyph}"
                                           FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" Margin="0,1,8,0"
                                           Visibility="{Binding DetailHasIcon, Converter={StaticResource BoolToVisible}}"/>
                                <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TagDetailTotalText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="10,2,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="滚轮横向滚动 · 双击日程编辑" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextDisabled}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Style="{StaticResource GhostButton}" Content="回到今天"
                                        Padding="9,4" Margin="0,0,6,0"
                                        AutomationProperties.Name="回到今天"
                                        AutomationProperties.AutomationId="TagDetailTodayButton"
                                        Click="TagDetailToday_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="&#xE711;"
                                        FontFamily="{StaticResource IconFont}" FontSize="11"
                                        ToolTip="关闭（Esc）"
                                        AutomationProperties.Name="关闭"
                                        AutomationProperties.AutomationId="TagDetailCloseButton"
                                        Click="TagDetailClose_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 横向日期条状流 + 底部横向滚动条 -->
                    <ScrollViewer x:Name="TagDetailScroll"
                                  HorizontalScrollBarVisibility="Visible"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="8,0,8,6" Padding="0,0,0,4">
                        <ItemsControl x:Name="TagDetailDaysHost" ItemsSource="{Binding TagDetailDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagDayColumnVM}">
                                    <Border Width="188" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
                                        <Grid>
                                            <Border Background="{DynamicResource AccentTint}" Opacity="0.22"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding IsToday, Converter={StaticResource BoolToVisible}}"/>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Padding="12,10,12,8"
                                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="tagDayName" Text="{Binding DayName}"
                                                                       Style="{StaticResource Eyebrow}" FontSize="13.5"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="tagDayNumber" Text="{Binding DayNumber}"
                                                                       Style="{StaticResource Caption}" FontSize="12.5"
                                                                       VerticalAlignment="Center" Margin="7,0,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Count}"
                                                                   Style="{StaticResource Eyebrow}"
                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding HasItems, Converter={StaticResource BoolToVisible}}"/>
                                                    </Grid>
                                                </Border>

                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Padding="8,10,8,10">
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:TaskVM}">
                                                                <Border x:Name="tagTaskCard" Tag="tagtaskcard"
                                                                        Style="{StaticResource CardBorder}"
                                                                        RenderTransformOrigin="0.5,0.5"
                                                                        ToolTip="双击编辑日程">
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="标记完成 / 取消" Click="MenuToggleDone_Click"/>
                                                                            <MenuItem Header="移到今天" Click="MenuMoveToday_Click"/>
                                                                            <MenuItem Header="移到明天" Click="MenuMoveTomorrow_Click"/>
                                                                            <Separator/>
                                                                            <MenuItem Header="删除" Click="MenuDelete_Click"/>
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <ToggleButton Grid.Column="0" Style="{StaticResource CheckDot}"
                                                                                      IsChecked="{Binding Done, Mode=OneWay}"
                                                                                      VerticalAlignment="Top" Margin="0,2,8,0"
                                                                                      Click="Check_Click"/>

                                                                        <StackPanel Grid.Column="1">
                                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                                <TextBlock x:Name="tagTaskTime" Text="{Binding TimeLabel}"
                                                                                           FontSize="11" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource Accent}"
                                                                                           VerticalAlignment="Center"
                                                                                           Typography.NumeralAlignment="Tabular"/>
                                                                                <TextBlock Text="&#xEA8F;"
                                                                                           FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                                           VerticalAlignment="Center" Margin="5,0,0,0"
                                                                                           ToolTip="{Binding RemindTooltip}"
                                                                                           Visibility="{Binding ShowRemindBell, Converter={StaticResource BoolToVisible}}"/>
                                                                            </StackPanel>

                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Ellipse Width="6" Height="6" Fill="{Binding PrimaryGoalColor}"
                                                                                         VerticalAlignment="Top" Margin="0,6,6,0"
                                                                                         Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}"/>
                                                                                <TextBlock x:Name="tagTaskTitle" Grid.Column="1"
                                                                                           Text="{Binding Title}"
                                                                                           Style="{StaticResource CardTitle}"
                                                                                           FontSize="13"/>
                                                                            </Grid>

                                                                            <StackPanel Margin="0,2,0,0"
                                                                                        Visibility="{Binding HasPeopleOrLocations, Converter={StaticResource BoolToVisible}}">
                                                                                <Grid Visibility="{Binding HasPersons, Converter={StaticResource BoolToVisible}}">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Grid.Column="0" Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                                                               Foreground="{DynamicResource TextTertiary}"
                                                                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                    <TextBlock Grid.Column="1" Text="{Binding PersonsText}" Style="{StaticResource Caption}"
                                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                                <Grid Visibility="{Binding HasLocations, Converter={StaticResource BoolToVisible}}">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Grid.Column="0" Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                                                                               Foreground="{DynamicResource TextTertiary}"
                                                                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                                    <TextBlock Grid.Column="1" Text="{Binding LocationsText}" Style="{StaticResource Caption}"
                                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </StackPanel>

                                                                            <ItemsControl ItemsSource="{Binding CompactGoalChips}"
                                                                                          ItemTemplate="{StaticResource CompactGoalChipTemplate}"
                                                                                          Margin="0,4,0,0"
                                                                                          Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                            </ItemsControl>

                                                                            <TextBlock Text="{Binding Note}"
                                                                                       Style="{StaticResource Caption}"
                                                                                       TextWrapping="Wrap" MaxHeight="34"
                                                                                       Margin="0,3,0,0"
                                                                                       Visibility="{Binding Note, Converter={StaticResource EmptyToCollapsed}}"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding HasTime}" Value="False">
                                                                        <Setter TargetName="tagTaskTime" Property="Text" Value="未设时刻"/>
                                                                        <Setter TargetName="tagTaskTime" Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                                                        <Setter TargetName="tagTaskCard" Property="Opacity" Value="0.5"/>
                                                                        <Setter TargetName="tagTaskTitle" Property="TextDecorations" Value="Strikethrough"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="tagDayName" Property="Foreground" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="tagDayNumber" Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="FocusPageTemplate" TargetType="ContentControl">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,16">
                <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch">
                    <!-- 顶部标题 -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="专注" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="今日时段日程到点自动开始倒计时；不定时长的工作可随时开启自由正计时"
                                       Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="10,6" Click="ToggleFocusMini_Click"
                                AutomationProperties.AutomationId="FocusPageMiniToggle">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="呼出 / 隐藏迷你悬浮窗" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 主计时英雄卡 -->
                    <Border Background="{DynamicResource Surface2}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="8" Padding="24,20">
                        <Grid>
                            <!-- 进行中状态 -->
                            <StackPanel Visibility="{Binding Focus.IsActive, Converter={StaticResource BoolToVisible}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource Surface3}" CornerRadius="4"
                                                    Padding="8,3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="heroDot" Width="7" Height="7" Fill="{DynamicResource Accent}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Focus.ModeLabel}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding Focus.SubStatusText}" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Focus.DisplayTitle}"
                                                   FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   Visibility="{Binding Focus.IsFreeMode, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"/>

                                        <Grid Visibility="{Binding Focus.IsFreeMode, Converter={StaticResource BoolToVisible}}"
                                              MaxWidth="460" HorizontalAlignment="Left">
                                            <TextBox Style="{StaticResource SubtleInput}" Height="36" Width="420"
                                                     FontSize="15" FontWeight="SemiBold" VerticalContentAlignment="Center"
                                                     Text="{Binding Focus.FreeDraftTitle, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="自由专注事项名称"/>
                                            <TextBlock Text="输入正在做的事（可选，结束时将自动带入日程卡片）"
                                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,10,0"
                                                       FontSize="12.5" Foreground="{DynamicResource TextDisabled}"
                                                       Visibility="{Binding Focus.FreeDraftTitle, Converter={StaticResource EmptyToVisible}}"/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Focus.TimeText}"
                                               FontSize="44" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>

                                <!-- 倒计时进度条 -->
                                <Grid x:Name="heroProgressTrack" Height="4" Margin="0,16,0,0"
                                      Background="{DynamicResource Surface3}"
                                      Visibility="{Binding Focus.ShowProgress, Converter={StaticResource BoolToVisible}}">
                                    <Border x:Name="heroProgressFill" Background="{DynamicResource Accent}"
                                            CornerRadius="2" HorizontalAlignment="Left">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                <Binding ElementName="heroProgressTrack" Path="ActualWidth"/>
                                                <Binding Path="Focus.Progress"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>

                                <!-- 操作条 -->
                                <WrapPanel Margin="0,18,0,0">
                                    <Button Style="{StaticResource GhostButton}" Padding="12,7" Margin="0,0,8,0"
                                            Background="{DynamicResource Surface3}"
                                            Click="FocusPause_Click"
                                            AutomationProperties.AutomationId="FocusPauseButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Focus.PauseButtonIcon}" FontFamily="{StaticResource IconFont}"
                                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Focus.PauseButtonText}" FontSize="12.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource GhostButton}" Padding="12,7" Margin="0,0,8,0"
                                            Background="{DynamicResource Surface3}"
                                            Content="+5 分钟" FontSize="12.5"
                                            Visibility="{Binding Focus.CanExtend, Converter={StaticResource BoolToVisible}}"
                                            Click="FocusExtend_Click"/>

                                    <Button Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="0,0,8,0"
                                            Content="{Binding Focus.CompleteButtonText}"
                                            Click="FocusComplete_Click"
                                            AutomationProperties.AutomationId="FocusCompleteButton"/>

                                    <Button Style="{StaticResource GhostButton}" Padding="12,7" Margin="0,0,8,0"
                                            Content="{Binding Focus.StopButtonText}" FontSize="12.5"
                                            Foreground="{DynamicResource TextTertiary}"
                                            Click="FocusStop_Click"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- 空闲状态：自由专注入口 -->
                            <Grid Visibility="{Binding Focus.IsIdle, Converter={StaticResource BoolToVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,20,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="{DynamicResource Surface3}" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="自由专注 · 正计时" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}"/>
                                        </Border>
                                        <TextBlock Text="当前时段暂无进行中的日程" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="想一口气完成一项不定时长的工作？直接开始正计时，结束时弹出日程卡片并自动保存为已完成。"
                                               FontSize="13" FontWeight="Medium" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>
                                    <Grid MaxWidth="460" HorizontalAlignment="Left">
                                        <TextBox x:Name="FreeFocusTitleInput" Style="{StaticResource SubtleInput}"
                                                 Height="36" Width="420" FontSize="13.5" VerticalContentAlignment="Center"
                                                 Text="{Binding Focus.FreeDraftTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="FreeFocusInput_KeyDown"
                                                 AutomationProperties.AutomationId="FreeFocusTitleInput"/>
                                        <TextBlock Text="准备专注做什么？（可留空，结束时再填）"
                                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,10,0"
                                                   FontSize="12.5" Foreground="{DynamicResource TextDisabled}"
                                                   Visibility="{Binding Focus.FreeDraftTitle, Converter={StaticResource EmptyToVisible}}"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="00:00" FontSize="36" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Margin="0,0,0,10"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Typography.NumeralAlignment="Tabular"/>
                                    <Button Style="{StaticResource PrimaryButton}" Padding="18,9"
                                            Content="开始自由专注"
                                            Click="FocusStartFree_Click"
                                            AutomationProperties.AutomationId="StartFreeFocusButton"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 下半区：今日待专注日程 + 专注设置 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：今日待专注日程 -->
                        <Border Grid.Column="0" Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="8" Padding="18,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="今日待专注日程" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding FocusCandidateTasks.Count, StringFormat={}{0} 项}"
                                               Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding FocusCandidateTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TaskVM}">
                                            <Border Background="{DynamicResource Surface3}"
                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                    CornerRadius="6" Padding="12,9" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Fill="{Binding PrimaryGoalColor}"
                                                                     VerticalAlignment="Center" Margin="0,0,6,0"
                                                                     Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}"/>
                                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding MetaText}" Style="{StaticResource Caption}"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding MetaText, Converter={StaticResource EmptyToCollapsed}}"/>
                                                    </StackPanel>

                                                    <!-- 有具体时段：一键按时段倒计时 -->
                                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                            Background="{DynamicResource Surface2}"
                                                            Padding="10,5" FontSize="12"
                                                            Foreground="{DynamicResource Accent}"
                                                            Content="开始专注"
                                                            Visibility="{Binding HasTime, Converter={StaticResource BoolToVisible}}"
                                                            Click="FocusCandidateAuto_Click"/>

                                                    <!-- 无具体时段：快选时长 / 正计时 -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding HasTime, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                                                        <Button Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,4,0"
                                                                Background="{DynamicResource Surface2}" Content="25分" FontSize="11.5"
                                                                Click="FocusCandidate25_Click"/>
                                                        <Button Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,4,0"
                                                                Background="{DynamicResource Surface2}" Content="45分" FontSize="11.5"
                                                                Click="FocusCandidate45_Click"/>
                                                        <Button Style="{StaticResource GhostButton}" Padding="8,4"
                                                                Background="{DynamicResource Surface2}" Content="正计时" FontSize="11.5"
                                                                Foreground="{DynamicResource Accent}"
                                                                Click="FocusCandidateStopwatch_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="今天暂无未完成日程，可以直接在上方开启「自由专注」"
                                           Style="{StaticResource Caption}" Margin="0,8,0,4"
                                           Visibility="{Binding FocusCandidateTasks.Count, Converter={StaticResource ZeroToVisible}}"/>
                            </StackPanel>
                        </Border>

                        <!-- 右列：专注设置与悬浮窗 -->
                        <Border Grid.Column="2" Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="8" Padding="18,16" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="专注偏好与迷你窗" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                                <Border Background="{DynamicResource Surface3}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="开始时自动弹出迷你窗" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="任意专注启动或到点跟随时自动显示桌面胶囊"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                      IsChecked="{Binding FocusAutoOpenMini, Mode=TwoWay}"/>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource Surface3}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="关闭主窗后保留迷你窗" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="主窗口缩到托盘时，胶囊仍留在桌面置顶"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                      IsChecked="{Binding FocusKeepMiniOnCloseToTray, Mode=TwoWay}"/>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource Surface3}" CornerRadius="6" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="开始 / 结束提示音" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="专注开启与倒计时结束时播放柔和提示音"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                      IsChecked="{Binding FocusSoundEnabled, Mode=TwoWay}"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="全局快捷键：默认 Ctrl+Alt+F 可随时呼出或隐藏迷你悬浮窗，可在「设置 → 快捷键」中修改。"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </ControlTemplate>

        <ControlTemplate x:Key="EditorBodyTemplate" TargetType="ContentControl">
            <DockPanel>
                    <!-- 顶部：标题 + 关闭 -->
                    <Grid DockPanel.Dock="Top" Margin="20,16,14,10">
                        <TextBlock Text="{Binding Editor.Header}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" Content="&#xE711;"
                                FontFamily="{StaticResource IconFont}" FontSize="11"
                                HorizontalAlignment="Right" ToolTip="取消（Esc）"
                                AutomationProperties.Name="关闭"
                                Click="EditorCancel_Click"/>
                    </Grid>

                    <!-- 底部：删除 / 取消 / 保存 -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0" Padding="20,12,16,14">
                        <Grid>
                            <Button Style="{StaticResource GhostButton}" Content="删除"
                                    Foreground="{DynamicResource Danger}" HorizontalAlignment="Left"
                                    Visibility="{Binding Editor.IsEditing, Converter={StaticResource BoolToVisible}}"
                                    Click="EditorDelete_Click"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="取消"
                                        Padding="14,6" Margin="0,0,8,0"
                                        Click="EditorCancel_Click"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="保存"
                                        Click="EditorSave_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 表单 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,0,14,0">
                        <StackPanel Margin="0,0,0,14">

                            <!-- 自由专注结束引导提示 -->
                            <Border Background="{DynamicResource AccentTint}"
                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,7" Margin="0,0,0,12"
                                    Visibility="{Binding Editor.MarkDoneOnSave, Converter={StaticResource BoolToVisible}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="自由专注已结束 · 填写信息保存后将自动写入日程并标记为已完成"
                                               FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 名称 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="名称" Style="{StaticResource EditorLabel}"/>
                                <TextBox x:Name="EditorTitle" Grid.Column="1" Style="{StaticResource SubtleInput}"
                                         Height="34" VerticalContentAlignment="Center" FontSize="13.5" FontWeight="SemiBold"
                                         Text="{Binding Editor.Title, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- 日期 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="日期" Style="{StaticResource EditorLabel}"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton x:Name="EditorHasDueToggle" Style="{StaticResource SwitchToggle}"
                                                      AutomationProperties.Name="指定日期"
                                                      AutomationProperties.AutomationId="EditorHasDueToggle"
                                                      IsChecked="{Binding Editor.HasDue, Mode=TwoWay}"/>
                                        <TextBlock Text="不定日期" FontSize="12.5" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Visibility="{Binding Editor.HasDue, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding Editor.HasDue, Converter={StaticResource BoolToVisible}}">
                                        <Button Style="{StaticResource GhostButton}" Content="&#xE76B;"
                                                FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                                Padding="7,5" ToolTip="前一天" AutomationProperties.Name="前一天"
                                                Click="EditorPrevDay_Click"/>
                                        <TextBlock Text="{Binding Editor.DateText}" FontSize="13" FontWeight="Medium"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                        <Button Style="{StaticResource GhostButton}" Content="&#xE76C;"
                                                FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                                Padding="7,5" ToolTip="后一天" AutomationProperties.Name="后一天"
                                                Click="EditorNextDay_Click"/>
                                        <Border Width="1" Height="16" Background="{DynamicResource BorderSubtle}" Margin="10,0"/>
                                        <ToggleButton x:Name="EditorHasDueTimeToggle" Style="{StaticResource SwitchToggle}"
                                                      AutomationProperties.Name="指定截止时间点"
                                                      AutomationProperties.AutomationId="EditorHasDueTimeToggle"
                                                      IsChecked="{Binding Editor.HasDueTime, Mode=TwoWay}"/>
                                        <TextBlock Text="时间点" FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Visibility="{Binding Editor.HasDueTime, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"/>
                                        <TextBox x:Name="EditorDueTimeBox" Style="{StaticResource SubtleInput}"
                                                 Width="72" Height="30" Margin="8,0,0,0"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="截止时间点"
                                                 AutomationProperties.AutomationId="EditorDueTimeBox"
                                                 ToolTip="如 18:00 或 9:30"
                                                 Text="{Binding Editor.DueTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding Editor.HasDueTime, Converter={StaticResource BoolToVisible}}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- 起止时间 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="时间" Style="{StaticResource EditorLabel}"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton x:Name="EditorHasTimeToggle" Style="{StaticResource SwitchToggle}"
                                                      AutomationProperties.Name="指定时间"
                                                      AutomationProperties.AutomationId="EditorHasTimeToggle"
                                                      IsChecked="{Binding Editor.HasTime, Mode=TwoWay}"/>
                                        <TextBlock Text="不占具体时段" FontSize="12.5" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Visibility="{Binding Editor.HasTime, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding Editor.HasTime, Converter={StaticResource BoolToVisible}}">
                                        <TextBox Style="{StaticResource SubtleInput}" Width="88" Height="34"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 Text="{Binding Editor.StartText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="–" Margin="8,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiary}"/>
                                        <TextBox Style="{StaticResource SubtleInput}" Width="88" Height="34"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 Text="{Binding Editor.EndText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- 冲突提示：边打字边算 -->
                            <TextBlock Text="{Binding Editor.HintText}" Margin="58,6,0,0"
                                       FontSize="12" FontWeight="Medium" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Warning}"
                                       Visibility="{Binding Editor.HintText, Converter={StaticResource EmptyToCollapsed}}"/>
                            <TextBlock Text="{Binding Editor.ErrorText}" Margin="58,6,0,0"
                                       FontSize="12" FontWeight="Medium" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Danger}"
                                       Visibility="{Binding Editor.ErrorText, Converter={StaticResource EmptyToCollapsed}}"/>

                            <!-- 标签（点选 + 当场新建） -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标签" Style="{StaticResource EditorLabel}"/>
                                <StackPanel Grid.Column="1">
                                    <ItemsControl ItemsSource="{Binding Editor.TagPicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TagPickVM}">
                                                <ToggleButton Style="{StaticResource FlagChip}" Margin="0,0,6,5"
                                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisible}}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding Color}"
                                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Width="156" HorizontalAlignment="Left" Margin="0,1,0,0">
                                        <TextBox x:Name="EditorNewTag" Style="{StaticResource SubtleInput}" Height="30"
                                                 Text="{Binding Editor.NewTagText, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="EditorNewTag_KeyDown" ToolTip="输入可筛选，回车新建并勾上"/>
                                        <TextBlock Text="+ 新标签" IsHitTestVisible="False" FontSize="12" FontWeight="Medium"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Visibility="{Binding Text, ElementName=EditorNewTag, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- 人物（点选 + 输入筛选 + 当场新建） -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="人物" Style="{StaticResource EditorLabel}"/>
                                <StackPanel Grid.Column="1">
                                    <ItemsControl ItemsSource="{Binding Editor.PersonPicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PersonPickVM}">
                                                <ToggleButton Style="{StaticResource FlagChip}" Margin="0,0,6,5"
                                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisible}}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Width="156" HorizontalAlignment="Left" Margin="0,1,0,0">
                                        <TextBox x:Name="EditorNewPerson" Style="{StaticResource SubtleInput}" Height="30"
                                                 AutomationProperties.Name="新人物"
                                                 AutomationProperties.AutomationId="EditorNewPerson"
                                                 Text="{Binding Editor.NewPersonText, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="EditorNewPerson_KeyDown" ToolTip="输入可筛选，回车新建并勾上"/>
                                        <TextBlock Text="+ 新人物" IsHitTestVisible="False" FontSize="12" FontWeight="Medium"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Visibility="{Binding Text, ElementName=EditorNewPerson, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- 地点（点选 + 输入筛选 + 当场新建） -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="地点" Style="{StaticResource EditorLabel}"/>
                                <StackPanel Grid.Column="1">
                                    <ItemsControl ItemsSource="{Binding Editor.LocationPicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LocationPickVM}">
                                                <ToggleButton Style="{StaticResource FlagChip}" Margin="0,0,6,5"
                                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisible}}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Width="156" HorizontalAlignment="Left" Margin="0,1,0,0">
                                        <TextBox x:Name="EditorNewLocation" Style="{StaticResource SubtleInput}" Height="30"
                                                 AutomationProperties.Name="新地点"
                                                 AutomationProperties.AutomationId="EditorNewLocation"
                                                 Text="{Binding Editor.NewLocationText, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="EditorNewLocation_KeyDown" ToolTip="输入可筛选，回车新建并勾上"/>
                                        <TextBlock Text="+ 新地点" IsHitTestVisible="False" FontSize="12" FontWeight="Medium"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Visibility="{Binding Text, ElementName=EditorNewLocation, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EmptyToVisible}}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- 目标（仅展示总目标胶囊；有子目标者带标记，点击弹目标树多选） -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="目标" Style="{StaticResource EditorLabel}"/>
                                <StackPanel Grid.Column="1">
                                    <ItemsControl ItemsSource="{Binding Editor.GoalPicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:GoalPickVM}">
                                                <ToggleButton Style="{StaticResource FlagChip}" Margin="0,0,6,5"
                                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                              Click="EditorGoal_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding Color}"
                                                                 VerticalAlignment="Center" Margin="0,0,5,0"
                                                                 Visibility="{Binding HasGoal, Converter={StaticResource BoolToVisible}}"/>
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Background="{DynamicResource Surface2}" CornerRadius="3"
                                                                Padding="4,0" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisible}}">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Accent}"
                                                                       Typography.NumeralAlignment="Tabular"/>
                                                        </Border>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding Editor.SelectedGoalChips}"
                                                  ItemTemplate="{StaticResource CompactGoalChipTemplate}"
                                                  Margin="0,2,0,0"
                                                  Visibility="{Binding Editor.HasSelectedGoals, Converter={StaticResource BoolToVisible}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <!-- 重复 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="重复" Style="{StaticResource EditorLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="不重复" Tag="none"
                                                  IsChecked="{Binding Editor.Repeat, Mode=OneWay, Converter={StaticResource TextEquals}, ConverterParameter=none}"
                                                  Click="EditorRepeat_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="每天" Tag="每天"
                                                  IsChecked="{Binding Editor.Repeat, Mode=OneWay, Converter={StaticResource TextEquals}, ConverterParameter=每天}"
                                                  Click="EditorRepeat_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="每周" Tag="每周"
                                                  IsChecked="{Binding Editor.Repeat, Mode=OneWay, Converter={StaticResource TextEquals}, ConverterParameter=每周}"
                                                  Click="EditorRepeat_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="每月" Tag="每月"
                                                  IsChecked="{Binding Editor.Repeat, Mode=OneWay, Converter={StaticResource TextEquals}, ConverterParameter=每月}"
                                                  Click="EditorRepeat_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- 提醒 -->
                            <Grid Margin="0,12,0,0"
                                  Visibility="{Binding Editor.CanRemind, Converter={StaticResource BoolToVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="提醒" Style="{StaticResource EditorLabel}"/>
                                <WrapPanel Grid.Column="1">
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="不提醒" Tag="none" Margin="0,0,6,4"
                                                  AutomationProperties.Name="不提醒"
                                                  IsChecked="{Binding Editor.IsRemindNone, Mode=OneWay}"
                                                  Click="EditorRemind_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="提前15分" Tag="pre15" Margin="0,0,6,4"
                                                  AutomationProperties.Name="提前15分"
                                                  IsChecked="{Binding Editor.IsRemindPre15, Mode=OneWay}"
                                                  Click="EditorRemind_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="提前5分" Tag="pre5" Margin="0,0,6,4"
                                                  AutomationProperties.Name="提前5分"
                                                  IsChecked="{Binding Editor.IsRemindPre5, Mode=OneWay}"
                                                  Click="EditorRemind_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="开始时" Tag="start" Margin="0,0,6,4"
                                                  AutomationProperties.Name="开始时"
                                                  Visibility="{Binding Editor.IsDeadlineOnlyRemind, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"
                                                  IsChecked="{Binding Editor.IsRemindStart, Mode=OneWay}"
                                                  Click="EditorRemind_Click"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="{Binding Editor.RemindEndChipText}" Tag="end" Margin="0,0,6,4"
                                                  AutomationProperties.Name="{Binding Editor.RemindEndChipText}"
                                                  IsChecked="{Binding Editor.IsRemindEnd, Mode=OneWay}"
                                                  Click="EditorRemind_Click"/>
                                </WrapPanel>
                            </Grid>

                            <!-- 紧急 / 重要 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标记" Style="{StaticResource EditorLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="紧急"
                                                  IsChecked="{Binding Editor.IsUrgent, Mode=TwoWay}"/>
                                    <ToggleButton Style="{StaticResource FlagChip}" Content="重要"
                                                  IsChecked="{Binding Editor.IsImportant, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 备注 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="备注" Style="{StaticResource EditorLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SubtleInput}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="62" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding Editor.Note, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
        </ControlTemplate>

        <DataTemplate x:Key="ShortcutRowTemplate" DataType="{x:Type vm:ShortcutItemVM}">
            <Border Background="{DynamicResource Surface3}" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                    Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="statusLabel" Text="{Binding StatusText}"
                                       FontSize="11" FontWeight="Medium"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Visibility="{Binding IsGlobal, Converter={StaticResource BoolToVisible}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="recordBtn" Style="{StaticResource GhostButton}"
                                Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                                Padding="10,5" MinWidth="112" FontSize="12" FontWeight="SemiBold"
                                Content="{Binding DisplayGesture}"
                                ToolTip="点击后按下新组合键；Esc 取消，Backspace/Delete 禁用"
                                Tag="{Binding Id}"
                                AutomationProperties.Name="{Binding Title}"
                                Click="ShortcutRecord_Click"/>
                        <Button Style="{StaticResource GhostButton}"
                                Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                Padding="7,5" Margin="4,0,0,0"
                                ToolTip="禁用此快捷键"
                                Tag="{Binding Id}"
                                Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"
                                Click="ShortcutClear_Click"/>
                        <Button Style="{StaticResource GhostButton}"
                                Content="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                Padding="7,5" Margin="4,0,0,0"
                                ToolTip="{Binding DefaultGesture, StringFormat=恢复默认（{0}）}"
                                Tag="{Binding Id}"
                                Visibility="{Binding IsCustomized, Converter={StaticResource BoolToVisible}}"
                                Click="ShortcutReset_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsStatusOk}" Value="True">
                    <Setter TargetName="statusLabel" Property="Foreground" Value="{DynamicResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStatusWarning}" Value="True">
                    <Setter TargetName="statusLabel" Property="Foreground" Value="{DynamicResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter TargetName="recordBtn" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="recordBtn" Property="Background" Value="{DynamicResource AccentTint}"/>
                    <Setter TargetName="recordBtn" Property="Foreground" Value="{DynamicResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter TargetName="recordBtn" Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ControlTemplate x:Key="SettingsBodyTemplate" TargetType="ContentControl">
            <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,16,14,10">
