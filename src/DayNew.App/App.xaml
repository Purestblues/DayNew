<Application x:Class="DayNew.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 索引 0 固定是主题字典，运行时由 ThemeService 整体替换 -->
                <ResourceDictionary Source="pack://application:,,,/DayNew;component/Themes/Dark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/DayNew;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
