<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nord Polar Night -->
    <SolidColorBrush x:Key="Surface0" Color="#181A20"/>
    <SolidColorBrush x:Key="Surface1" Color="#13151A"/>
    <SolidColorBrush x:Key="Surface2" Color="#21252E"/>
    <SolidColorBrush x:Key="Surface3" Color="#282D38"/>
    <SolidColorBrush x:Key="Surface4" Color="#2E3440"/>

    <SolidColorBrush x:Key="BorderSubtle" Color="#2A303C"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#3B4252"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A5B0C2"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#8C97AB"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#687285"/>

    <SolidColorBrush x:Key="Accent" Color="#78A0F0"/>
    <SolidColorBrush x:Key="AccentHover" Color="#8EB0F5"/>
    <SolidColorBrush x:Key="AccentTint" Color="#2678A0F0"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0F141C"/>
    <SolidColorBrush x:Key="SelectionPill" Color="#2A3856"/>

    <SolidColorBrush x:Key="Success" Color="#A3BE8C"/>
    <SolidColorBrush x:Key="SuccessTint" Color="#24A3BE8C"/>
    <SolidColorBrush x:Key="Warning" Color="#EBCB8B"/>
    <SolidColorBrush x:Key="WarningTint" Color="#24EBCB8B"/>
    <SolidColorBrush x:Key="Danger" Color="#D6747D"/>
    <SolidColorBrush x:Key="DangerTint" Color="#24D6747D"/>

    <SolidColorBrush x:Key="HoverOverlay" Color="#12ECEFF4"/>
    <SolidColorBrush x:Key="PressedOverlay" Color="#1FECEFF4"/>

    <!-- 弹窗背后的遮罩 -->
    <SolidColorBrush x:Key="Scrim" Color="#B8060810"/>
</ResourceDictionary>
