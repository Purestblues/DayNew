<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nord Snow Storm -->
    <SolidColorBrush x:Key="Surface0" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="Surface1" Color="#E5E9F0"/>
    <SolidColorBrush x:Key="Surface2" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface3" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="Surface4" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="BorderSubtle" Color="#D8DEE9"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#C2CAD8"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#2E3440"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#646E82"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#677389"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#9AA3B5"/>

    <SolidColorBrush x:Key="Accent" Color="#527CE6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#426BD6"/>
    <SolidColorBrush x:Key="AccentTint" Color="#24527CE6"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionPill" Color="#D2DEF5"/>

    <SolidColorBrush x:Key="Success" Color="#5C9A64"/>
    <SolidColorBrush x:Key="SuccessTint" Color="#225C9A64"/>
    <SolidColorBrush x:Key="Warning" Color="#C98A3E"/>
    <SolidColorBrush x:Key="WarningTint" Color="#22C98A3E"/>
    <SolidColorBrush x:Key="Danger" Color="#BF616A"/>
    <SolidColorBrush x:Key="DangerTint" Color="#22BF616A"/>

    <SolidColorBrush x:Key="HoverOverlay" Color="#0C2E3440"/>
    <SolidColorBrush x:Key="PressedOverlay" Color="#172E3440"/>

    <!-- 弹窗背后的遮罩 -->
    <SolidColorBrush x:Key="Scrim" Color="#8C2E3440"/>
</ResourceDictionary>
